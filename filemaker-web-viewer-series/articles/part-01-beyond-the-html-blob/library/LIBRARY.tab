ttr("font-size", "16px").attr("font-weight", "bold").text("Total");tooltip.append("text").attr("text-anchor", "middle").text("Ave. Gross - height").attr("font-weight", "bold").attr("transform", "translate(0,-15)");var pieValue = tooltip.append("text").attr("text-anchor", "middle").text("$" + commas(Math.round(total/data.length))).attr("transform", "translate(0,0)");tooltip.append("text").attr("text-anchor", "middle").text("# Records - arc length").attr("font-weight", "bold").attr("transform", "translate(0,23)");var pieRecords = tooltip.append("text").attr("text-anchor", "middle").text(data.length).attr("transform", "translate(0,38)");var arcs = svg.selectAll("path").data(donut(barGroups)).enter().append("svg:path").attr("fill", function(d, i) { return color(i); }).attr("fill-opacity", 1).attr("cursor", "pointer").attr("d", function(d,i) { return arc.outerRadius(r + rscale(d.data["Gross"]/d.data["value"]))(d,i) }).on("mouseover", function(arc) {  var d = arc.data;  var filtered = _(data).filter(function(d) { return d["Genre"] == arc.data.key; });  pieKey.text(d.key);  pieValue.text("$" + commas(Math.round(d["Gross"]/d["value"])));  pieRecords.text(filtered.length);}).on("mouseup", function(selected) {  var selectArc = selected.data.key;  if (!selectedArc || (selectedArc != selectArc)) {    // select arc    // fade out other arcs    arcs      .transition()      .attr("fill-opacity", 0.2)    // highlight this arc    d3.select(this)      .transition()      .attr("fill-opacity", 1)	/*    var filtered = _(data).filter(function(d) { return d["Genre"] == selectedArc; });    // Change selected info    d3.select("#sel-genre").text( selected.data.key );    d3.select("#sel-records").text( filtered.length );    d3.select("#sel-gross").text( "$" + commas(selected.data['Gross']) );    d3.select("#sel-avegross").text( "$" + commas(Math.round(selected.data['Gross']/selected.data['value'])) );    //updateTable(filtered);	*/			// Show records in FileMaker	fmclick.param['genre'] = selectArc;	fmclick.submit(fmclick.script,fmclick.param);		  } else {    // deselect arc    selectedArc = null;    arcs      .transition()      .attr("fill-opacity", 1)    // Remove selected info    d3.select("#sel-genre").text( "" );    d3.select("#sel-records").text( "" );    d3.select("#sel-gross").text( "" );    d3.select("#sel-avegross").text( "" );    //updateTable(data);  }});</script><script type="text/javascript">//     Underscore.math.js 0.1.0//     (c) 2012 Kai Chang//     Underscore.math is freely distributable under the MIT license.//     Portions of Underscore.math are inspired or borrowed from MooTools Array.Math,//     http://github.com/syntagmatic/underscore.math(function() {  var math = this.math = {};  // Arithmetic mean  // math.mean([1,2,3])  //   => 2  math.mean = math.ave = math.average = function(obj, key) {    return math.sum(obj, key) / _(obj).size();  };  // math.median([1,2,3,4])  //   => 2.5  //   TODO {}, [{}]  math.median = function(arr) {    var middle = (arr.length + 1) /2;    var sorted = math.sort(arr);    return (sorted.length % 2) ? sorted[middle - 1] : (sorted[middle - 1.5] + sorted[middle - 0.5]) / 2;  };  // Power, exponent  // math.pow(2,3)  //   => 8  math.pow = function(x, n) {     if (_.isNumber(x))        return Math.pow(x, n);     if (_.isArray(x))        return _.map(x, function(i) { return _.pow(i,n); });  };  // Scale to max value  // math.scale(1,[2,5,10])  //   => [ 0.2, 0.5, 1]  math.scale = function(arr, max) {    var max = max || 1;    var max0 = _.max(arr);    return _.map(arr, function(i) { return i * (max/max0); });  };  // Slope between two points  // math.slope([0,0],[1,2])  //   => 2  math.slope = function(x, y) {    return (y[1] - x[1]) / (y[0]-x[0]);  };  // Numeric sort  // math.sort([3,1,2])  //   => [1,2,3]  math.sort = function(arr) {    return arr.sort(function(a, b){      return a - b;    });  };   // math.stdDeviation([1,2,3])  //   => 0.816496580927726  math.stdDeviation = math.sigma = function(arr) {    return Math.sqrt(_(arr).variance());  };  // Sum of array  // math.sum([1,2,3])  //   => 6  // math.sum([{b: 4},{b: 5},{b: 6}], 'b')  //   => 15  math.sum = function(obj, key) {    if (_.isArray(obj) && typeof obj[0] === 'number') {      var arr = obj;    } else {      var key = key || 'value';      var arr = _(obj).pluck(key);    }    var val = 0;    for (var i=0, len = arr.length; i<len; i++)      val += (arr[i]-0);    return val;  };  // math.transpose(([1,2,3], [4,5,6], [7,8,9]])  //   => [[1,4,7], [2,5,8], [3,6,9]]  math.transpose = function(arr) {    var trans = [];    _(arr).each(function(row, y){      _(row).each(function(col, x){        if (!trans[x]) trans[x] = [];        trans[x][y] = col;      });    });    return trans;  };   // math.variance([1,2,3])  //   => 2/3  math.variance = function(arr) {    var mean = _(arr).mean();    return _(arr).chain().map(function(x) { return _(x-mean).pow(2); }).mean().value();  };    // math.movingAvg([1,2,3,4,5], 3);  //   => [2,3,4]  math.movingAvg = function(arr, size) {    var win, i, newarr = [];    for(i = size-1; i <= arr.length; i++) {      win = arr.slice(i-size, i);      if (win.length === size) {        newarr.push(_.mean(win));       }    }    return newarr;  };    _.mixin(math);})();</script><style type="text/css">body {	overflow: hidden; /* Disables elastic scrolling */}#left-side {  float: left;  width: 70%;}#right-side {  float: right;  width: 30%;  margin-top: 30px;}.beeWrap {  font-size: 13px;  font-family: sans-serif;}path {  cursor: hand;}.beeTable table {  border-collapse: collapse;  border: 1px #bbb solid;  background: #f9f9f9;}.beeTable th,.beeTable td {  border: 1px #bbb solid;  padding: 4px;}</style><script type="text/javascript">var excluded = [ 'id' ];// Handles interaction with FileMaker. Don't change this section.var fmclick = {	"filename": function() {	    nodes = this.url.split("/");	    nodes[nodes.length-1];	},	"hosted":false,	"fmgo":false,	"param" : {},	"submit_hosted": function(script,param) {		var baseAccount = this.account ? this.account + "@" : "";		var base = "fmp://" + (this.account ? this.account + "@" : '' ) + this.url;		var paramString = JSON.stringify(param || this.param);	  	var url = base + '?script=' + script + '&param=' + paramString;		window.location.href = url;	},	"submit_fmgo":  function(script,param) { 		var base = "fmp://$//" + this.filename;		var paramString = JSON.stringify(param || this.param);	  	var url = base + '?script=' + script + '&param=' + paramString;		window.location.href = url;	},	"submit_local": function(param) {		// JSON object needs to be decoded after passing, so encode_hash is more readable and quicker.		// var paramString = JSON.stringify(param || this.param);		document.location.hash = this.encode_hash(param || this.param);	},	"submit": function(script,param){		if (this.fmgo) {			this.submit_fmgo(script,param);		} else if (this.hosted) {			this.submit_hosted(script,param);		} else {			this.submit_local(param);		}	},	"extend": function(obj) {		for (var prop in obj) {			fmclick[prop] = obj[prop];		}	},	"encode_hash": function(params) {		tail = [];		for (var p in params) {		    if (params.hasOwnProperty(p)) {		      tail.push(p + "=" + encodeURIComponent(params[p]));		    }		}		return tail.join("&")	}};// Merge dynamic values below.‡‡CODE[12]‡‡// EXAMPLE://fmclick.extend({//	"script":"x show movies",//	"hosted":true,//	"account":"donovan_c",//	"url":"66.201.40.37/FOCUS.fmp12"//});////var MovieData = '"id","Studio","Unknown","Genre","Gross","Rating","Release","Tickets","Title"\n"MOVIE-B2438827-1D07-4A7C-8EDD-D633E3DD32FB","Universal","120","Romantic Comedy","53556535"," R","12/25/2009","6787901","It\x27s Co