 arc.data.key; });  pieKey.text(d.key);  pieValue.text("$" + commas(Math.round(d["Gross"]/d["value"])));  pieRecords.text(filtered.length);}).on("mouseup", function(selected) {  var selectArc = selected.data.key;  if (!selectedArc || (selectedArc != selectArc)) {    // select arc    // fade out other arcs    arcs      .transition()      .attr("fill-opacity", 0.2)    // highlight this arc    d3.select(this)      .transition()      .attr("fill-opacity", 1)	/*    var filtered = _(data).filter(function(d) { return d["Genre"] == selectedArc; });    // Change selected info    d3.select("#sel-genre").text( selected.data.key );    d3.select("#sel-records").text( filtered.length );    d3.select("#sel-gross").text( "$" + commas(selected.data['Gross']) );    d3.select("#sel-avegross").text( "$" + commas(Math.round(selected.data['Gross']/selected.data['value'])) );    //updateTable(filtered);	*/			// Show records in FileMaker	fmclick.param['genre'] = selectArc;	fmclick.submit(fmclick.script,fmclick.param);		  } else {    // deselect arc    selectedArc = null;    arcs      .transition()      .attr("fill-opacity", 1)    // Remove selected info    d3.select("#sel-genre").text( "" );    d3.select("#sel-records").text( "" );    d3.select("#sel-gross").text( "" );    d3.select("#sel-avegross").text( "" );    //updateTable(data);  }});//     Underscore.math.js 0.1.0//     (c) 2012 Kai Chang//     Underscore.math is freely distributable under the MIT license.//     Portions of Underscore.math are inspired or borrowed from MooTools Array.Math,//     http://github.com/syntagmatic/underscore.math(function() {  var math = this.math = {};  // Arithmetic mean  // math.mean([1,2,3])  //   => 2  math.mean = math.ave = math.average = function(obj, key) {    return math.sum(obj, key) / _(obj).size();  };  // math.median([1,2,3,4])  //   => 2.5  //   TODO {}, [{}]  math.median = function(arr) {    var middle = (arr.length + 1) /