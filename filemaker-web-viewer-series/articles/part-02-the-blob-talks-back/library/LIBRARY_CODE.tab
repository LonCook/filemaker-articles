<!doctype html><html lang="en"><head> <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1" /> <meta name="color-scheme" content="dark light" /> <style>  ‡‡LIB[21]‡‡ </style> <!-- PAGE_HEAD --></head><body> <div id="wv-root">  <!-- PAGE_BODY --> </div> <!-- EARLY LOADING FLAG (prevents premature renders / flicker) --> <script>  (function () {   try {    window.WV = window.WV || {};    WV._state = WV._state || {};    WV._state.loading = true;   // cleared in LIB[24] boot   } catch (e) {}  })(); </script> <script>  ‡‡LIB[22]‡‡ </script> <script>  ‡‡LIB[23]‡‡ </script> <script>  ‡‡LIB[24]‡‡ </script> <!-- PAGE_SCRIPTS --></body></html>	1	20		wv.platform.base.html	754	text/html	wv.base.shell.html			Flicks Web Viewer Framework/* ============================================================   L I B R A R Y   C O D E   Index: 21   Name:  wv.platform.base.css   Purpose:     - WV platform base styles + semantic tokens     - Global visualization themes   ============================================================ */html,body { margin: 0; padding: 0; width: 100%; height: 100%; background: transparent; color: inherit; font-family: system-ui, -apple-system, BlinkMacSystemFont,              "Segoe UI", Roboto, Helvetica, Arial, sans-serif;}#wv-root { position: relative; width: 100%; height: 100%; overflow: hidden; box-sizing: border-box; /* ============================================================    WV SEMANTIC TOKENS (per‑viewer defaults)    Override any of these on #wv-root or a child container    ============================================================ */ /* Background contexts */ --wv-bg-main: #141414; --wv-bg-sidebar: #202020; --wv-bg-canvas: transparent; /* Core surfaces */ --wv-bg: #202020; --wv-surface-1: #202020; --wv-surface-2: #252525; --wv-surface-3: #2B2B2B; /* Text */ --wv-text-1: #FFFFFF; --wv-text-2: rgba(255,255,255,0.78); --wv-text-3: rgba(255,255,255,0.60); /* Neutral accents (labels, lines, UI) */ --wv-accent-1: #CFA100; --wv-accent-2: #2FB3CC; --wv-accent-3: rgba(255,255,255,0.20); --wv-accent-4: #7FBF8A; /* Tones (semantic, not color‑named) */ --wv-tone-1: #3A3316; --wv-tone-2: #544A22; --wv-tone-3: #4A3A12; --wv-tone-4: #6A4B1A; --wv-tone-5: #000000; --wv-tone-6: #001A20; --wv-tone-7: #C4A643; --wv-tone-8: #5AA7A1; --wv-tone-9: #E6C85E; --wv-tone-10: #7BC9C2; --wv-tone-11: #8A6B1F; --wv-tone-12: #E1B94B; /* Hover accents */ --wv-hover-overall-stroke: #C4A643; --wv-hover-genre-stroke: #5AA7A1; --wv-hover-genre-spread-stroke: #5AA7A1; --wv-hover-genre-conf-stroke: var(--wv-accent-4); --wv-hover-overall-slice-stroke: #E6C85E; --wv-hover-genre-slice-stroke: #7BC9C2; --wv-hover-overall-slice-opacity: 0.55; --wv-hover-genre-slice-opacity: 0.70; --wv-hover-label: #CFA100; /* Band colors */ --wv-band-overall: #3A3316; --wv-band-overall-conf: #544A22; --wv-band-genre: #4A3A12; --wv-band-genre-conf: #6A4B1A; --wv-band-overall-outline: var(--wv-accent-4); --wv-band-genre-outline: var(--wv-accent-4); /* Stroke / sizing */ --wv-stroke-thin: 0.6; --wv-stroke-med: 1.0; --wv-stroke-thick: 1.5; /* Typography */ --wv-font-label: 9; --wv-font-value: 18; --wv-font-metric: 12; --wv-font-sub: 9; /* Label spacing */ --wv-label-gap: 4px; /* P6 mini-bar defaults */ --wv-p6-signal-color: #4FD5FF; --wv-p6-support-color: #6A3FA0; --wv-p6-ig-color: #FF3F96; --wv-p6-signal-fill: rgba(79,213,255,0.22); --wv-p6-signal-stroke: rgba(79,213,255,0.5); --wv-p6-support-fill: rgba(106,63,160,0.28); --wv-p6-support-stroke: rgba(75,42,122,0.6); --wv-p6-ig-fill: rgba(255,63,150,0.30); --wv-p6-ig-stroke: rgba(255,63,150,0.60); --wv-p6-tick-signal-color: #4FD5FF; --wv-p6-tick-support-color: #CFA100; --wv-p6-overlap-fill: rgba(255,255,255,0.22); --wv-p6-overlap-stroke: #CFA100; --wv-p6-radius: 4px;}/* ============================================================   WV THEME: GOLD   Apply via #wv-root.wv-theme-gold   ============================================================ */#wv-root.wv-theme-gold { /* Core surfaces */ --wv-bg: #202020; --wv-surface-1: #202020; --wv-surface-2: #252525; --wv-surface-3: #2B2B2B; /* Text */ --wv-text-1: #FFFFFF; --wv-text-2: rgba(255,255,255,0.78); --wv-text-3: rgba(255,255,255,0.60); /* Neutral accents (labels, lines, UI) */ --wv-accent-1: #CFA100; --wv-accent-2: #2FB3CC; --wv-accent-3: rgba(255,255,255,0.20); --wv-accent-4: #7FBF8A; /* Tones (semantic, not color‑named) */ --wv-tone-1: #3A3316; --wv-tone-2: #544A22; --wv-tone-3: #4A3A12; --wv-tone-4: #6A4B1A; --wv-tone-5: #000000; --wv-tone-6: #001A20; --wv-tone-7: #C4A643; --wv-tone-8: #5AA7A1; --wv-tone-9: #E6C85E; --wv-tone-10: #7BC9C2; /* Hover accents */ --wv-hover-overall-stroke: #C4A643; --wv-hover-genre-stroke: #5AA7A1; --wv-hover-genre-spread-stroke: #5AA7A1; --wv-hover-genre-conf-stroke: var(--wv-accent-4); --wv-hover-overall-slice-stroke: #E6C85E; --wv-hover-genre-slice-stroke: #7BC9C2; --wv-hover-overall-slice-opacity: 0.55; --wv-hover-genre-slice-opacity: 0.70; --wv-hover-label: #CFA100; /* Typography */ --wv-font-metric: 12;}/* ============================================================   WV THEME: FUCHSIA   Apply via #wv-root.wv-theme-fuchsia   ============================================================ */#wv-root.wv-theme-fuchsia { /* Core surfaces */ --wv-bg: #202020; --wv-surface-1: #202020; --wv-surface-2: #252525; --wv-surface-3: #2B2B2B; /* Text */ --wv-text-1: #FFFFFF; --wv-text-2: rgba(255,255,255,0.78); --wv-text-3: rgba(255,255,255,0.60); /* Neutral accents (labels, lines, UI) */ --wv-accent-1: #E6C85E; --wv-accent-2: #2FBCCB; --wv-accent-3: rgba(255,255,255,0.20); /* Tones (semantic, not color‑named) */ --wv-tone-1: #4B2A7A;   /* deep violet */ --wv-tone-2: #6A3FA0;   /* violet */ --wv-tone-3: #3B6A7A;   /* violet -> muted cyan */ --wv-tone-4: #5A8AA0;   /* violet -> muted cyan (lighter) */ --wv-tone-5: #000000; --wv-tone-6: #001A20; --wv-tone-7: #E84C9B; --wv-tone-8: #3DB7C8; --wv-tone-9: #F07AB5; --wv-tone-10: #7FD3E0; --wv-tone-11: #B5871E; --wv-tone-12: #F0C14B; /* Hover accents */ --wv-hover-overall-stroke: #D81B60; --wv-hover-genre-stroke: #00B7C7; --wv-hover-overall-slice-stroke: #FF5FA2; --wv-hover-genre-slice-stroke: #7FE3EC; --wv-hover-overall-slice-opacity: 0.55; --wv-hover-genre-slice-opacity: 0.70; --wv-hover-label: #D4AF37; /* Band colors */ --wv-band-overall: #7A2E74; --wv-band-overall-conf: #C23A7A; --wv-band-genre: #3B6A7A; --wv-band-genre-conf: #5A8AA0; --wv-band-overall-outline: #F0C14B; --wv-band-genre-outline: #F0C14B; /* Typography */ --wv-font-metric: 12; /* P6 mini-bar fuchsia defaults */ --wv-p6-signal-color: #4FD5FF; --wv-p6-support-color: #6A3FA0; --wv-p6-ig-color: #FF3F96; --wv-p6-signal-fill: rgba(79,213,255,0.22); --wv-p6-signal-stroke: rgba(79,213,255,0.5); --wv-p6-support-fill: rgba(106,63,160,0.28); --wv-p6-support-stroke: rgba(75,42,122,0.6); --wv-p6-ig-fill: rgba(255,63,150,0.30); --wv-p6-ig-stroke: rgba(255,63,150,0.60); --wv-p6-tick-signal-color: #4FD5FF; --wv-p6-tick-support-color: #CFA100; --wv-p6-overlap-fill: rgba(255,255,255,0.22); --wv-p6-overlap-stroke: #F0C14B; --wv-p6-radius: 4px;}/* ============================================================   WV THEME: COPPER   Apply via #wv-root.wv-theme-copper   ============================================================ */#wv-root.wv-theme-copper { /* Core surfaces */ --wv-bg: #202020; --wv-surface-1: #232323; --wv-surface-2: #2A2A2A; --wv-surface-3: #303030; /* Text */ --wv-text-1: #F3F0EA; --wv-text-2: rgba(243,240,234,0.78); --wv-text-3: rgba(243,240,234,0.60); /* Neutral accents (labels, lines, UI) */ --wv-accent-1: #CFA100;  /* gold label */ --wv-accent-2: #63B2A6;  /* muted teal */ --wv-accent-3: rgba(255,255,255,0.18); --wv-accent-4: #B88B5A;  /* warm brass */ /* Tones (semantic, not color‑named) */ --wv-tone-1: #5B2B2B;    /* maroon */ --wv-tone-2: #8E4A3E;    /* copper mid */ --wv-tone-3: #4B5E4F;    /* dark sage */ --wv-tone-4: #7C9A86;    /* sage */ --wv-tone-5: #000000; --wv-tone-6: #001A20; --wv-tone-7: #E38C6D;    /* coral highlight */ --wv-tone-8: #A1A4D9;    /* lilac */ --wv-tone-9: #F39B8F;    /* salmon light */ --wv-tone-10: #7E8BC2;   /* muted lilac */ --wv-tone-11: #9A7A4E;   /* muted gold */ --wv-tone-12: #E2B27B;   /* warm gold */ /* Hover accents */ --wv-hover-overall-stroke: #F39B8F; --wv-hover-overall-spread-stroke: #D55042; --wv-hover-overall-conf-stroke: #B06A2E; --wv-hover-genre-stroke: #6FB8AB; --wv-hover-overall-slice-stroke: #F1A07E; --wv-hover-genre-slice-stroke: #8AC9BD; --wv-hover-overall-slice-opacity: 0.55; --wv-hover-genre-slice-opacity: 0.70; --wv-hover-label: #CFA100; /* Band colors */ --wv-band-overall: #5B2B2B; --wv-band-overall-conf: #5A3B22;  /* darker orange */ --wv-band-genre: #4B5E4F;         /* dark sage */ --wv-band-genre-conf: #7C9A86;    /* sage */ --wv-band-overall-outline: var(--wv-accent-1); --wv-band-genre-outline: var(--wv-accent-1); /* Typography */ --wv-font-metric: 12;}/* Prevent accidental scrollbars */*,*::before,*::after { box-sizing: border-box;}/* Disable text selection artifacts inside dashboards */.wv-noselect { user-select: none; -webkit-user-select: none; -ms-user-select: none;}/* Safe default canvas sizing */canvas { display: block; max-width: 100%; max-height: 100%;}/* Debug helper (optional toggle) */.wv-debug-outline * { outline: 1px dashed rgba(255,0,0,0.15);}/* ============================================================   WV THEME (GLOBAL VIZ STYLES)   ============================================================ */:root { --wv-font-base: 11px; --wv-font-title: 12px; --wv-font-kv: 10px; --wv-font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; --wv-color-text: #ffffff; --wv-color-title: #95821D; --wv-color-accent: #2FB3CC; --wv-color-muted: rgba(255,255,255,0.65); --wv-color-card-bg: rgba(0,0,0,0.25); --wv-color-card-border: rgba(255,255,255,0.12); --wv-color-row-hover: rgba(255,255,255,0.04); /* Pairwise */ --wv-pair-bg: rgba(0,0,0,0.35); --wv-pair-border: rgba(255,255,255,0.08); --wv-pair-label: rgba(255,255,255,0.70); --wv-pair-value: rgba(255,255,255,0.95); --wv-pair-metric: rgba(47,179,204,0.95); --wv-ring-bg: rgba(255,255,255,0.15); --wv-ring-fg: rgba(47,179,204,0.95);}/* Prediction bar (B2b) layout + ingredients */.wv-pred-wrap {  position: absolute;  left: var(--wv-pred-x, 16px);  top: var(--wv-pred-y, 0px);  width: calc(var(--wv-pred-bar-w, 260px) + var(--wv-pred-side-gap, 12px) + var(--wv-pred-side-w, 52px));  pointer-events: auto;}.wv-pred-bar {  position: relative;  width: var(--wv-pred-bar-w, 260px);  height: var(--wv-pred-bar-h, 28px);  background: var(--wv-pred-surface, rgba(255,255,255,0.06));  border-radius: var(--wv-pred-radius, 3px);  box-shadow: inset 0 0 0 1px var(--wv-pred-stroke, rgba(0,0,0,0.45));  pointer-events: auto;}.wv-pred-end-label {  position: absolute;  top: 50%;  transform: translateY(-50%);  font-size: var(--wv-pred-end-font, 9px);  color: var(--wv-pred-end-color, rgba(255,255,255,0.55));  letter-spacing: 0.02em;  pointer-events: none;}.wv-pred-end-label.a {  left: var(--wv-pred-cap, 12px);}.wv-pred-end-label.b {  right: var(--wv-pred-cap, 12px);}.wv-pred-center {  position: absolute;  left: 50%;  top: -2px;  width: 2px;  height: calc(var(--wv-pred-bar-h, 28px) + 4px);  background: rgba(255,255,255,0.5);  transform: translateX(-50%);}.wv-pred-conf {  position: absolute;  left: 50%;  top: 30%;  width: var(--wv-pred-conf-w, 120px);  height: 16px;  transform: translate(-50%, -50%);  border-radius: var(--wv-pred-radius, 3px);  background: rgba(79,213,255,0.14);  box-shadow: inset 0 0 0 1px rgba(79,213,255,0.35);  opacity: 0.75;}.wv-pred-band {  position: absolute;  left: 50%;  top: 70%;  width: var(--wv-pred-band-w, 120px);  height: 12px;  transform: translate(-50%, -50%);  border-radius: var(--wv-pred-radius, 3px);  background: rgba(255,63,150,0.12);  box-shadow: inset 0 0 0 1px rgba(255,90,200,0.35);  overflow: hidden;  opacity: 0.75;}.wv-pred-fill {  position: absolute;  top: 50%;  height: 12px;  width: var(--wv-pred-fill-w, 8px);  left: var(--wv-pred-fill-x, 0px);  transform: translateY(-50%);  background: linear-gradient(90deg, rgba(255,63,150,0.25), rgba(255,123,220,0.95));  box-shadow: inset 0 0 0 1px rgba(255,123,220,0.7), 0 0 6px rgba(255,90,200,0.45);  border-radius: var(--wv-pred-radius, 3px);  opacity: 0.75;}.wv-pred-dot {  position: absolute;  left: 50%;  top: 50%;  width: var(--wv-pred-dot-size, 12px);  height: var(--wv-pred-dot-size, 12px);  border-radius: 50%;  background: var(--wv-pred-gold, #CFA100);  box-shadow: 0 0 0 2px #2b2b2b;  transform: translate(-50%, -50%) translateX(var(--wv-pred-dot-x, 0px));  opacity: 0.75;}.wv-pred-side {  position: absolute;  right: 0;  top: 0;  width: var(--wv-pred-side-w, 52px);  height: var(--wv-pred-side-h, 80px);  display: flex;  align-items: flex-start;  justify-content: center;  gap: 10px;  pointer-events: auto;}.wv-vert-stack {  position: relative;  width: var(--wv-vert-w, 10px);  height: var(--wv-pred-side-h, 80px);}.wv-vert-bar {  position: absolute;  left: 0;  top: 0;  width: var(--wv-vert-w, 10px);  height: var(--wv-vert-bar-h, 64px);  background: rgba(255,255,255,0.08);  border-radius: calc(var(--wv-vert-w, 10px) / 2);  box-shadow: 0 0 0 1px var(--wv-vert-stroke, rgba(0,0,0,0.35));  overflow: hidden;}.wv-vert-fill {  position: absolute;  left: 0;  bottom: 0;  width: 100%;  height: var(--wv-vert-fill-h, 8px);  border-radius: calc(var(--wv-vert-w, 10px) / 2);  background: var(--wv-vert-fill-color, rgba(255,255,255,0.5));}.wv-vert-label {  position: absolute;  left: 50%;  bottom: 0;  transform: translateX(-50%);  font-size: var(--wv-vert-label-size, 10px);  line-height: 1;  color: var(--wv-vert-label-color, rgba(255,255,255,0.7));}.wv-p6-wrap {  width: 100%;  height: var(--wv-pred-side-h, 80px);  display: flex;  align-items: flex-start;  justify-content: center;}.wv-p6-grid {  display: grid;  grid-template-columns: var(--wv-p6-bar-w, 30px) var(--wv-p6-gap, 20px) var(--wv-p6-bar-w, 30px) var(--wv-p6-gap, 20px) var(--wv-p6-bar-w, 30px);  gap: 0;  align-items: end;  justify-items: center;  height: var(--wv-pred-side-h, 80px);}.wv-p6-spacer {  width: var(--wv-p6-gap, 20px);  height: 1px;}.wv-p6-bar {  width: var(--wv-p6-bar-w, 30px);  display: grid;  justify-items: center;  gap: 4px;}.wv-p6-track {  position: relative;  width: var(--wv-p6-bar-w, 30px);  height: var(--wv-p6-bar-h, 60px);  background: rgba(255,255,255,0.06);  border-radius: var(--wv-p6-radius, 6px);  box-shadow: 0 0 0 1px var(--wv-p6-stroke, rgba(0,0,0,0.35));  overflow: hidden;}.wv-p6-overlap {  position: absolute;  left: 0;  top: 0;  width: 100%;  height: 100%;  pointer-events: none;}.wv-p6-overlap-path {  fill: var(--wv-p6-overlap-fill, rgba(255,255,255,0.22));  stroke: var(--wv-p6-overlap-stroke, #CFA100);  stroke-width: 1;}.wv-p6-fill {  position: absolute;  width: var(--wv-p6-fill-w, 66%);  border-radius: var(--wv-p6-radius, 4px);}.wv-p6-fill.signal { left: 0; }.wv-p6-fill.support { right: 0; }.wv-p6-fill.signal {  bottom: 0;  height: var(--wv-p6-a-signal-h, 12px);  background: var(--wv-p6-a-signal-fill, rgba(79,213,255,0.22));  box-shadow: inset 0 0 0 1px var(--wv-p6-a-signal-stroke, rgba(79,213,255,0.5));}.wv-p6-fill.support {  top: 0;  height: var(--wv-p6-a-support-h, 12px);  background: var(--wv-p6-a-support-fill, rgba(106,63,160,0.28));  box-shadow: inset 0 0 0 1px var(--wv-p6-a-support-stroke, rgba(75,42,122,0.6));}.wv-p6-bar[data-bar="b"] .wv-p6-fill.signal {  height: var(--wv-p6-b-signal-h, 12px);  background: var(--wv-p6-b-signal-fill, rgba(255,80,80,0.22));  box-shadow: inset 0 0 0 1px var(--wv-p6-b-signal-stroke, rgba(255,80,80,0.6));}.wv-p6-bar[data-bar="b"] .wv-p6-fill.support {  height: var(--wv-p6-b-support-h, 12px);  background: var(--wv-p6-b-support-fill, rgba(79,213,255,0.22));  box-shadow: inset 0 0 0 1px var(--wv-p6-b-support-stroke, rgba(79,213,255,0.5));}.wv-p6-ig .wv-p6-fill.ig {  width: 100%;  left: 0;  right: 0;  bottom: 0;  height: var(--wv-p6-ig-h, 12px);  background: var(--wv-p6-ig-fill, rgba(255,63,150,0.3));  box-shadow: inset 0 0 0 1px var(--wv-p6-ig-stroke, rgba(255,63,150,0.6));  border-radius: var(--wv-p6-radius, 6px);}.wv-p6-tick {  position: absolute;  left: 50%;  width: var(--wv-p6-tick-w, 120%);  height: 2px;  transform: translateX(-50%);  border-radius: 2px;}.wv-p6-tick.signal {  bottom: var(--wv-p6-tick-signal, 0px);  background: var(--wv-p6-tick-signal-color, #4FD5FF);}.wv-p6-tick.support {  bottom: var(--wv-p6-tick-support, 0px);  background: var(--wv-p6-tick-support-color, #CFA100);}.wv-p6-label {  font-size: var(--wv-p6-label-size, 10px);  line-height: 1;  text-align: center;  color: rgba(255,255,255,0.7);}.wv-p6-label.signal { color: var(--wv-p6-signal-color, #4FD5FF); }.wv-p6-label.support { color: var(--wv-p6-support-color, #CFA100); }.wv-p6-label.ig { color: var(--wv-p6-ig-color, #FF3F96); }.wv-ingredients {  display: grid;  gap: var(--wv-ing-gap, 2px);  margin-top: var(--wv-ing-margin-top, 6px);  font-size: var(--wv-ing-font, 7px);  line-height: var(--wv-ing-line, 9px);  height: var(--wv-ing-height, 36px);  color: var(--wv-ing-color, rgba(255,255,255,0.6));  width: var(--wv-pred-bar-w, 260px);  padding-right: 0px;  padding-left: var(--wv-ing-pad-left, 0px);  pointer-events: auto;}.wv-ing-row {  display: grid;  grid-template-columns: var(--wv-ing-label-w, 60px) var(--wv-ing-metric-w, 42px) 1fr;  column-gap: var(--wv-ing-col-gap, 3px);  align-items: baseline;  position: relative;  width: 100%;  box-sizing: border-box;  padding: 1px 2px;  border-radius: 4px;  z-index: 0;}.wv-ing-row::before {  content: "";  position: absolute;  left: calc(-1 * var(--wv-ing-pad-left, 0px));  top: -2px;  width: var(--wv-pred-bar-w, 260px);  height: calc(100% + 4px);  border-radius: 4px;  background: rgba(0,0,0,0.55);  opacity: 0;  pointer-events: none;  z-index: -1;}.wv-ing-label {  font-weight: 600;  color: var(--wv-ing-label-color, inherit);}.wv-ing-metric {  font-variant-numeric: tabular-nums;  color: var(--wv-ing-metric-color, inherit);  opacity: var(--wv-ing-metric-opacity, 0.65);}.wv-ing-desc {  white-space: nowrap;  overflow: hidden;  text-overflow: ellipsis;}/* Prediction hover states */.wv-pred-wrap[data-hover="prediction"] .wv-pred-dot {  opacity: 1;  box-shadow: 0 0 0 2px #2b2b2b, 0 0 0 3px var(--wv-pred-gold, #CFA100);}.wv-pred-wrap[data-hover="rank"] .wv-pred-band {  opacity: 1;  box-shadow: inset 0 0 0 1px rgba(255,90,200,0.8);}.wv-pred-wrap[data-hover="fill"] .wv-pred-fill {  opacity: 1;  box-shadow: inset 0 0 0 1px rgba(255,123,220,0.95);}.wv-pred-wrap[data-hover="confidence"] .wv-pred-conf {  opacity: 1;  box-shadow: inset 0 0 0 1px rgba(79,213,255,0.9);}/* Ingredient row hover states */.wv-pred-wrap[data-hover="prediction"] .wv-ing-row[data-hover-key="prediction"],.wv-pred-wrap[data-hover="rank"] .wv-ing-row[data-hover-key="rank"],.wv-pred-wrap[data-hover="fill"] .wv-ing-row[data-hover-key="fill"],.wv-pred-wrap[data-hover="confidence"] .wv-ing-row[data-hover-key="confidence"] {  background: transparent;  box-shadow: none;}.wv-pred-wrap[data-hover="prediction"] .wv-ing-row[data-hover-key="prediction"]::before,.wv-pred-wrap[data-hover="rank"] .wv-ing-row[data-hover-key="rank"]::before,.wv-pred-wrap[data-hover="fill"] .wv-ing-row[data-hover-key="fill"]::before,.wv-pred-wrap[data-hover="confidence"] .wv-ing-row[data-hover-key="confidence"]::before {  opacity: 1;}/* ============================================================   P8T-CSS (Mock -> Renderer-ready)   Uses fuchsia theme tokens for consistent styling   ============================================================ */.p8t-css {  --p8t-cyan: rgba(79,213,255,0.2);  --p8t-cyan-stroke: rgba(79,213,255,0.5);  --p8t-violet: rgba(210,140,255,0.14);  --p8t-violet-stroke: rgba(210,140,255,0.35);  --p8t-fuchsia: rgba(255,63,150,0.32);  --p8t-fuchsia-stroke: rgba(255,63,150,0.75);  --p8t-gold: rgba(207,161,0,0.95);  --p8t-ig-label: rgba(255,63,150,0.9);  --p8t-ig-track: rgba(255,255,255,0.04);  --p8t-ig-stroke: rgba(0,0,0,0.4);  --p8t-overlap-fill: rgba(255,255,255,0.2);  --p8t-overlap-fill-support: rgba(255,255,255,0.2);  --p8t-overlap-stroke: rgba(79,213,255,0.85);  --p8t-overlap-stroke-support: rgba(207,161,0,0.95);  --p8t-alt: rgba(255,42,163,0.11);  --p8t-alt-stroke: rgba(200,50,130,0.7);  --p8t-overlap-stroke: rgba(79,213,255,0.7);  --p8t-overlap-glow: rgba(79,213,255,0.22);  --p8t-overlap-glow-support: rgba(207,161,0,0.22);}.p8t-css .p8t-pair {  display: grid;  grid-template-columns:    var(--p8t-col-w, 30px) var(--p8t-gap, 20px)    var(--p8t-col-w, 30px) var(--p8t-gap, 20px)    var(--p8t-col-w, 30px);  gap: 0;  justify-items: center;  align-content: start;}.p8t-css .p8t-combo {  display: grid;  justify-items: center;  gap: var(--p8t-label-gap, 8px);  width: var(--p8t-col-w, 30px);}.p8t-css .p8t-bar {  width: var(--p8t-bar-w, 26px);  height: var(--p8t-bar-h, 120px);  border-radius: var(--p8t-radius, 3px);  background: var(--p8t-ig-track);  box-shadow: inset 0 0 0 1px var(--p8t-ig-stroke);  position: relative;  overflow: hidden;}.p8t-css .p8t-left,.p8t-css .p8t-right {  position: absolute;  width: 66%;  border-radius: var(--p8t-radius, 3px);}/* Default side anchoring so non-signal/support bars (e.g. separation) stay pinned correctly. */.p8t-css .p8t-left { left: 0; }.p8t-css .p8t-right { right: 0; }.p8t-css .p8t-bar.signal .p8t-left {  left: 0;  height: 64%;  bottom: 62%;  transform: translateY(50%);  background: var(--p8t-violet);  box-shadow: inset 0 0 0 1px var(--p8t-violet-stroke);}.p8t-css .p8t-bar.signal .p8t-right {  right: 0;  height: 74%;  top: 38%;  transform: translateY(-50%);  background: var(--p8t-alt);  box-shadow: inset 0 0 0 1px var(--p8t-alt-stroke);}.p8t-css .p8t-bar.support .p8t-left {  left: 0;  height: 92%;  bottom: 42%;  transform: translateY(50%);  background: rgba(255,70,90,0.14);  box-shadow: inset 0 0 0 1px rgba(255,70,90,0.35);}.p8t-css .p8t-bar.support .p8t-right {  right: 0;  height: 46%;  top: 58%;  transform: translateY(-50%);  background: rgba(79,213,255,0.18);  box-shadow: inset 0 0 0 1px rgba(79,213,255,0.45);}.p8t-css .p8t-overlap {  position: absolute;  left: 6px;  right: 6px;  height: 34%;  bottom: 34%;  background: var(--p8t-overlap-fill);  border: 1px solid var(--p8t-overlap-stroke);  box-shadow: 0 0 6px var(--p8t-overlap-glow);  border-radius: var(--p8t-radius, 3px);}.p8t-css .p8t-overlap.support {  height: 24%;  bottom: 42%;  border-color: var(--p8t-overlap-stroke-support);  background: var(--p8t-overlap-fill-support);  box-shadow: 0 0 6px var(--p8t-overlap-glow-support);}.p8t-css .p8t-label {  font-size: var(--p8t-label-size, 11px);  color: rgba(255,255,255,0.7);  text-align: center;  line-height: 1.1;}.p8t-css .p8t-label.signal {  color: rgba(79,213,255,0.9);}.p8t-css .p8t-label.support {  color: rgba(207,161,0,0.95);}.p8t-css .p8t-ig {  display: grid;  justify-items: center;  gap: var(--p8t-label-gap, 8px);  width: var(--p8t-col-w, 30px);}.p8t-css .p8t-ig-track {  position: relative;  width: var(--p8t-bar-w, 26px);  height: var(--p8t-bar-h, 120px);  border-radius: var(--p8t-radius, 3px);  background: var(--p8t-ig-track);  box-shadow: inset 0 0 0 1px var(--p8t-ig-stroke);  overflow: visible;}.p8t-css .p8t-ig-fill {  position: absolute;  left: 0;  bottom: 0;  width: 100%;  height: 58%;  border-radius: var(--p8t-radius, 3px);  background: var(--p8t-fuchsia);  box-shadow: inset 0 0 0 1px var(--p8t-fuchsia-stroke);}.p8t-css .p8t-ig-tick {  position: absolute;  left: 50%;  transform: translateX(-50%);  height: 2px;  border-radius: 2px;  width: var(--p8t-ig-tick-w, calc(var(--p8t-bar-w, 26px) + 6px));}.p8t-css .p8t-ig-tick.signal {  bottom: 62%;  background: rgba(79,213,255,0.9);}.p8t-css .p8t-ig-tick.support {  bottom: 42%;  background: rgba(207,161,0,0.95);}.p8t-css .p8t-ig-label {  font-size: var(--p8t-label-size, 11px);  color: var(--p8t-ig-label);}/* Tighten labels when P10 bars are embedded in the prediction side rail */#wv-root .wv-pred-side .p8t-combo,#wv-root .wv-pred-side .p8t-ig {  gap: 4px;}#wv-root .wv-pred-side .p8t-label,#wv-root .wv-pred-side .p8t-ig-label {  line-height: 1;}.p8t-css .p8t-bar.wv-p10-hover,.p8t-css .p8t-ig-track.wv-p10-hover {  filter: brightness(1.08) saturate(1.12);}.p8t-css .p8t-bar.wv-p10-hover::after,.p8t-css .p8t-ig-track.wv-p10-hover::after {  content: "";  position: absolute;  inset: 0;  border-radius: inherit;  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18);  pointer-events: none;}/* P10 annotated popover (progress viz) */#wv-root .wv-p10-popover-backdrop {  position: absolute;  inset: 0;  background: rgba(0,0,0,0.42);  opacity: 0;  pointer-events: none;  transition: opacity 120ms linear;  z-index: 60;}#wv-root .wv-p10-popover {  position: absolute;  inset: 0;  display: grid;  place-items: center;  pointer-events: none;  z-index: 61;}#wv-root.wv-p10-popover-open .wv-p10-popover-backdrop {  opacity: 1;  pointer-events: auto;}#wv-root.wv-p10-popover-open .wv-p10-popover {  pointer-events: auto;}#wv-root .wv-p10-pop-card {  position: relative;  width: min(340px, calc(100% - 20px));  max-height: calc(100% - 20px);  overflow: auto;  border-radius: 16px;  padding: 14px 14px 12px;  background: linear-gradient(180deg, #262626 0%, #1f1f1f 100%);  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.06), 0 16px 34px rgba(0,0,0,0.45);  color: rgba(255,255,255,0.88);}#wv-root .wv-p10-pop-card[data-open="0"] { display: none; }#wv-root .wv-p10-pop-close {  position: absolute;  top: 10px;  right: 10px;  width: 22px;  height: 22px;  border-radius: 999px;  border: 1px solid rgba(255,255,255,0.18);  background: rgba(255,255,255,0.04);  color: rgba(255,255,255,0.84);  display: grid;  place-items: center;  line-height: 1;  cursor: pointer;}#wv-root .wv-p10-pop-title {  margin: 0 24px 6px 0;  font-size: 13px;  font-weight: 700;  color: rgba(255,255,255,0.96);}#wv-root .wv-p10-pop-sub {  margin-top: 3px;  font-size: 10px;  line-height: 1.2;  color: rgba(255,255,255,0.68);}/* Annotated P10 popover content */#wv-root .annot-p10-card {  position: relative;  display: grid;  grid-template-columns: 1fr;  grid-template-rows: auto 260px;  gap: 12px;  width: 320px;  height: 368px;  align-items: stretch;  align-content: start;}#wv-root .annot-p10-card[data-open="0"] { display: none; }#wv-root .annot-p10-wrap {  position: relative;  height: 260px;  min-height: 260px;}#wv-root .wv-p10-pop-card.annot-p10-card {  width: 320px;  height: 368px;  max-height: none;  overflow: hidden;  padding: 18px;  box-sizing: border-box;}#wv-root .annot-p10-card [data-annot-header-title] {  margin-top: 2px;  margin-bottom: 8px;  text-align: left;  font-size: 13px;  line-height: 1.15;  letter-spacing: 0.03em;  color: rgba(255,255,255,0.96);  font-weight: 700;}#wv-root .annot-p10-card [data-annot-header-line1],#wv-root .annot-p10-card [data-annot-header-line2],#wv-root .annot-p10-card [data-annot-header-line3] {  margin-top: 4px;  white-space: normal;  overflow-wrap: anywhere;  line-height: 1.2;}#wv-root .annot-p10-card .annot-head-key {  color: rgba(255,255,255,0.92);  font-weight: 600;}/* Annotated popup math token tones */#wv-root .annot-math-delta { color: rgba(220,200,150,0.86); }#wv-root .annot-math-deltah { color: rgba(176,124,255,0.72); }#wv-root .annot-math-deltai { color: rgba(226,164,196,0.86); }#wv-root .annot-math-deltar { color: rgba(130,214,236,0.72); }#wv-root .annot-math-deltay { color: rgba(255,255,255,0.78); }#wv-root .annot-math-neutral { color: rgba(255,255,255,0.78); }#wv-root .annot-math-shat { color: rgba(150,220,195,0.74); }#wv-root .annot-math-sigma { color: rgba(214,191,120,0.72); }#wv-root .annot-p10-card.compact [data-annot-header-title] {  font-size: 11px;  margin-bottom: 5px;}#wv-root .annot-p10-card.compact .legend {  font-size: 8px;  line-height: 1.15;  margin-top: 3px;}#wv-root .annot-p10-card.compact .annot-p10-label { font-size: 8px; }#wv-root .annot-p10-card.compact .annot-p10-desc {  font-size: 7px;  line-height: 1.15;}#wv-root .annot-p10-card.compact .annot-p10-desc .desc-lead {  font-size: 7px;  font-weight: 700;}#wv-root .annot-p10-card.compact .annot-p10-desc .desc-body {  font-size: 6.5px;  line-height: 1.12;}#wv-root .annot-p10-card.compact .annot-p10-leader path.annot-p10-line { stroke-width: 1.2; }#wv-root .annot-p10-bar {  position: absolute;  right: 128px;  top: 16px;  width: 52px;  height: 240px;  border-radius: 6px;  background: rgba(255,255,255,0.04);  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.4);  overflow: hidden;}#wv-root .annot-p10-left,#wv-root .annot-p10-right {  position: absolute;  width: 66%;  border-radius: 6px;}#wv-root .annot-p10-left { left: 0; }#wv-root .annot-p10-right { right: 0; }#wv-root .annot-p10-overlap {  position: absolute;  left: 6px;  right: 6px;  border-radius: 6px;  background: rgba(255,255,255,0.2);  box-shadow: inset 0 0 0 1px rgba(207,161,0,0.95);}#wv-root .annot-p10-ig {  position: absolute;  right: 24px;  top: 16px;  width: 52px;  height: 240px;}#wv-root .annot-p10-ig-track {  position: relative;  width: 100%;  height: 100%;  border-radius: 6px;  background: rgba(255,255,255,0.04);  box-shadow: inset 0 0 0 1px rgba(0,0,0,0.4);  overflow: hidden;}#wv-root .annot-p10-ref-left,#wv-root .annot-p10-ref-right {  position: absolute;  width: 66%;  border-radius: 6px;  display: none;}#wv-root .annot-p10-ref-left { left: 0; }#wv-root .annot-p10-ref-right { right: 0; }#wv-root .annot-p10-ref-overlap {  position: absolute;  width: 66%;  left: 50%;  transform: translateX(-50%);  border-radius: 6px;  display: none;}#wv-root .annot-p10-ig-fill {  position: absolute;  left: 0;  right: 0;  bottom: 0;  height: 56%;  border-radius: 6px;  background: rgba(255,63,150,0.26);  box-shadow: inset 0 0 0 1px rgba(255,63,150,0.75);}#wv-root .annot-p10-ig-tick {  position: absolute;  left: 50%;  width: calc(100% + 10px);  height: 2px;  border-radius: 2px;  transform: translateX(-50%);  pointer-events: none;}#wv-root .annot-p10-ig-tick.signal { background: rgba(79,213,255,0.92); }#wv-root .annot-p10-ig-tick.support { background: rgba(207,161,0,0.95); }#wv-root .annot-p10-bar-label {  position: absolute;  top: 262px;  width: 52px;  text-align: center;  font-size: 10px;  font-weight: 600;  letter-spacing: 0.01em;}#wv-root .annot-p10-bar-label.focus { right: 128px; color: rgba(207,161,0,0.95); }#wv-root .annot-p10-bar-label.ig { right: 24px; color: rgba(255,63,150,0.9); }#wv-root .annot-p10-measure {  position: absolute;  left: 0;  top: 0;  width: 100%;  height: 100%;  pointer-events: none;}#wv-root .annot-p10-measure .guide {  stroke: rgba(255,255,255,0.68);  stroke-width: 1;  stroke-dasharray: 4 3;  fill: none;}#wv-root .annot-p10-measure .shat-guide {  stroke: rgba(150,220,195,0.82);  stroke-width: 1;  stroke-dasharray: 4 3;  fill: none;}#wv-root .annot-p10-measure .shat-dim {  stroke: rgba(150,220,195,0.9);  stroke-width: 1;  fill: none;}#wv-root .annot-p10-measure .shat-symbol {  fill: rgba(150,220,195,0.9);  font-size: 9px;  font-weight: 600;  text-anchor: middle;  dominant-baseline: central;  paint-order: stroke fill;  stroke: rgba(33,33,33,0.96);  stroke-width: 4;  stroke-linejoin: round;}#wv-root .annot-p10-measure .sep-arrow {  fill: rgba(150,220,195,0.9);}#wv-root .annot-p10-measure .sep-link {  stroke: rgba(176,124,255,0.9);  stroke-width: 1.2;  stroke-dasharray: 4 3;  fill: none;  display: none;}#wv-root .annot-p10-measure .sep-link-dot {  fill: rgba(176,124,255,0.95);  display: none;}#wv-root .annot-p10-measure .sep-mag,#wv-root .annot-p10-measure .sep-base,#wv-root .annot-p10-measure .sep-cap {  stroke-width: 1;  fill: none;  display: none;}#wv-root .annot-p10-measure .sep-mag.sep-left,#wv-root .annot-p10-measure .sep-base.sep-left,#wv-root .annot-p10-measure .sep-cap.sep-left {  stroke: rgba(198,117,255,0.88);}#wv-root .annot-p10-measure .sep-mag.sep-right,#wv-root .annot-p10-measure .sep-base.sep-right,#wv-root .annot-p10-measure .sep-cap.sep-right {  stroke: rgba(79,213,255,0.88);}#wv-root .annot-p10-measure .sep-mag {  stroke-dasharray: 4 3;}#wv-root .annot-p10-measure .sep-symbol {  font-size: 8px;  font-weight: 600;  text-anchor: middle;  dominant-baseline: middle;  paint-order: stroke fill;  stroke: rgba(33,33,33,0.96);  stroke-width: 4;  stroke-linejoin: round;  display: none;}#wv-root .annot-p10-measure .sep-symbol.sep-left {  fill: rgba(198,117,255,0.88);}#wv-root .annot-p10-measure .sep-symbol.sep-right {  fill: rgba(79,213,255,0.88);}#wv-root .annot-p10-measure .dim {  stroke: rgba(255,255,255,0.85);  stroke-width: 1;  fill: none;}#wv-root .annot-p10-measure .dim-arrow { fill: rgba(255,255,255,0.85); }#wv-root .annot-p10-measure .dim-symbol {  fill: rgba(255,255,255,0.9);  font-size: 9px;  font-weight: 600;  text-anchor: middle;  dominant-baseline: central;  paint-order: stroke fill;  stroke: rgba(33,33,33,0.96);  stroke-width: 4;  stroke-linejoin: round;}#wv-root .annot-p10-label {  position: absolute;  left: 20px;  font-size: 10px;  color: var(--wv-accent-1, #CFA100);  white-space: nowrap;  display: block;  width: auto;}#wv-root .annot-p10-desc {  position: absolute;  left: 20px;  font-size: 10px;  color: rgba(255,255,255,0.72);  width: 300px;  line-height: 1.25;  pointer-events: none;}#wv-root .annot-p10-desc .desc-lead {  display: block;  color: rgba(255,255,255,0.92);  font-weight: 700;  letter-spacing: 0.01em;}#wv-root .annot-p10-desc .desc-body {  display: block;  color: rgba(255,255,255,0.52);  font-weight: 400;  font-size: 9px;  line-height: 1.25;  margin-top: 1px;}#wv-root .annot-p10-label .annot-p10-value {  display: inline-block;  color: #FFFFFF;  vertical-align: baseline;}#wv-root .annot-p10-label .annot-p10-label-text {  display: inline-block;  vertical-align: baseline;}#wv-root .annot-p10-label .annot-p10-label-content {  display: inline-block;  position: relative;}#wv-root .annot-p10-leader {  position: absolute;  left: 0;  top: 0;  width: 100%;  height: 100%;  pointer-events: none;}#wv-root .annot-p10-leader path.annot-p10-line {  stroke: rgba(207,161,0,0.7);  stroke-width: 1.5;  fill: none;  stroke-linecap: round;  stroke-linejoin: round;}#wv-root .annot-p10-leader circle { fill: rgba(207,161,0,0.9); }#wv-root .annot-p10-meta {  margin-top: 6px;  font-size: 10px;  color: rgba(255,255,255,0.72);}#wv-root .annot-p10-meta:empty { display: none; }/* Shell + layout */.wv-shell { color: var(--wv-color-text); font-size: var(--wv-font-base);}/* Cards + titles */.wv-card { background: var(--wv-color-card-bg); border: 1px solid var(--wv-color-card-border); border-radius: 10px; padding: 10px 12px;}.wv-title { color: var(--wv-color-title); font-size: var(--wv-font-title); font-weight: 600; letter-spacing: 0.3px;}.wv-panel { margin-top: 6px;}.wv-pre { margin: 0; white-space: pre-wrap; word-break: break-word;}.wv-empty { opacity: 0.65;}/* Lists */.wv-list { display: flex; flex-direction: column; gap: 6px;}.wv-row { display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; column-gap: 10px; padding: 2px 0;}.wv-row:hover { background: var(--wv-color-row-hover);}.wv-row-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;}.wv-row-metric { opacity: 0.85; white-space: nowrap; color: var(--wv-color-accent);}.wv-row-n { opacity: 0.65; white-space: nowrap; color: var(--wv-color-accent);}/* Key/value + status blocks */.wv-kv { font-size: var(--wv-font-kv); color: var(--wv-color-muted);}.wv-kv pre,.wv-panel pre { font-family: var(--wv-font-mono);}/* Pairwise renderer */.wv-pair { display: grid; grid-template-columns: 1fr; gap: 10px; padding: 12px; border-radius: 14px; background: transparent; border: none;}.wv-pair-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px;}.wv-pair-label { font-size: 12px; letter-spacing: 0.4px; color: var(--wv-pair-label);}.wv-pair-value { font-size: 18px; font-weight: 700; color: var(--wv-pair-value);}.wv-pair-metric { font-size: 12px; font-weight: 600; color: var(--wv-pair-metric);}.wv-ring { position: relative; width: 88px; height: 88px; display: grid; place-items: center;}.wv-ring svg { width: 88px; height: 88px; transform: rotate(-90deg);}.wv-ring-bg { stroke: var(--wv-ring-bg);}.wv-ring-fg { stroke: var(--wv-ring-fg);}.wv-ring-label { position: absolute; display: grid; gap: 2px; place-items: center; font-size: 10px; color: var(--wv-pair-label);}.wv-ring-label strong { font-size: 14px; color: var(--wv-pair-value);}/* ============================================================   WV DEBUG HUD — FORCE SMALL TYPE   ============================================================ *//* Try the class you expected */.wv-debug-hud,.wv-debug-hud * { font-size: 8px !important; line-height: 1.2 !important;}/* Common alternate ids/classes (covers most platform implementations) */#wv-debug,#wv-debug * ,#wv-debug-hud,#wv-debug-hud * ,.wv-debug,.wv-debug * ,.wv-hud,.wv-hud * { font-size: 8px !important; line-height: 1.2 !important;}/* Pre blocks usually need their own override */.wv-debug-hud pre,#wv-debug pre,#wv-debug-hud pre,.wv-debug pre { font-size: 7px !important; line-height: 1.25 !important;}/* ============================================================   RATING DASHBOARD WORKBENCH (merged from mock stylesheet)   Scope: #wv-root.wv-rating-dashboard-workbench   ============================================================ */body.wv-rating-dashboard-workbench-page {  background: var(--wv-bg-sidebar, #202020);}#wv-root.wv-rating-dashboard-workbench {  width: 520px;  max-width: none;  height: auto;  min-height: 0;  max-height: none;  margin: 0 auto;  background: var(--wv-bg-sidebar);  color: var(--wv-text-1);  box-sizing: border-box;  padding: 8px;  display: grid;  grid-template-rows: auto auto auto auto auto;  gap: 6px;  overflow: visible;}/* Runtime WV sizing (FileMaker viewer): fill viewer bounds, no outer frame padding */#wv-root.wv-rating-dashboard-workbench.rd-runtime {  width: 100%;  max-width: 100%;  height: 100%;  margin: 0;  padding: 0;  gap: 0;  background: var(--wv-bg-sidebar);  overflow: hidden;}.rd-head {  font-size: 12px;  font-weight: 600;  letter-spacing: 0.25px;  color: var(--wv-text-1);  white-space: nowrap;  overflow: hidden;  text-overflow: ellipsis;}.rd-subhead {  font-size: 10px;  color: var(--wv-text-3);  margin-top: 2px;}.rd-state {  display: flex;  gap: 6px;  flex-wrap: wrap;  align-items: center;}.rd-p1-controls {  display: grid;  grid-template-columns: auto 1fr;  gap: 6px;  align-items: center;  width: 386px;}.rd-p1-controls label {  font-size: 9px;  color: var(--wv-text-2);  white-space: nowrap;}.rd-p1-controls input[type="range"] {  width: 100%;}.rd-chip {  appearance: none;  -webkit-appearance: none;  border: 1px solid var(--wv-accent-3);  border-radius: 999px;  padding: 2px 7px;  font-size: 10px;  color: var(--wv-text-2);  background: rgba(255,255,255,0.03);  user-select: none;  cursor: pointer;  line-height: 1.2;  font-family: inherit;}.rd-chip:hover {  border-color: rgba(255,255,255,0.36);  background: rgba(255,255,255,0.06);}.rd-chip:focus-visible {  outline: none;  box-shadow: 0 0 0 1px rgba(255,255,255,0.44);}.rd-chip strong {  color: var(--wv-text-1);  font-weight: 600;}.rd-chip.active {  border-color: rgba(99,178,166,0.75);  background: rgba(99,178,166,0.12);  color: rgba(219,246,240,0.96);}.rd-badges {  display: flex;  gap: 6px;  flex-wrap: wrap;  align-items: center;  min-height: 18px;}.rd-badge {  border: 1px solid rgba(255,255,255,0.18);  border-radius: 999px;  padding: 1px 7px;  font-size: 9px;  color: rgba(255,255,255,0.80);  background: rgba(255,255,255,0.04);  line-height: 1.25;}.rd-badge.emph {  border-color: rgba(99,178,166,0.72);  background: rgba(99,178,166,0.12);  color: rgba(221,246,241,0.98);}.rd-shell {  position: relative;  width: 386px;  min-height: 0;  border: 1px solid var(--wv-accent-3);  border-radius: 12px;  background: linear-gradient(    180deg,    rgba(255,255,255,0.03) 0%,    rgba(255,255,255,0.01) 100%  );  overflow: hidden;}.rd-row {  width: 100%;  display: grid;  grid-template-columns: 386px;  gap: 6px;  align-items: stretch;  min-height: 0;}.rd-row-p1 {  grid-template-columns: 386px 128px;}.rd-row-p3 {  grid-template-columns: 386px 386px 386px;  margin-bottom: 64px;}.rd-shell-p1 {  height: 218px;}.rd-shell-p2 {  height: 138px;}.rd-shell-p3 {  height: 228px;}.rd-shell-p3d {  height: 280px;}.rd-shell-p4 {  height: 100%;  min-height: 100%;}.rd-panel-title {  font-size: 11px;  font-weight: 600;  color: var(--wv-text-1);  letter-spacing: 0.2px;  padding: 0 2px;  line-height: 1.1;}.rd-panel-title.p2 {  margin-top: 10px;}.rd-contract-card {  height: 218px;  border: 1px solid var(--wv-accent-3);  border-radius: 12px;  background: linear-gradient(    180deg,    rgba(255,255,255,0.03) 0%,    rgba(255,255,255,0.01) 100%  );  overflow: hidden;}.rd-combo-grid {  width: 100%;  height: 100%;  display: grid;  grid-template-rows: minmax(148px, 34%) minmax(0, 1fr) auto;  gap: 8px;  box-sizing: border-box;  padding: 0;}.rd-combo-slot {  position: relative;  overflow: hidden;  border: 1px solid rgba(255,255,255,0.14);  border-radius: 8px;  background: rgba(0,0,0,0.16);  pointer-events: auto;}.rd-combo-source {  position: absolute;  left: 0;  top: 0;  width: 100%;  height: 100%;  transform-origin: top left;  pointer-events: auto;}.rd-combo-source-p1 {  top: 26px;  height: calc(100% - 30px);  transform: none;}.rd-combo-source-p2 {  position: static;  width: 100%;  height: auto;  transform: none;}.rd-combo-svg,.rd-combo-p3d-svg {  width: 100%;  height: 100%;  display: block;  pointer-events: auto;}.rd-combo-p3d-svg {  transform: translateY(10px);}.rd-p3d-card-controls-combo {  left: 8px;  bottom: 8px;  width: 118px;  height: 98px;  z-index: 7;}.rd-p3-placeholder-legend {  position: absolute;  right: 8px;  bottom: 8px;  z-index: 8;  display: none;  align-items: center;  gap: 5px;  font-size: 8px;  line-height: 1;  color: var(--wv-tone-12, #E2B27B);  opacity: 0.9;  pointer-events: none;  text-transform: lowercase;}.rd-p3-placeholder-icon {  position: relative;  width: 7px;  height: 7px;  border-radius: 99px;  border: 1px solid var(--wv-tone-12, #E2B27B);  background: var(--wv-tone-7, #E38C6D);  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.26) inset;}.rd-p3-placeholder-icon::before {  content: "";  position: absolute;  left: 50%;  top: 1px;  width: 1px;  height: 3px;  transform: translateX(-50%);  background: var(--wv-tone-12, #E2B27B);  border-radius: 1px;}.rd-p3-placeholder-icon::after {  content: "";  position: absolute;  left: 50%;  bottom: 1px;  width: 1px;  height: 1px;  transform: translateX(-50%);  background: var(--wv-tone-12, #E2B27B);  border-radius: 99px;}.rd-p3d-layer-controls-combo {  position: absolute;  left: 8px;  top: 8px;  z-index: 8;  display: flex;  gap: 6px;  flex-wrap: wrap;  pointer-events: auto;}.rd-p3d-layer-controls-combo .rd-chip {  font-size: 9px;  padding: 2px 7px;}.rd-p4p1-controls {  position: absolute;  left: 8px;  top: 8px;  z-index: 8;  display: grid;  grid-template-columns: minmax(0, 1fr) 50px 78px 73px;  gap: 6px;  align-items: stretch;  pointer-events: auto;  width: calc(100% - 16px);  box-sizing: border-box;  overflow: hidden;}.rd-p4p1-controls.layout-4 {  grid-template-columns: minmax(0, 1fr) 50px 78px 73px;}.rd-p4p1-controls.layout-3 {  grid-template-columns: minmax(0, 1fr) 78px 73px;}.rd-p4p1-controls .rd-chip {  font-size: 8px;  padding: 2px 5px;  display: inline-flex;  align-items: center;  gap: 4px;  white-space: nowrap;  min-width: 0;  box-sizing: border-box;  overflow: hidden;}.rd-p4p1-controls .rd-chip strong,.rd-p4p1-controls .rd-chip .rd-pill-val,#p4ChipNeighborsVal {  pointer-events: none;}.rd-chip.readonly {  cursor: default;  pointer-events: none;}.rd-chip.readonly strong {  color: rgba(255,255,255,0.92);}.rd-chip-range {  width: 5px;  height: 12px;  margin: 0;  vertical-align: middle;  flex: 0 0 5px;}#p4ChipFocus {  grid-column: 1;  width: 100%;  overflow: hidden;}#p4ChipBand {  grid-column: 3;  width: 78px;  justify-content: center;}#p4ChipNeighbors {  grid-column: 2;  width: 50px;  justify-content: flex-start;  gap: 2px;}#p4ChipApplyRows {  grid-column: 4;  width: 73px;  justify-content: flex-start;  padding-left: 5px;  padding-right: 5px;}.rd-p4p1-controls.layout-3 #p4ChipBand {  grid-column: 2;}.rd-p4p1-controls.layout-3 #p4ChipApplyRows {  grid-column: 3;}#p4ChipNeighborsVal {  display: inline-block;  width: 2ch;  text-align: right;}.rd-pill-val {  display: inline-block;  min-width: 0;  max-width: 100%;  overflow: hidden;  text-overflow: ellipsis;  vertical-align: bottom;}#p4ChipFocus .rd-pill-val {  max-width: none;}#p4ChipFocus.focus-active {  border-color: rgba(227,140,109,0.72);  background: rgba(227,140,109,0.12);  color: rgba(255,233,226,0.96);}#p4ChipNeighbors.neighbor-active {  border-color: rgba(227,140,109,0.72);  background: rgba(227,140,109,0.12);  color: rgba(255,233,226,0.96);}.rd-p3d-card-controls-combo .rd-p3d-yaw-wrap {  left: 18px;  bottom: 0;}.rd-p3d-card-controls-combo .rd-p3d-pitch-wrap {  left: 0;  bottom: 18px;}.rd-svg {  width: 100%;  height: 100%;  display: block;  cursor: pointer;}.rd-movers {  display: grid;  width: 100%;  height: 100%;  box-sizing: border-box;  padding: 8px;  grid-template-rows: auto auto auto minmax(0, 1fr);  gap: 7px;  overflow: hidden;}.rd-movers.rd-movers-compact {  height: auto;  grid-template-rows: auto;  gap: 0;  padding: 2px;}.rd-movers.rd-movers-compact .rd-movers-body-2col {  gap: 4px;  align-items: start;}.rd-movers.rd-movers-compact .rd-movers-col {  padding: 4px;  gap: 3px;  border-radius: 7px;  grid-template-rows: auto auto;  align-content: start;}.rd-movers.rd-movers-compact .rd-movers-list {  gap: 2px;}.rd-movers.rd-movers-compact .rd-mover {  padding: 1px 5px;  border-radius: 5px;}.rd-movers-body-2col {  min-height: 0;  display: grid;  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);  gap: 7px;  align-items: stretch;}.rd-movers-head {  font-size: 9px;  color: var(--wv-text-2);  letter-spacing: 0.2px;  display: flex;  justify-content: space-between;  align-items: center;  gap: 6px;}.rd-movers-head-right {  display: inline-flex;  align-items: center;  gap: 6px;}.rd-movers-toggle {  appearance: none;  -webkit-appearance: none;  border: 1px solid rgba(255,255,255,0.22);  border-radius: 999px;  background: rgba(255,255,255,0.03);  color: rgba(255,255,255,0.86);  font-size: 8px;  line-height: 1.2;  padding: 1px 7px;  cursor: pointer;  font-family: inherit;}.rd-movers-subhead {  margin-top: 2px;  font-size: 8px;  color: rgba(255,255,255,0.56);}.rd-movers-reasons {  display: flex;  gap: 4px;  flex-wrap: wrap;  margin-top: 4px;}.rd-reason {  border: 1px solid rgba(255,255,255,0.16);  border-radius: 999px;  padding: 1px 6px;  font-size: 8px;  color: rgba(255,255,255,0.78);  background: rgba(255,255,255,0.03);  line-height: 1.25;}.rd-movers-col {  min-height: 0;  border: 1px solid rgba(255,255,255,0.14);  border-radius: 8px;  background: rgba(0,0,0,0.18);  padding: 6px;  display: grid;  grid-template-rows: auto minmax(0, 1fr);  gap: 6px;  overflow: visible;}.rd-movers-title {  font-size: 8px;  color: rgba(255,255,255,0.88);  text-transform: uppercase;  letter-spacing: 0.25px;  user-select: none;}.rd-movers-title.is-clickable {  cursor: pointer;}.rd-movers-list {  min-height: 0;  overflow: visible;  display: grid;  gap: 3px;  align-content: start;  grid-auto-rows: min-content;}.rd-mover {  position: relative;  overflow: visible;  border: 1px solid rgba(255,255,255,0.13);  border-radius: 6px;  padding: 2px 6px;  display: grid;  grid-template-columns: minmax(0, 1fr) auto;  gap: 6px;  background: rgba(255,255,255,0.03);  cursor: pointer;}.rd-mover.hovered {  z-index: 7;}.rd-mover-hovermeta {  position: absolute;  left: 42%;  top: -52%;  transform: none;  z-index: 6;  pointer-events: none;  border: 1px solid rgba(255,255,255,0.34);  border-radius: 7px;  background: rgba(8,8,8,0.92);  color: rgba(255,255,255,0.98);  font-size: 8px;  font-weight: 500;  line-height: 1.25;  padding: 2px 7px;  white-space: nowrap;  text-shadow: 0 1px 0 rgba(0,0,0,0.65);  box-shadow: 0 3px 8px rgba(0,0,0,0.45);  opacity: 0;  transition: opacity 120ms ease;}.rd-mover-hovermeta.is-right {  left: auto;  right: 2px;}.rd-hm-k-r {  color: rgba(226,179,86,0.98);  font-weight: 600;}.rd-hm-k-p {  color: rgba(227,140,109,0.98);  font-weight: 600;}.rd-hm-k-s {  color: rgba(99,178,166,0.98);  font-weight: 600;}.rd-hm-v {  color: rgba(182,182,182,0.96);}.rd-mover:hover .rd-mover-hovermeta,.rd-mover.hovered .rd-mover-hovermeta,.rd-mover:focus-visible .rd-mover-hovermeta {  opacity: 1;}.rd-mover.focused {  border-color: rgba(227,140,109,0.62);  box-shadow: inset 0 0 0 1px rgba(227,140,109,0.28);}.rd-mover.focused .rd-mover-fill {  background: linear-gradient(    90deg,    rgba(227,140,109,0.30) 0%,    rgba(227,140,109,0.16) 100%  );}.rd-mover:focus-visible {  outline: none;  box-shadow: 0 0 0 1px rgba(99,178,166,0.75);}.rd-mover-fill {  position: absolute;  left: 0;  top: 0;  bottom: 0;  width: var(--sigma, 0%);  background: linear-gradient(    90deg,    rgba(99,178,166,0.20) 0%,    rgba(99,178,166,0.10) 100%  );  pointer-events: none;}.rd-mover-name {  position: relative;  z-index: 1;  min-width: 0;  font-size: 7.5px;  color: rgba(255,255,255,0.92);  white-space: nowrap;  overflow: hidden;  text-overflow: ellipsis;}.rd-mover-meta {  color: rgba(255,255,255,0.60);}.rd-mover-flag {  color: rgba(227,140,109,0.95);  font-weight: 600;}.rd-mover-empty {  font-size: 8px;  color: rgba(255,255,255,0.6);}.rd-empty-actions {  margin-top: 4px;  display: flex;  gap: 4px;  flex-wrap: wrap;}.rd-empty-btn {  border: 1px solid rgba(99,178,166,0.55);  border-radius: 999px;  padding: 1px 6px;  font-size: 8px;  color: rgba(218,248,243,0.95);  background: rgba(99,178,166,0.10);  cursor: pointer;  user-select: none;  line-height: 1.25;}.rd-mover-val {  position: relative;  z-index: 1;  font-size: 7.5px;  font-weight: 600;  align-self: center;  display: inline-flex;  align-items: center;  gap: 4px;}.rd-up {  color: rgba(99,178,166,0.95);}.rd-down {  color: rgba(227,140,109,0.95);}.rd-tooltip {  position: absolute;  z-index: 5;  pointer-events: none;  display: none;  min-width: 118px;  border: 1px solid rgba(255,255,255,0.24);  border-radius: 8px;  background: rgba(10,10,10,0.86);  padding: 5px 7px;  font-size: 9px;  line-height: 1.3;  color: rgba(255,255,255,0.92);  box-shadow: 0 3px 10px rgba(0,0,0,0.35);  white-space: nowrap;}.rd-tooltip.is-point {  z-index: 7;  min-width: 0;  border: 1px solid rgba(255,255,255,0.34);  border-radius: 7px;  background: rgba(8,8,8,0.92);  padding: 2px 7px;  font-size: 8px;  font-weight: 500;  line-height: 1.25;  color: rgba(255,255,255,0.98);  text-shadow: 0 1px 0 rgba(0,0,0,0.65);  box-shadow: 0 3px 8px rgba(0,0,0,0.45);}.rd-tooltip-title {  color: rgba(255,255,255,0.98);}.rd-tooltip-meta {  color: rgba(182,182,182,0.96);}.rd-p3v {  width: 100%;  height: 100%;  box-sizing: border-box;  padding: 8px;  display: grid;  grid-template-rows: auto 1fr;  gap: 6px;}.rd-p3v-head {  font-size: 10px;  color: var(--wv-text-2);  display: flex;  justify-content: space-between;  align-items: center;}.rd-p3v-svg {  width: 100%;  height: 100%;  display: block;  border: 1px solid rgba(255,255,255,0.14);  border-radius: 8px;  background: rgba(0,0,0,0.16);}.rd-p3-controls {  display: grid;  grid-template-columns: auto 1fr auto 1fr;  gap: 6px;  align-items: center;  width: 386px;}.rd-p3-controls label {  font-size: 9px;  color: var(--wv-text-2);  white-space: nowrap;}.rd-p3-controls input[type="range"] {  width: 100%;}.rd-p3d-controls {  display: flex;  gap: 6px;  flex-wrap: wrap;  align-items: center;  width: 386px;}.rd-p3d-controls .rd-chip {  font-size: 9px;  padding: 2px 7px;}.rd-p3d-card-controls {  position: absolute;  left: 10px;  bottom: 10px;  z-index: 6;  width: 124px;  height: 102px;  pointer-events: auto;}.rd-p3d-yaw-wrap {  position: absolute;  left: 20px;  bottom: 0;  width: 86px;  height: 12px;  display: flex;  align-items: center;  margin-left: 0;  pointer-events: auto;}.rd-p3d-pitch-wrap {  position: absolute;  left: 0;  bottom: 20px;  width: 12px;  height: 86px;  display: flex;  align-items: center;  justify-content: center;  margin-bottom: 0;  pointer-events: auto;}.rd-p3d-range {  -webkit-appearance: none;  appearance: none;  background: transparent;  margin: 0;  padding: 0;  outline: none;  cursor: pointer;}.rd-p3d-range:focus-visible {  outline: none;  box-shadow: none;}.rd-p3d-range-h {  width: 86px;  height: 12px;}#p4ChipNeighborsRange.rd-p3d-range-h {  width: 15px;  flex: 0 0 15px;}.rd-p3d-range-v {  width: 86px;  height: 12px;  transform: rotate(-90deg);  transform-origin: center center;}.rd-p3d-range::-webkit-slider-runnable-track {  height: 1px;  background: rgba(112,112,112,0.82);  border-radius: 1px;}.rd-p3d-range::-webkit-slider-thumb {  -webkit-appearance: none;  appearance: none;  margin-top: -4px;  width: 2px;  height: 9px;  border: none;  border-radius: 1px;  background: rgba(196,196,196,0.92);  box-shadow: 0 0 0 1px rgba(0,0,0,0.24);}.rd-p3d-range::-moz-range-track {  height: 1px;  background: rgba(112,112,112,0.82);  border: none;  border-radius: 1px;}.rd-p3d-range::-moz-range-thumb {  width: 2px;  height: 9px;  border: none;  border-radius: 1px;  background: rgba(196,196,196,0.92);  box-shadow: 0 0 0 1px rgba(0,0,0,0.24);}.rd-contract {  margin: 0;  width: 100%;  height: 100%;  box-sizing: border-box;  padding: 8px;  display: grid;  grid-template-rows: auto 1fr;  gap: 5px;  min-height: 0;}.rd-contract-title {  font-size: 9px;  color: rgba(255,255,255,0.74);  letter-spacing: 0.2px;  text-transform: uppercase;}.rd-contract-pre {  margin: 0;  white-space: pre-wrap;  word-break: break-word;  overflow: auto;  font-size: 9px;  line-height: 1.28;  color: rgba(255,255,255,0.86);  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;}.rd-legend {  display: flex;  gap: 10px;  align-items: center;  flex-wrap: wrap;  font-size: 10px;  color: var(--wv-text-2);}.rd-key {  display: inline-flex;  align-items: center;  gap: 6px;}.rd-key-muted {  color: var(--wv-text-3);  display: none;}.rd-dot {  width: 9px;  height: 9px;  border-radius: 50%;  border: 1px solid rgba(0,0,0,0.25);  box-sizing: border-box;  flex: 0 0 auto;}.rd-dot.focus {  background: var(--wv-tone-7);  box-shadow: 0 0 8px var(--wv-tone-9);}.rd-dot.neutral {  background: rgba(126, 139, 194, 0.85);  box-shadow: 0 0 7px rgba(126, 139, 194, 0.45);}.rd-dot.user {  background: rgba(226, 178, 123, 0.90);  box-shadow: 0 0 7px rgba(226, 178, 123, 0.45);}.rd-dot.ghost {  background: rgba(99, 178, 166, 0.90);  box-shadow: 0 0 7px rgba(99, 178, 166, 0.45);}.rd-dot.band {  background: rgba(99, 178, 166, 0.95);  box-shadow: 0 0 7px rgba(99, 178, 166, 0.52);}.rd-dot.neighbors {  background: rgba(227, 140, 109, 0.95);  box-shadow: 0 0 7px rgba(227, 140, 109, 0.50);}.rd-meta {  margin-left: auto;  color: var(--wv-text-3);  white-space: nowrap;}/* ============================================================   END RATING DASHBOARD WORKBENCH   ============================================================ */	1	21		wv.platform.base.css	56795	text/css	wv.platform.base.css			Flicks Web Viewer Framework/* ============================================================   W V   P L A T F O R M   R U N T I M E   Index: 22   Name:  wv.platform.runtime.js   Purpose:     - Establish window.WV namespace + core lifecycle     - Provide a stable API surface for all WV pages     - Health check for “already loaded