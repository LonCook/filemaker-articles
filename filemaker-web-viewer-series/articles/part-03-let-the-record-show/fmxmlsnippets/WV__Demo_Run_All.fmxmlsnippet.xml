<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text> WV__Demo_Run_All</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Purpose: Build ranked-view context, then let the retained loader push first and reload only when required.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> In: FOCUS::g_wv_demo_genre_id and FOCUS::g_wv_demo_movie_id.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Out: FOCUS::g_wv_context_json, FOCUS::g_wv_status; exits with the ensure-loaded result.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Anchor: FOCUS. Explicit Load Viewer and Push Context buttons remain available for layer-by-layer debugging.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Calls: WV__Demo_Build_Context; . webviewer . ensure loaded ( index ; -object_name ; -context_json ; -movie_id ; -genre_id ; ... ) :</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified: 01 Aug 2026, 20hr18PT — Lon Cook — lon@portagebay.com : route the cumulative ranked-view run through the retained push-first loader.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified: 06 Jul 2026, Codex - created Article 1 demo teaching wrapper.</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[""]]></Calculation>
    <Script id="0" name="WV__Demo_Build_Context"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( GetField ( "FOCUS::g_wv_context_json" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_context_json</Name>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[JSONSetElement ( "{}"
  ; [ "index" ; 41 ; JSONNumber ]
  ; [ "object_name" ; "wv_main" ; JSONString ]
  ; [ "context_json" ; $_context_json ; JSONString ]
  ; [ "force_reload" ; 0 ; JSONNumber ]
)]]></Calculation>
    <Script id="457" name=". webviewer . ensure loaded ( index ; -object_name ; -context_json ; -movie_id ; -genre_id ; ... ) :"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( Get ( ScriptResult ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_ensure_result</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["Run all: " & JSONGetElement ( $_ensure_result ; "status" ) &
  " — " & JSONGetElement ( $_ensure_result ; "message" ) &
  " — did_reload=" & JSONGetElement ( $_ensure_result ; "did_reload" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_status</Name>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation><![CDATA[$_status]]></Calculation>
    </Result>
    <TargetName>
      <Calculation><![CDATA["FOCUS::g_wv_status"]]></Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$_ensure_result]]></Calculation>
  </Step>
</fmxmlsnippet>
