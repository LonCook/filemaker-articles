0); }})();	1	LIBRARY_CODE-65B718AE-FBB4-44E9-A42B-0F3B4ED71C00	65		wv.renderer.viz.progress.js	0	/* ============================================================   L I B R A R Y   C O D E   Index: 66   Name:  wv.lib.viz.bezier3d.js   Purpose:     - 3D Bezier surface helper used by dashboard P3D renderers     - Exposes window.WV3D.renderBezierSurface(...) and related helpers   Dependencies:     - None (standalone helper)   Exports:     - window.WV3D   History:     - 04 Mar 2026, 00hr??PT — Lon Cook — lon@deconstrukted.com : extracted from lib/wv3d-bezier.js for FileMaker LIB include   ============================================================ */(function (global) {  'use strict';  function clamp(v, lo, hi) {    return Math.max(lo, Math.min(hi, v));  }  function maxInSeries(series) {    var m = 1;    for (var y = 0; y < series.length; y++) {      var row = series[y] || [];      for (var x = 0; x < row.length; x++) m = Math.max(m, row[x] || 0);    }    return m;  }  function minInSeries(series) {    var m = Infinity;    for (var y = 0; y < series.length; y++) {      var row = series[y] || [];      for (var x = 0; x < row.length; x++) m = Math.min(m, row[x] || 0);    }    return isFinite(m) ? m : 0;  }  function hexToRgb(hex) {    var h = String(hex || '#ffffff').replace('#', '');    if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];    var n = parseInt(h, 16);    if (isNaN(n)) return { r: 255, g: 255, b: 255 };    return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };  }  function rgba(hex, a) {    var c = hexToRgb(hex);    return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + clamp(a, 0, 1).toFixed(3) + ')';  }  function proj3(x, y, z, cfg) {    if (cfg.projectionMode === 'angles') {      var yaw = cfg.camYaw || 0;      var pitch = cfg.camPitch || 0;      // Rotate XY plane by yaw, then tilt by pitch around X; orthographic projection.      var x1 = (x * Math.cos(yaw)) - (y * Math.sin(yaw));      var y1 = (x * Math.sin(yaw)) + (y * Math.cos(yaw));      var z1 = z * cfg.sz;      var y2 = (y1 * Math.cos(pitch)) - (z1 * Math.sin(pitch));      var d2 = (y1 * Math.sin(pitch)) + (z1 * Math.cos(pitch));      return {        x: cfg.ox + (x1 * cfg.sx),        y: cfg.oy + (y2 * cfg.sy),        d: d2      };    }    return {      x: cfg.ox + (x * cfg.sx) - (y * cfg.skx),      y: cfg.oy + (y * cfg.sy) - (z * cfg.sz),      d: y    };  }  function catmull(p0, p1, p2, p3, t) {    var t2 = t * t;    var t3 = t2 * t;    return 0.5 * (      (2 * p1) +      (-p0 + p2) * t +      (2 * p0 - 5 * p1 + 4 * p2 - p3) * t2 +      (-p0 + 3 * p1 - 3 * p2 + p3) * t3    );  }  function smoothRow(row, samplesPerSeg) {    var out = [];    var n = row.length;    if (n < 2) return row.slice();    for (var i = 0; i < n - 1; i++) {      var p0 = row[Math.max(0, i - 1)];      var p1 = row[i];      var p2 = row[i + 1];      var p3 = row[Math.min(n - 1, i + 2)];      for (var s = 0; s < samplesPerSeg; s++) {        var t = s / samplesPerSeg;        // Clamp Catmull output to the segment endpoints to avoid overshoot folds.        var v = catmull(p0, p1, p2, p3, t);        var lo = Math.min(p1, p2);        var hi = Math.max(p1, p2);        out.push(clamp(v, lo, hi));      }    }    out.push(row[n - 1]);    return out;  }  function polygonPoints(arrA, arrB) {    var pts = [];    for (var i = 0; i < arrA.length; i++) pts.push(arrA[i]);    for (var j = arrB.length - 1; j >= 0; j--) pts.push(arrB[j]);    return pts.map(function (p) { return p.x.toFixed(2) + ',' + p.y.toFixed(2); }).join(' ');  }  function lerpRows(a, b, t) {    var out = [];    for (var i = 0; i < a.length; i++) {      out.push({        x: a[i].x + ((b[i].x - a[i].x) * t),        y: a[i].y + ((b[i].y - a[i].y) * t)      });    }    return out;  }  function clampIndexFromNorm(norm, len) {    var n = clamp(norm, 0, 1);    return Math.max(0, Math.min(len - 1, Math.round(n * (len - 1))));  }  function catmullPath(points) {    if (!points || !points.length) return '';    if (points.length === 1) {      return 'M ' + points[0].x.toFixed(2) + ' ' + points[0].y.toFixed(2);    }    var d = 'M ' + points[0].x.toFixed(2) + ' ' + points[0].y.toFixed(2);    for (var i = 0; i < points.length - 1; i++) {      var p0 = points[Math.max(0, i - 1)];      var p1 = points[i];      var p2 = points[i + 1];      var p3 = points[Math.min(points.length - 1, i + 2)];      var cp1x = p1.x + (p2.x - p0.x) / 6;      var cp1y = p1.y + (p2.y - p0.y) / 6;      var cp2x = p2.x - (p3.x - p1.x) / 6;      var cp2y = p2.y - (p3.y - p1.y) / 6;      d +=        ' C ' + cp1x.toFixed(2) + ' ' + cp1y.toFixed(2) +        ' ' + cp2x.toFixed(2) + ' ' + cp2y.toFixed(2) +        ' ' + p2.x.toFixed(2) + ' ' + p2.y.toFixed(2);    }    return d;  }  function renderBezierSurface(svgEl, options) {    if (!svgEl) return;    if (!options.append) {      svgEl.__wv3dProjectedLayers = {};      svgEl.__wv3dHoverLabels = {};      svgEl.__wv3dCenterRefs = {};    }    var series = options.series || [];    if (!series.length || !series[0] || !series[0].length) {      svgEl.innerHTML = '';      return;    }    var maxV = maxInSeries(series);    var minV = minInSeries(series);    var useRangeNorm = !!options.zNormalizeRange;    var zNormMin = useRangeNorm      ? (isFinite(Number(options.zNormMin)) ? Number(options.zNormMin) : minV)      : 0;    var zNormMax = useRangeNorm      ? (isFinite(Number(options.zNormMax)) ? Number(options.zNormMax) : maxV)      : maxV;    if (zNormMax < zNormMin) {      var zTmp = zNormMax;      zNormMax = zNormMin;      zNormMin = zTmp;    }    var zSpan = Math.max(1e-9, zNormMax - (useRangeNorm ? zNormMin : 0));    var bins = series[0].length;    var samplesPerSeg = options.samplesPerSeg || 4;    var smoothed = [];    for (var y = 0; y < series.length; y++) {      smoothed.push(smoothRow(series[y], samplesPerSeg));    }    // Genre rows are represented as surface bands in this project.    // - With 1 genre row, add one parallel boundary row so the surface exists (1 band).    // - With N>1 genre rows, add one extrapolated boundary row so we render N bands.    if (smoothed.length === 1) {      smoothed.push(smoothed[0].slice());    } else if (smoothed.length > 1) {      var tail = smoothed[smoothed.length - 1];      var prev = smoothed[smoothed.length - 2];      var extra = [];      for (var ex = 0; ex < tail.length; ex++) {        extra.push(tail[ex] + (tail[ex] - prev[ex]));      }      smoothed.push(extra);    }    var cfg = {      ox: options.ox || 20,      oy: options.oy || 76,      sx: options.sx || 0.33,      sy: options.sy || 3,      sz: options.sz || 0.52,      skx: options.skx || 2,      projectionMode: options.projectionMode || 'legacy',      camYaw: options.camYaw || 0,      camPitch: options.camPitch || 0    };    var totalX = (bins - 1) * samplesPerSeg + 1;    cfg.sx = (options.plotWidth || 58) / Math.max(1, totalX - 1);    if (cfg.projectionMode === 'angles') cfg.sy = cfg.sx;    var yMaxIdx = Math.max(1, smoothed.length - 1);    var xMaxIdx = Math.max(1, totalX - 1);    var yCoordScale = 1;    if (options.squareXYModel) {      if (cfg.projectionMode === 'angles') {        // Canonical square model plane. Camera rotation is view-only.        yCoordScale = xMaxIdx / yMaxIdx;      } else {        // Legacy oblique projection compensation.        var refSy = (typeof options.squareXYModelRefSy === 'number' ? options.squareXYModelRefSy : 3);        var refSkx = (typeof options.squareXYModelRefSkx === 'number' ? options.squareXYModelRefSkx : 2);        var refSx = (typeof options.squareXYModelRefSx === 'number' ? options.squareXYModelRefSx : cfg.sx);        var yUnitProj = Math.max(1e-9, Math.hypot(refSy, refSkx));        var xUnitProj = Math.max(1e-9, refSx);        yCoordScale = (xMaxIdx / yMaxIdx) * (xUnitProj / yUnitProj);      }    } else if (options.squareXY) {      // Legacy projection-reference behavior.      var xUnitRef = Math.max(1e-9, (typeof options.squareXYRefXUnit === 'number' ? options.squareXYRefXUnit : cfg.sx));      var refSy = (typeof options.squareXYRefSy === 'number' ? options.squareXYRefSy : cfg.sy);      var refSkx = (typeof options.squareXYRefSkx === 'number' ? options.squareXYRefSkx : cfg.skx);      var yUnitRef = Math.max(1e-9, Math.hypot(refSy, refSkx));      yCoordScale = (xMaxIdx / yMaxIdx) * (xUnitRef / yUnitRef);    }    var baseColorA = options.colorA || '#e2b356';    var baseColorB = options.colorB || '#63b2a6';    var HOVER_UI = {      fillAlpha: 0.30,      strokeAlpha: 0.78,      cellStrokeW: 0.22,      anchorCellNorm: 0.60,      viewportMin: 3,      viewportMax: 97,      leaderColor: 'var(--wv-accent-1, #CFA100)',      leaderStrokeW: 0.52,      leaderFootLen: 6.0,      anchorDotR: 0.56,      anchorDotStroke: 'rgba(0,0,0,0.42)',      anchorDotStrokeW: 0.16,      labelTitleFs: 3.05,      labelBodyFs: 2.58,      labelPad: 1.15,      labelMinW: 17,      labelMaxW: 24,      labelWTitleFactor: 1.02,      labelWLineFactor: 0.90,      labelH: 15.2,      labelRx: 1.25,      labelFill: 'rgba(12,12,12,0.84)',      labelStroke: 'rgba(255,255,255,0.24)',      labelStrokeW: 0.30,      labelLine1Y: 4.15,      labelLine2Y: 9.10,      labelLine3Y: 13.25    };    var out = [];    var projected = [];    var baseTL = null;    var baseTR = null;    var baseBL = null;    var baseBR = null;    for (var yy = 0; yy < smoothed.length; yy++) {      var rowPts = [];      var yCoord = yy * yCoordScale;      for (var xx = 0; xx < smoothed[yy].length; xx++) {        var zBase = useRangeNorm ? (smoothed[yy][xx] - zNormMin) : smoothed[yy][xx];        var zNorm = clamp(zBase / zSpan, 0, 1);        if (typeof options.zGamma === 'number' && isFinite(options.zGamma) && options.zGamma > 0 && options.zGamma !== 1) {          zNorm = Math.pow(zNorm, options.zGamma);        }        var z = (zNorm * (options.zScale || 24)) + (Number(options.zLift) || 0);        var pz = proj3(xx, yCoord, z, cfg);        rowPts.push(pz);        if (yy === 0 && xx === 0) baseTL = proj3(xx, yCoord, 0, cfg);        if (yy === 0 && xx === smoothed[yy].length - 1) baseTR = proj3(xx, yCoord, 0, cfg);        if (yy === smoothed.length - 1 && xx === 0) baseBL = proj3(xx, yCoord, 0, cfg);        if (yy === smoothed.length - 1 && xx === smoothed[yy].length - 1) baseBR = proj3(xx, yCoord, 0, cfg);      }      projected.push(rowPts);    }    // Re-center the perspective so the surface itself is centered in the viewport.    var minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;    for (var py = 0; py < projected.length; py++) {      for (var px = 0; px < projected[py].length; px++) {        var p0 = projected[py][px];        if (p0.x < minX) minX = p0.x;        if (p0.x > maxX) maxX = p0.x;        if (p0.y < minY) minY = p0.y;        if (p0.y > maxY) maxY = p0.y;      }    }    var recenter = (options.recenter !== false);    var dx = 0;    var dy = 0;    var centerRefKey = options.centerRefKey ? String(options.centerRefKey) : "";    if (recenter) {      var reusedCenter = false;      if (centerRefKey) {        if (!svgEl.__wv3dCenterRefs) svgEl.__wv3dCenterRefs = {};        if (svgEl.__wv3dCenterRefs[centerRefKey]) {          dx = Number(svgEl.__wv3dCenterRefs[centerRefKey].dx) || 0;          dy = Number(svgEl.__wv3dCenterRefs[centerRefKey].dy) || 0;          reusedCenter = true;        }      }      if (!reusedCenter) {        var targetCX = (typeof options.centerX === 'number') ? options.centerX : 53;        var targetCY = (typeof options.centerY === 'number') ? options.centerY : 56;        var refCX = (minX + maxX) / 2;        var refCY = (minY + maxY) / 2;        if (options.centerByBasePlane && baseTL && baseTR && baseBL && baseBR) {          // Stabilize orbit framing by centering from the base plane (z=0), not z-extent bbox.          refCX = (baseTL.x + baseTR.x + baseBL.x + baseBR.x) / 4;          refCY = (baseTL.y + baseTR.y + baseBL.y + baseBR.y) / 4;        }        dx = targetCX - refCX;        dy = targetCY - refCY;        if (centerRefKey) {          svgEl.__wv3dCenterRefs[centerRefKey] = { dx: dx, dy: dy };        }      }      for (var ty = 0; ty < projected.length; ty++) {        for (var tx = 0; tx < projected[ty].length; tx++) {          projected[ty][tx].x += dx;          projected[ty][tx].y += dy;        }      }      minX += dx; maxX += dx; minY += dy; maxY += dy;    }    svgEl.__wv3dProjected = projected;    if (options.layerKey) {      if (!svgEl.__wv3dProjectedLayers) svgEl.__wv3dProjectedLayers = {};      svgEl.__wv3dProjectedLayers[options.layerKey] = projected;    }    var axisBaseBL = baseBL || { x: minX, y: maxY };    var axisBaseBR = baseBR || { x: maxX, y: maxY };    var axisBaseTL = baseTL || { x: minX, y: minY };    axisBaseBL.x += dx; axisBaseBL.y += dy;    axisBaseBR.x += dx; axisBaseBR.y += dy;    axisBaseTL.x += dx; axisBaseTL.y += dy;    var drawAxes = (options.drawAxes !== false);    if (options.hideAxisGuides === true) drawAxes = false;    if (drawAxes) {      out.push('<line x1="' + axisBaseBL.x.toFixed(2) + '" y1="' + axisBaseBL.y.toFixed(2) + '" x2="' + axisBaseBR.x.toFixed(2) + '" y2="' + axisBaseBR.y.toFixed(2) + '" stroke="rgba(255,255,255,0.28)" stroke-width="0.7"/>');      out.push('<line x1="' + axisBaseBL.x.toFixed(2) + '" y1="' + axisBaseBL.y.toFixed(2) + '" x2="' + axisBaseTL.x.toFixed(2) + '" y2="' + axisBaseTL.y.toFixed(2) + '" stroke="rgba(255,255,255,0.20)" stroke-width="0.7"/>');    }    // Draw as depth-sorted triangles (instead of row strips) to fix overlap artifacts.    var tris = [];    for (var y0 = 0; y0 < projected.length - 1; y0++) {      var alpha = 0.18 + (0.06 * (y0 / Math.max(1, projected.length - 1)));      var color = (y0 % 2 === 0) ? rgba(baseColorA, alpha) : rgba(baseColorB, alpha);      for (var x0 = 0; x0 < projected[y0].length - 1; x0++) {        var p00 = projected[y0][x0];        var p10 = projected[y0][x0 + 1];        var p01 = projected[y0 + 1][x0];        var p11 = projected[y0 + 1][x0 + 1];        tris.push({          d: (p00.d + p10.d + p11.d) / 3,          color: color,          pts: [p00, p10, p11]        });        tris.push({          d: (p00.d + p11.d + p01.d) / 3,          color: color,          pts: [p00, p11, p01]        });      }    }    tris.sort(function (a, b) { return a.d - b.d; }); // far -> near    for (var ti = 0; ti < tris.length; ti++) {      out.push(        '<polygon points="' +        tris[ti].pts.map(function (p) { return p.x.toFixed(2) + ',' + p.y.toFixed(2); }).join(' ') +        '" fill="' + tris[ti].color + '" stroke="none"/>'      );    }    // Optional x-band highlight projected onto the surface.    if (typeof options.bandNormLo === 'number' && typeof options.bandNormHi === 'number') {      var rowLen = projected[0].length;      var iLo = clampIndexFromNorm(Math.min(options.bandNormLo, options.bandNormHi), rowLen);      var iHi = clampIndexFromNorm(Math.max(options.bandNormLo, options.bandNormHi), rowLen);      if (iHi > iLo) {        var leftCol = [];        var rightCol = [];        for (var by = 0; by < projected.length; by++) {          leftCol.push(projected[by][iLo]);          rightCol.push(projected[by][iHi]);        }        for (var yb = 0; yb < projected.length - 1; yb++) {          var segA = projected[yb].slice(iLo, iHi + 1);          var segB = projected[yb + 1].slice(iLo, iHi + 1);          out.push(            '<polygon points="' + polygonPoints(segA, segB) + '"' +            ' fill="rgba(99,178,166,0.24)" stroke="rgba(99,178,166,0.34)" stroke-width="0.30"/>'          );        }        out.push('<path d="' + catmullPath(leftCol) + '" fill="none" stroke="rgba(