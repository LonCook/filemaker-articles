 manager     - LIB[24] Platform boot / HUD / safe render bridge     - LIB[66] Bezier 3D helper     - LIB[68] P4 dashboard renderer   Exports:     - None (HTML template only)   Notes:     - Renderer populates #wv-root at runtime     - Placeholder card lives inside #wv-root so the renderer can replace it cleanly   History:     - 25 Apr 2026 — Codex draft : move placeholder into #wv-root so successful renderer mount replaces it instead of rendering below it     - 04 Mar 2026, 14hr50PT — Lon Cook — lon@deconstrukted.com : add standard LIB header + inline LIB script includes   ============================================================ */‡‡LIB[20]‡‡<!-- PAGE_HEAD --><!-- (optional) <title>P4 Dashboard</title> --><div id="wv-root" class="wv-shell">  <div class="wv-card">    <div class="wv-title">PAGE 67 LIVE MARKER</div>    <div class="wv-subtitle">25 Apr 2026 / target = wv_viz</div>    <div class="wv-kv">LIB67 updated</div>  </div></div><!-- PAGE_SCRIPTS --><script> ‡‡LIB[66]‡‡</script><script> ‡‡LIB[68]‡‡</script>	1	LIBRARY_CODE-7A3FC0A8-A4BD-4B3C-8EBF-5C62939BCFD2	67		wv.page.viz.dashboard.p4.html	0	/* ============================================================   L I B R A R Y   C O D E   Index: 68   Name:  wv.renderer.viz.dashboard.p4.js   Purpose:     - P4 combined dashboard renderer (P1 + P3D + P2)     - FileMaker-target renderer with ctx-driven payloads     - Emits normalized action messages for dashboard interactions   Dependencies:     - LIB[22] WV runtime core     - LIB[23] Context manager     - LIB[24] Platform boot (registerRenderer / safe render)     - LIB[21] Base CSS (includes P4 scoped styles)     - LIB[66] Bezier 3D helper (window.WV3D)   Exports:     - WV.registerRenderer(function renderP4(ctx) {...})   Notes:     - Reads payload from ctx.__wv.viz.p4     - Falls back to deterministic defaults when optional fields are absent   History:    - 28 Apr 2026, 00hr10PT — Lon Cook — lon@deconstrukted.com : tag P2 mover focus actions with `meta.source = "p2_mover"` so the FileMaker receiver can capture post-selection diagnostics without changing native row-click behavior    - 27 Apr 2026, 23hr56PT — Lon Cook — lon@deconstrukted.com : restore rank-neighbor P1/P3 shading fallback to neighbors.rating_lo / neighbors.rating_hi after confirming the real defect is missing neighbors.* payload fields in ctx build, not the renderer’s rank-band logic    - 26 Apr 2026, 19hr37PT — Lon Cook — lon@deconstrukted.com : align P3 focus/band/neighbor guide planes to the same linear rating-space normalization used by P1 so stacked-surface highlights match the histogram range exactly    - 26 Apr 2026, 19hr26PT — Lon Cook — lon@deconstrukted.com : restore P1 rank-neighbor overlay to a single contiguous rating band while keeping discrete rug ticks, so sparse rank-neighbor bins do not spray full-height slices across the histogram    - 26 Apr 2026, 04hr31PT — Lon Cook — lon@deconstrukted.com : derive P1 rank-neighbor overlay from occupied histogram bins instead of a single min/max rating span so rank scopes do not imply continuous rating coverage    - 26 Apr 2026, 04hr26PT — Lon Cook — lon@deconstrukted.com : make P1 rank-neighbor range readable again with a full-height translucent band plus low rug ticks for discrete neighbor titles    - 26 Apr 2026, 04hr24PT — Lon Cook — lon@deconstrukted.com : restore a contained P1 rank-neighbor range overlay as a baseline strip while keeping discrete neighbor markers low to avoid filtered rating-space scatter    - 26 Apr 2026, 04hr22PT — Lon Cook — lon@deconstrukted.com : render rank-neighbor points as low histogram rug ticks instead of full-height rating markers so filtered rank scopes do not visually scatter across P1    - 04 Mar 2026, 14hr50PT — Lon Cook — lon@deconstrukted.com : add standard LIB header metadata   ============================================================ */(function () {  if (!window.WV) return;  WV._state = WV._state || {};  if (WV._state._vizDashP4Registered) return;  WV._state._vizDashP4Registered = true;  var NS = "http://www.w3.org/2000/svg";  var state = {    dom: null,    model: null,    ui: {      focusMovieId: "",      focusTitle: "",      focusRating: null,      hoverTitle: "",      hoverRating: null,      hoverMovieId: "",      extHoverTitle: "",      extHoverRating: null,      hoverSigma: null,      bandStartIdx: -1,      bandEndIdx: -1,      neighborsOn: true,      neighborRadius: 15,      applyToRows: true,      layers: { density: true, divergence: true, sigma: true },      animOn: true,      yawBase: 2.0,      pitch: 12.0    },    drag: {      active: false,      startIdx: -1,      currIdx: -1,      pointerId: null,      committed: false    },    hoverBin: -1,    hoverX: 0,    hoverY: 0,    hoverPoint: null,    p3Hover: {      active: false,      layerHover: "",      hoverRows: { sigma: -1, divergence: -1, density: -1 },      pinnedRows: { sigma: -1, divergence: -1, density: -1 }    },    orbit: {      offset: 0,      phase: 0,      lastTs: 0,      raf: 0,      yawAmpNeg: 8.0,      yawAmpPos: 4.0,      orbitHz: 0.042    },     yawDragging: false,     pitchDragging: false,     neighborEmitTimer: 0,     neighborLastEmitSig: "",     neighborLastEmitAt: 0,      hoverLastEmitMovieId: "",     actionScript: "WV__Rating_Dashboard_Action"   };  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }  function finiteOrNull(v) {    if (v === null || v === undefined || v === "") return null;    var n = Number(v);    return Number.isFinite(n) ? n : null;  }  function stringArray(v) {    if (!Array.isArray(v)) return [];    return v      .map(function (x) { return x == null ? "" : String(x); })      .filter(function (x) { return !!x; });  }  function normalizeNeighborPoints(v) {    if (!Array.isArray(v)) return [];    return v.map(function (p, i) {      p = p || {};      return {        movie_id: p.movie_id == null ? "" : String(p.movie_id),        title: p.title == null ? "" : String(p.title),        rating: finiteOrNull(p.rating),        sigma: finiteOrNull(p.sigma),        rank: finiteOrNull(p.rank),        isFocus: !!p.is_focus,        index: i      };    }).filter(function (p) {      return !!p.movie_id && Number.isFinite(p.rating);    });  }  function effectiveRankNeighborPoints(neighbors, focusMovieId, radius) {    neighbors = neighbors && typeof neighbors === "object" ? neighbors : {};    var source = Array.isArray(neighbors.scopePoints) && neighbors.scopePoints.length      ? neighbors.scopePoints      : (Array.isArray(neighbors.points) ? neighbors.points : []);    if (!source.length) return [];    if (!(Number.isFinite(neighbors.focusRank) && Number.isFinite(radius))) return source.slice();    var lo = Math.max(1, Math.round(neighbors.focusRank - radius));    var hi = Math.round(neighbors.focusRank + radius);    var out = [];    for (var i = 0; i < source.length; i++) {      var p = source[i];      var rank = Number(p && p.rank);      if (Number.isFinite(rank) && rank >= lo && rank <= hi) {        out.push({          movie_id: p.movie_id,          title: p.title,          rating: p.rating,          sigma: p.sigma,          rank: p.rank,          isFocus: !!p.isFocus || (!!focusMovieId && p.movie_id === focusMovieId),          index: p.index        });      }    }    return out;  }  function esc(s) {    return String(s == null ? "" : s)      .replace(/&/g, "&amp;")      .replace(/</g, "&lt;")      .replace(/>/g, "&gt;")      .replace(/\"/g, "&quot;")      .replace(/'/g, "&#39;");  }   function compressBins(arr, n) {    var out = [];    var src = Array.isArray(arr) ? arr : [];    var len = src.length;    if (!len) {      for (var z = 0; z < n; z++) out.push(0);      return out;    }    for (var i = 0; i < n; i++) {      var a = Math.floor((i / n) * len);      var b = Math.max(a + 1, Math.floor(((i + 1) / n) * len));      var s = 0;      var c = 0;      for (var j = a; j < b; j++) {        var v = Number(src[j]);        if (Number.isFinite(v)) {          s += v;          c++;        }      }      out.push(c ? (s / c) : 0);    }    return out;  }  function sumOf(arr) {    var s = 0;    for (var i = 0; i < arr.length; i++) s += Number(arr[i]) || 0;    return s;  }  function maxOf(arr) {    var m = 1;    for (var i = 0; i < arr.length; i++) m = Math.max(m, Number(arr[i]) || 0);    return m;  }  function xForRating(r, left, width, min, max) {    var span = Math.max(1e-9, max - min);    var t = (r - min) / span;    return left + (clamp(t, 0, 1) * width);  }  function binIndexFromRating(rating, d) {    var n = d.bins.length;    if (!n || !Number.isFinite(rating)) return -1;    var t = (rating - d.min) / Math.max(1e-9, d.max - d.min);    return clamp(Math.floor(t * n), 0, n - 1);  }  function ratingRangeForBins(iLo, iHi, d) {    var n = Math.max(1, d.bins.length);    var lo = Math.min(iLo, iHi);    var hi = Math.max(iLo, iHi);    var span = d.max - d.min;     return {      lo: d.min + ((lo / n) * span),      hi: d.min + (((hi + 1) / n) * span)     };   }  function emitAction(action, payload, meta) {    var msg = {      action: action,      payload: payload || {},      requestId: String(Date.now()) + "-" + Math.random().toString(36).slice(2, 10)    };    if (meta && typeof meta === "object") msg.meta = meta;    WV._state._p4LastAction = msg;    var raw = "{}";    try { raw = JSON.stringify(msg); } catch (_e) {}    try {      if (window.FileMaker && typeof window.FileMaker.PerformScript === "function") {        window.FileMaker.PerformScript(state.actionScript || "WV__Rating_Dashboard_Action", raw);      }    } catch (_e2) {}  }   function commitNeighborRadius(delayMs, refreshMode) {     if (state.neighborEmitTimer) {       window.clearTimeout(state.neighborEmitTimer);       state.neighborEmitTimer = 0;     }     function send() {       state.neighborEmitTimer = 0;       var radius = clamp(Math.round(Number(state.ui.neighborRadius) || 15), 5, 40);       var mode = refreshMode || "full";       var sig = mode + ":" + radius;       var now = Date.now();       if (delayMs <= 0 && sig === state.neighborLastEmitSig && (now - state.neighborLastEmitAt) < 160) return;       state.neighborLastEmitSig = sig;       state.neighborLastEmitAt = now;       emitAction("set_neighbors", { radius: radius }, { refresh: mode });     }     if (delayMs > 0) state.neighborEmitTimer = window.setTimeout(send, delayMs);     else send();   }  function emitHoverAction(movieId, title, rating, sigma, source) {    movieId = movieId == null ? "" : String(movieId);    if (movieId && state.hoverLastEmitMovieId === movieId) return;    if (!movieId && !state.hoverLastEmitMovieId) return;    state.hoverLastEmitMovieId = movieId;    if (!movieId) {      emitAction("clear_hover", {}, { refresh: "rows", source: source || "p4_hover" });      return;    }    emitAction("set_hover", {      movie_id: movieId,      title: title || "",      rating: Number.isFinite(rating) ? rating : null,      sigma: Number.isFinite(sigma) ? sigma : null    }, {      refresh: "rows",      source: source || "p4_hover"    });  }  function defaultBins(n) {    var out = [];    n = n || 32;    for (var i = 0; i < n; i++) {      var t = i / Math.max(1, n - 1);      var g1 = Math.exp(-Math.pow((t - 0.40) / 0.20, 2));      var g2 = 0.45 * Math.exp(-Math.pow((t - 0.76) / 0.15, 2));      out.push(Math.round((g1 + g2 + 0.06) * 100));    }    return out;  }  function normalizeP4(raw) {    raw = raw && typeof raw === "object" ? raw : {};    var d = raw.distribution && typeof raw.distribution === "object" ? raw.distribution : {};    var bins = Array.isArray(d.bins) ? d.bins.map(function (v) {      var n = Number(v);      return Number.isFinite(n) ? Math.max(0, n) : 0;    }) : defaultBins(32);    var min = Number(d.min);    var max = Number(d.max);    if (!Number.isFinite(min)) min = 1468;    if (!Number.isFinite(max)) max = 1540;    if (max <= min) max = min + 1;    var p25 = Number(d.p25);    var p50 = Number(d.p50);    var p75 = Number(d.p75);    if (!Number.isFinite(p25)) p25 = min + (0.25 * (max - min));    if (!Number.isFinite(p50)) p50 = min + (0.50 * (max - min));    if (!Number.isFinite(p75)) p75 = min + (0.75 * (max - min));     var movers = raw.movers && typeof raw.movers === "object" ? raw.movers : {};     var top = Array.isArray(movers.top) ? movers.top.slice(0, 3) : [];     var bottom = Array.isArray(movers.bottom) ? movers.bottom.slice(0, 3) : [];      var moverScopeRows = Array.isArray(movers.scope_rows) ? movers.scope_rows.slice() : [];      var moverSortOption = String(movers.sort_option || "");      var moverFullScopeRows = raw.neighbors && Array.isArray(raw.neighbors.scope_points)        ? raw.neighbors.scope_points.slice()        : [];     function normRow(r, up) {       r = r && typeof r === "object" ? r : {};      var movieId =        r.movie_id !== undefined && r.movie_id !== null ? String(r.movie_id) :        (r.movieId !== undefined && r.movieId !== null ? String(r.movieId) :        (r.id_movie !== undefined && r.id_movie !== null ? String(r.id_movie) : ""));       return {         movie_id: movieId,         title: String(r.title || (up ? "Top Item" : "Bottom Item")),         rating: Number.isFinite(Number(r.rating)) ? Number(r.rating) : p50,         sigma: clamp(Number(r.sigma), 0, 1) || 0.65,         delta: Number.isFinite(Number(r.delta)) ? Number(r.delta) : (up ? 6 : -6),         rank_prev: finiteOrNull(r.rank_prev),         rank_now: finiteOrNull(r.rank_now)       };     }     top = top.map(function (r) { return normRow(r, true); });     bottom = bottom.map(function (r) { return normRow(r, false); });      function buildMoverRankPrevMap(fullRows, movedRows, sortOption) {        var movedPriorByMovie = Object.create(null);        movedRows.forEach(function (r) {          r = r && typeof r === "object" ? r : {};          var movieId =            r.movie_id !== undefined && r.movie_id !== null ? String(r.movie_id) :            (r.movieId !== undefined && r.movieId !== null ? String(r.movieId) :            (r.id_movie !== undefined && r.id_movie !== null ? String(r.id_movie) : ""));          var priorRating = Number.isFinite(Number(r.prior_rating)) ? Number(r.prior_rating) : null;          if (movieId && Number.isFinite(priorRating)) movedPriorByMovie[movieId] = priorRating;        });        var scoped = fullRows.map(function (r) {          r = r && typeof r === "object" ? r : {};          var movieId =            r.movie_id !== undefined && r.movie_id !== null ? String(r.movie_id) :            (r.movieId !== undefined && r.movieId !== null ? String(r.movieId) :            (r.id_movie !== undefined && r.id_movie !== null ? String(r.id_movie) : ""));          var currentRating = Number.isFinite(Number(r.rating)) ? Number(r.rating) : null;          var priorRating = Number.isFinite(movedPriorByMovie[movieId]) ? movedPriorByMovie[movieId] : currentRating;          return {            movie_id: movieId,            title: String(r.title || movieId || ""),            prior_rating: priorRating          };        }).filter(function (r) {          return !!r.movie_id && Number.isFinite(r.prior_rating);        });        scoped.sort(function (a, b) {          if (a.prior_rating !== b.prior_rating) return b.prior_rating - a.prior_rating;          var t = a.title.localeCompare(b.title);          if (t) return t;          return a.movie_id.localeCompare(b.movie_id);        });        var n = scoped.length;        var invert = sortOption === "Rating ▲";        var out = Object.create(null);        scoped.forEach(function (row, idx) {          out[row.movie_id] = invert ? (n - idx) : (idx + 1);        });        return out;      }       var moverRankPrevByMovie = buildMoverRankPrevMap(moverFullScopeRows, moverScopeRows, moverSortOption);       var moverCurrentByMovie = Object.create(null);       moverFullScopeRows.forEach(function (r) {         r = r && typeof r === "object" ? r : {};         var movieId =           r.movie_id !== undefined && r.movie_id !== null ? String(r.movie_id) :           (r.movieId !== undefined && r.movieId !== null ? String(r.movieId) :           (r.id_movie !== undefined && r.id_movie !== null ? String(r.id_movie) : ""));         if (!movieId) return;         moverCurrentByMovie[movieId] = {           rank_now: finiteOrNull(r.rank),           rating: finiteOrNull(r.rating),           sigma: finiteOrNull(r.sigma),           title: String(r.title || movieId)         };       });       function attachMoverRankPrev(r) {         if (!r || !r.movie_id) return r;         if (Number.isFinite(r.rank_prev)) return r;         var derived = moverRankPrevByMovie[r.movie_id];         if (Number.isFinite(derived)) r.rank_prev = derived;         return r;       }       top = top.map(attachMoverRankPrev);       bottom = bottom.map(attachMoverRankPrev);       function moverDisplayDelta(row) {         if (row && Number.isFinite(row.rank_prev) && Number.isFinite(row.rank_now)) {           return row.rank_prev - row.rank_now;         }         return Number.isFinite(row && row.delta) ? row.delta : 0;       }       if (moverScopeRows.length && moverFullScopeRows.length) {         var rebuilt = moverScopeRows.map(function (r) {           r = r && typeof r === "object" ? r : {};           var movieId =             r.movie_id !== undefined && r.movie_id !== null ? String(r.movie_id) :             (r.movieId !== undefined && r.movieId !== null ? String(r.movieId) :             (r.id_movie !== undefined && r.id_movie !== null ? String(r.id_movie) : ""));           if (!movieId) return null;           var current = moverCurrentByMovie[movieId] || {};           var row = {             movie_id: movieId,             title: String(r.title || current.title || movieId),             rating: Number.isFinite(Number(r.rating)) ? Number(r.rating) : current.rating,             sigma: Number.isFinite(Number(r.sigma)) ? Number(r.sigma) : current.sigma,             delta: Number.isFinite(Number(r.delta)) ? Number(r.delta) : null,             rank_prev: finiteOrNull(moverRankPrevByMovie[movieId]),             rank_now: finiteOrNull(current.rank_now)           };           return row;         }).filter(function (r) { return !!r && !!r.movie_id; });         rebuilt.forEach(function (r) {           r._moveDelta = moverDisplayDelta(r);         });         top = rebuilt           .filter(function (r) { return r._moveDelta > 0; })           .sort(function (a, b) {             if (b._moveDelta !== a._moveDelta) return b._moveDelta - a._moveDelta;             if (Number.isFinite(a.rank_now) && Number.isFinite(b.rank_now) && a.rank_now !== b.rank_now) return a.rank_now - b.rank_now;             return a.title.localeCompare(b.title);           })           .slice(0, 3)           .map(function (r) { delete r._moveDelta; return r; });         bottom = rebuilt           .filter(function (r) { return r._moveDelta < 0; })           .sort(function (a, b) {             if (a._moveDelta !== b._moveDelta) return a._moveDelta - b._moveDelta;             if (Number.isFinite(a.rank_now) && Number.isFinite(b.rank_now) && a.rank_now !== b.rank_now) return a.rank_now - b.rank_now;             return a.title.localeCompare(b.title);           })           .slice(0, 3)           .map(function (r) { delete r._moveDelta; return r; });       }    var focus = raw.focus && typeof raw.focus === "object" ? raw.focus : {};    var focusMovieId =      focus.movie_id !== undefined && focus.movie_id !== null ? String(focus.movie_id) :      (focus.movieId !== undefined && focus.movieId !== null ? String(focus.movieId) :      (focus.id_movie !== undefined && focus.id_movie !== null ? String(focus.id_movie) : ""));    var hover = raw.hover && typeof raw.hover === "object" ? raw.hover : {};    var hoverTitle = String(hover.title || "");    var hoverRatingNum = Number(hover.rating);    var hoverValid = !!hoverTitle && Number.isFinite(hoverRatingNum);    var bands = raw.bands && typeof raw.bands === "object" ? raw.bands : {};    var neighbors = raw.neighbors && typeof raw.neighbors === "object" ? raw.neighbors : {};    var camera = raw.camera && typeof raw.camera === "object" ? raw.camera : {};    var anim = camera.animation && typeof camera.animation === "object" ? camera.animation : {};    var surfaces = raw.surfaces && typeof raw.surfaces === "object" ? raw.surfaces : {};    var surfaceSeries = surfaces.series && typeof surfaces.series === "object" ? surfaces.series : {};    var genres = (raw.filter && Array.isArray(raw.filter.genres)) ? raw.filter.genres.slice() : [];    if (!genres.length && Array.isArray(surfaceSeries.keys) && surfaceSeries.keys.length) {      genres = surfaceSeries.keys.map(function (k, i) {        var key = String(k || ("g_" + i));        return { key: key, label: key, weight: 0.5, sample: 0 };      });    }    if (!genres.length) {      genres = [        { key: "sci_fi", label: "Sci-Fi", weight: 0.98, sample: 188 },        { key: "thriller", label: "Thriller", weight: 0.80, sample: 149 },        { key: "drama", label: "Drama", weight: 0.67, sample: 132 }      ];    }    function normalizeSeriesMatrix(matrix) {      if (!Array.isArray(matrix)) return null;      var rows = [];      for (var r = 0; r < matrix.length; r++) {        if (!Array.isArray(matrix[r])) continue;        var row = [];        for (var c = 0; c < matrix[r].length; c++) {          var n = Number(matrix[r][c]);          row.push(Number.isFinite(n) ? Math.max(0, n) : 0);        }        if (row.length) rows.push(row);      }      return rows.length ? rows : null;    }    var filterLabel = (raw.filter && raw.filter.label) ? String(raw.filter.label) : "3 Genres";    var filterScope = (raw.filter && raw.filter.scope) ? String(raw.filter.scope).toLowerCase() : "";    if (!filterScope) {      var _fl = String(filterLabel || "").toLowerCase();      filterScope = (_fl === "all" || _fl === "all genres" || _fl.indexOf("all ") === 0) ? "all" : "scoped";    }    return {      filterLabel: filterLabel,      filter: {        scope: filterScope,        label: filterLabel      },      distribution: {        min: min,        max: max,        p25: p25,        p50: p50,        p75: p75,        bins: bins      },      focus: {        movie_id: focusMovieId,        title: String(focus.title || (focusMovieId ? "Selected" : "None")),        rating: Number.isFinite(Number(focus.rating)) ? Number(focus.rating) : null      },      hover: {        title: hoverTitle,        rating: hoverValid ? hoverRatingNum : null      },      bands: {        active: !!bands.active,        iLo: Number.isFinite(Number(bands.i_lo)) ? Number(bands.i_lo) : null,        iHi: Number.isFinite(Number(bands.i_hi)) ? Number(bands.i_hi) : null,        minPct: clamp(Number(bands.min_percentile), 0, 100),        maxPct: clamp(Number(bands.max_percentile), 0, 100)      },      neighbors: {        enabled: (neighbors.enabled !== false),        radius: clamp(Number(neighbors.radius) || 15, 5, 40),        basis: String(neighbors.basis || "rating").toLowerCase(),        ratingLo: finiteOrNull(neighbors.rating_lo),        ratingHi: finiteOrNull(neighbors.rating_hi),        movieIds: stringArray(neighbors.movie_ids),        points: normalizeNeighborPoints(neighbors.points),        scopePoints: normalizeNeighborPoints(neighbors.scope_points),        focusRank: finiteOrNull(neighbors.focus_rank),        rankLo: finiteOrNull(neighbors.rank_lo),        rankHi: finiteOrNull(neighbors.rank_hi),        scopeCount: finiteOrNull(neighbors.scope_count)      },      applyToRows: (raw.apply_to_rows !== false),      layers: {        zNormShared: (surfaces.z_norm_shared === true),        density: !(surfaces.density && surfaces.density.enabled === false),        divergence: !(surfaces.divergence && surfaces.divergence.enabled === false),        sigma: !(surfaces.sigma && surfaces.sigma.enabled === false)      },      surfaceSeries: {        keys: Array.isArray(surfaceSeries.keys) ? surfaceSeries.keys.map(function (v) { return String(v); }) : [],        density: normalizeSeriesMatrix(surfaceSeries.density),        divergence: normalizeSeriesMatrix(surfaceSeries.divergence),        sigma: normalizeSeriesMatrix(surfaceSeries.sigma)      },      camera: {        yaw: Number.isFinite(Number(camera.yaw)) ? Number(camera.yaw) : 2.0,        pitch: Number.isFinite(Number(camera.pitch)) ? Number(camera.pitch) : 12.0,        animEnabled: (anim.enabled !== false),        yawAmpNeg: Number.isFinite(Number(anim.yaw_amp_neg)) ? Number(anim.yaw_amp_neg) : 8.0,        yawAmpPos: Number.isFinite(Number(anim.yaw_amp_pos)) ? Number(anim.yaw_amp_pos) : 4.0,        orbitHz: Number.isFinite(Number(anim.orbit_hz)) ? Number(anim.orbit_hz) : 0.042      },      genres: genres.map(function (g, i) {        g = g || {};        var key = String(g.key || ("g_" + i));        var phRaw =          (g.placeholder !== undefined) ? g.placeholder :          ((g.isPlaceholder !== undefined) ? g.isPlaceholder :          ((g.is_placeholder !== undefined) ? g.is_placeholder :          ((g.placeholder_data !== undefined) ? g.placeholder_data :          ((g.using_placeholder !== undefined) ? g.using_placeholder : null))));        var ph = null;        var phTxt = String(phRaw).toLowerCase();        if (phRaw === true || phRaw === 1 || phTxt === "1" || phTxt === "true" || phTxt === "yes") ph = true;        else if (phRaw === false || phRaw === 0 || phTxt === "0" || phTxt === "false" || phTxt === "no") ph = false;        if (ph === null) {          var ds = String(g.dataSource || g.data_source || "").toLowerCase();          if (ds.indexOf("placeholder") >= 0) ph = true;          else if (ds.indexOf("real") >= 0 || ds.indexOf("live") >= 0) ph = false;        }        return {          key: key,          label: String(g.label || key),          weight: clamp(Number(g.weight), 0, 1) || 0.5,          sample: Math.max(0, Math.round(Number(g.sample) || 0)),          isPlaceholder: ph        };      }),      movers: {        top: top,        bottom: bottom      },      actionScript: raw.action_script ? String(raw.action_script) : "WV__Rating_Dashboard_Action"    };  }  function ensureRoot() {    var root = document.getElementById("wv-root");    if (!root) {      root = document.createElement("div");      root.id = "wv-root";      document.body.appendChild(root);    }    return root;  }  function ensureDom(root) {    if (state.dom && state.dom.root === root) return;    try { document.body.classList.add("wv-rating-dashboard-workbench-page"); } catch (_e) {}    root.classList.add("wv-theme-copper", "wv-rating-dashboard-workbench", "wv-rating-dashboard-workbench-page", "rd-runtime");    root.innerHTML =      '<div class="rd-shell-p4">' +        '<div class="rd-combo-grid">' +          '<div class="rd-combo-slot">' +            '<div class="rd-p4p1-controls layout-4">' +              '<button id="p4ChipFocus" class="rd-chip" type="button"><strong>Focus:</strong> <span class="rd-pill-val">None</span></button>' +              '<button id="p4ChipNeighbors" class="rd-chip" type="button"><strong>±:</strong><span id="p4ChipNeighborsVal">15</span><input id="p4ChipNeighborsRange" class="rd-chip-range rd-p3d-range rd-p3d-range-h" type="range" min="5" max="40" step="1" value="15" /></button>' +              '<button id="p4ChipBand" class="rd-chip" type="button"><strong>Bands:</strong> <span class="rd-pill-val">All</span