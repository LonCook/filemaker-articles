ityScore,    trueInterScore(signalSepDisplay, stabilityScore),    0.5,    blockHeightFromConfidence(stabilityScore),    blockCenterFromTickAndDelta(signalTick, signalDy, 0.32)   );   var separationTick = separationResultDisplay;   var separationGeom = geomCenteredPair(    sepBarDisplay,    separationTightnessScore,    trueInterScore(sepBarDisplay, separationTightnessScore),    0.5,    blockHeightFromConfidence(separationResultDisplay),    separationTick   );   var separationBlockCenter = separationGeom.block.top + (separationGeom.block.height * 0.5);   var signalSepCenter = signalGeom.left.top + (signalGeom.left.height * 0.5);   var separationDy = signalSepCenter - separationBlockCenter;   var separationDh = signalGeom.left.height - separationGeom.block.height;   var supportGeom = geomCenteredPair(    evidenceScore,    spanScore,    trueInterScore(evidenceScore, spanScore),    0.5,    blockHeightFromConfidence(1 - predUncertainty),    blockCenterFromTickAndDelta(supportTick, supportDy, 0.18)   );   function makeP10PairBar(kind, labelText) {    var combo = document.createElement("div");    combo.className = "p8t-combo";    var barEl = document.createElement("div");    barEl.className = "p8t-bar " + kind;    barEl.setAttribute("data-p10-kind", kind);    var left = document.createElement("div");    left.className = "p8t-left";    var right = document.createElement("div");    right.className = "p8t-right";    var overlap = document.createElement("div");    overlap.className = "p8t-overlap" + (kind === "support" ? " support" : "");    if (kind === "separation") {     left.style.background = "rgba(79,213,255,0.16)";     left.style.boxShadow = "inset 0 0 0 1px rgba(79,213,255,0.55)";     right.style.background = "rgba(230,200,94,0.07)";     right.style.boxShadow = "inset 0 0 0 1px rgba(230,200,94,0.34)";     overlap.style.background = "rgba(255,255,255,0.20)";     overlap.style.border = "1px solid rgba(198,117,255,0.92)";    