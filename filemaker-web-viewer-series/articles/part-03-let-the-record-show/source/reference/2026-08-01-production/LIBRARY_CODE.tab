,0.95)",        focusRectDash: "",        drawAxes: (li === 0),        labelSide: "right-fixed",        labelSlotIndex: slotIndex,        labelSlotCount: enabled.length,        labelSlotGap: 3.0,        hoverRowIndex: rowIdx,        hoverRowLabel: rowMeta ? rowMeta.label : "",        hoverRowIsPlaceholder: !!(rowMeta && rowMeta.isPlaceholder),        hoverPlaceholderIconFill: "var(--wv-tone-7, #E38C6D)",        hoverPlaceholderIconStroke: "var(--wv-tone-12, #E2B27B)",        hoverRowWeight: rowMeta ? rowMeta.weight : "",        hoverRowSample: rowMeta ? rowMeta.sample : "",        hoverLabelColor: "",        hoverLeaderColor: "",        hoverBorderColor: "",        hoverLine1Color: "",        hoverLine2Color: "",        hoverLine3Color: "",        hoverKeysColor: "",        hoverValuesColor: "",        hoverTitleColor: "",        hoverLine2Prefix: "Weight:",        hoverLine3Prefix: "Sample:",        hoverLabelPointerEvents: false,        zNormalizeRange: true,        bandNormLo: bandNorm ? bandNorm.lo : null,        bandNormHi: bandNorm ? bandNorm.hi : null,        neighborNormLo: neighborNorm ? neighborNorm.lo : null,        neighborNormHi: neighborNorm ? neighborNorm.hi : null,        layerKey: layer.key,        layerLabel: layer.key      });    }  }  function orbitOffsetFromPhase(phase) {    var sShaped = Math.sin(phase - (0.22 * Math.sin(2 * phase)));    return sShaped * (sShaped < 0 ? state.orbit.yawAmpNeg : state.orbit.yawAmpPos);  }  function phaseDeltaAbs(a, b) {    var d = Math.abs(a - b) % (Math.PI * 2);    return Math.min(d, (Math.PI * 2) - d);  }  function seekOrbitToYaw(yawDisplay) {    if (!Number.isFinite(yawDisplay)) return;    var targetOffset = clamp(      yawDisplay - state.ui.yawBase,      -state.orbit.yawAmpNeg,      state.orbit.yawAmpPos    );    var tau = Math.PI * 2;    var basePhase = Number.isFinite(state.orbit.phase) ? state.orbit.phase : 0;    var bestPhase = basePhase;    var best