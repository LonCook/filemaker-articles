eateElement("div");   header.style.position = "sticky";   header.style.top = "0";   header.style.padding = "7px 10px";   header.style.borderBottom = "1px solid rgba(255,255,255,0.12)";   header.style.background = "rgba(0,0,0,0.85)";   header.style.borderTopLeftRadius = "12px";   header.style.borderTopRightRadius = "12px";   header.style.pointerEvents = "auto";   header.style.cursor = "default";   header.style.userSelect = "none";   header.style.webkitUserSelect = "none";   // header row (title + pill)   var headRow = document.createElement("div");   headRow.style.display = "flex";   headRow.style.alignItems = "center";   headRow.style.justifyContent = "space-between";   headRow.style.gap = "8px";   // title line   var title = document.createElement("div");   title.textContent = "WV DEBUG HUD";   title.style.fontWeight = "600";   title.style.letterSpacing = "0.4px";   title.style.color = "#95821D";   // pill   var pill = document.createElement("div");   pill.textContent = "FULL";   pill.style.fontSize = "8px";   pill.style.fontWeight = "700";   pill.style.letterSpacing = "0.6px";   pill.style.padding = "2px 6px";   pill.style.borderRadius = "999px";   pill.style.border = "1px solid rgba(149,130,29,0.55)";   pill.style.background = "rgba(149,130,29,0.14)";   pill.style.color = "#95821D";   pill.style.flex = "0 0 auto";   pill.style.userSelect = "none";   pill.style.webkitUserSelect = "none";   headRow.appendChild(title);   headRow.appendChild(pill);   header.appendChild(headRow);   // --- body (scrollable) ---   var body = document.createElement("div");   body.style.margin = "0";   body.style.padding = "8px 10px";   body.style.whiteSpace = "pre-wrap";   // body is the only scroll region   body.style.overflow = "auto";   body.style.overflowX = "hidden";   body.style.webkitOverflowScrolling = "touch";   // allow scroll / text selection inside HUD if desired   body.style.pointerEvents = "auto";   wrap.appendChild(header);   wrap.appendChild(body);   document.documentElement.appendChild(wrap);   WV._hud = {    wrap: wrap,    header: header,    title: title,    pill: pill,    body: body,    last: "",    mode: "full"   };   // ------------------------------------------------------------   // Toggle handlers (FileMaker-proof) — UPDATED   // ------------------------------------------------------------   (function () {    function doToggle(ev) {     try {      WV._hud.mode = (WV._hud.mode === "mini") ? "full" : "mini";      // bust cache so you always see an immediate change      WV._hud.last = "";      hudUpdate(true);     } catch (e) {}    }    function bind(el) {     if (!el) return;     var lastTs = 0;     var lastX  = 0;     var lastY  = 0;     function getXY(ev) {      try {       if (ev && ev.touches && ev.touches.length) {        return {         x: ev.touches[0].clientX || 0,         y: ev.touches[0].clientY || 0        };       }       return { x: ev.clientX || 0, y: ev.clientY || 0 };      } catch (e) {       return { x: 0, y: 0 };      }     }     function maybeToggle(ev) {      try {       // Native dblclick when it actually fires       if (ev && ev.type === "dblclick") {        if (ev.preventDefault) ev.preventDefault();        if (ev.stopPropagation) ev.stopPropagation();        doToggle(ev);        return;       }       // Some builds expose click-count here       if (ev && typeof ev.detail === "number" && ev.detail === 2) {        if (ev.preventDefault) ev.preventDefault();        if (ev.stopPropagation) ev.stopPropagation();        doToggle(ev);        return;       }       // Single click toggles directly       if (ev && ev.type === "click") {        if (ev.preventDefault) ev.preventDefault();        if (ev.stopPropagation) ev.stopPropagation();        doToggle(ev);        return;       }       var now = Date.now();       var pt  = getXY(ev);       var dt = now - (lastTs || 0);       var dx = Math.abs((pt.x || 0) - (lastX || 0));       var dy = Math.abs((pt.y || 0) - (lastY || 0));       lastTs = now;       lastX  = pt.x || 0;       lastY  = pt.y || 0;       // Two clicks/taps within 340ms and within 10px => toggle       if (dt > 0 && dt < 340 && dx <= 10 && dy <= 10) {        if (ev && ev.preventDefault) ev.preventDefault();        if (ev && ev.stopPropagation) ev.stopPropagation();        doToggle(ev);       }      } catch (e) {}     }     // Capture phase helps in FM WV     el.addEventListener("dblclick",  maybeToggle, true);     el.addEventListener("click",     maybeToggle, true);    }    // Bind to header + its children only    bind(header);    bind(title);    bind(pill);   })();  } catch (e) {} } function normalizeDebugFlag(val) {  var out = { raw: val, isFalse: false, isTrue: false, mode: "" };  try {   if (val === true || val === 1) { out.isTrue = true; return out; }   if (val === false || val === 0) { out.isFalse = true; return out; }   if (typeof val === "string") {    var v = val.toLowerCase();    if (v === "false" || v === "0" || v === "") { out.isFalse = true; return out; }    if (v === "true" || v === "1") { out.isTrue = true; return out; }    if (v === "mini" || v === "full") { out.isTrue = true; out.mode = v; return out; }   }  } catch (_e) {}  return out; } function normalizeMode(val) {  try {   if (typeof val === "string" && (val === "mini" || val === "full")) return val;  } catch (_e) {}  return ""; } // ------------------------------------------------------------ // HUD visibility + mode resolution // ------------------------------------------------------------ function resolveHudMode() {  try {   var ctx = (typeof WV.getContext === "function") ? WV.getContext() : {};   var wv  = (ctx && ctx.__wv && typeof ctx.__wv === "object") ? ctx.__wv : {};   var dInfo = normalizeDebugFlag(wv.debug);   var mInfo = normalizeMode(wv.debug_mode);   // --------------------------------------------   // Bootstrap failsafe:   // Show until first context arrives, then obey ctx.__wv.debug   // --------------------------------------------   if (!WV._state._ctxSeen) {    return { show: true, mode: (WV._hud && WV._hud.mode) ? WV._hud.mode : "full", diag: { raw: wv.debug, show: true, mode: (WV._hud && WV._hud.mode) ? WV._hud.mode : "full" } };   }   // HARD OFF: explicit false means hide regardless of debug_mode   if (dInfo.isFalse) {    return { show: false, mode: "full", diag: { raw: wv.debug, show: false, mode: "full" } };   }   // Determine whether HUD is enabled   var enabled = dInfo.isTrue || !!dInfo.mode || (mInfo === "mini" || mInfo === "full");   if (!enabled) {    return { show: false, mode: "full", diag: { raw: wv.debug, show: false, mode: "full" } };   }   // Requested mode (only matters if enabled)   var requested = (mInfo === "mini" || mInfo === "full") ? mInfo :    (dInfo.mode === "mini" || dInfo.mode === "full") ? dInfo.mode :    "full";   // Keep local toggle if present; context only seeds initial default   var mode =    (WV._hud && (WV._hud.mode === "mini" || WV._hud.mode === "full"))     ? WV._hud.mode     : requested;   return { show: true, mode: mode, diag: { raw: wv.debug, show: true, mode: mode } };  } catch (e) {   return { show: false, mode: "full", diag: { raw: undefined, show: false, mode: "full" } };  } } function esc(s) {  try {   return String(s)    .replace(/&/g, "&amp;")    .replace(/</g, "&lt;")    .replace(/>/g, "&gt;")    .replace(/"/g, "&quot;")    .replace(/'/g, "&#39;");  } catch (e) {   return "";  } } function line(label, value, color) {  var c = color || "#95821D";  return '<div style="color:' + c + '"><span style="opacity:.85">' + esc(label) + '</span> ' + esc(value) + '</div>'; } function hudText(mode) {  try {   var ctx = (typeof WV.getContext === "function") ? WV.getContext() : {};   var wv  = (ctx && ctx.__wv && typeof ctx.__wv === "object") ? ctx.__wv : {};   var GOLD  = "#95821D";   var GREEN = "#36D26E";   var RED   = "#FF5C5C";   var DIM   = "rgba(149,130,29,0.70)";   var hasRenderer = !!WV._state.hasRenderer;   var pending     = !!WV._state.pendingContext;   var rendererColor = hasRenderer ? GREEN : (pending ? RED : GOLD);   // FIX: page fallback to __wv.viewer.index   var pageVal = (wv.page !== undefined && wv.page !== null && wv.page !== "") ? wv.page :    (wv.viewer && wv.viewer.index !== undefined ? wv.viewer.index : "");   var out = "";   out += line("renderCount:", String(WV._state.renderCount || 0), GOLD);   out += line("hasRenderer:", String(hasRenderer), rendererColor);   out += line("pendingContext:", String(pending), pending ? (hasRenderer ? GOLD : RED) : DIM);   out += line("page:", String(pageVal), GOLD);   out += line("lastUpdateTs:", String(WV._state.lastUpdateTs || ""), DIM);   if (mode === "mini") {    return out;   }   var dump = "";   try {    dump = JSON.stringify(ctx, null, 2);   } catch (_e) {    dump = "[ctx stringify error]";   }   out += '<div style="height:6px"></div>';   out += '<div style="color:' + DIM + '; opacity:.95">ctx:</div>';   out += '<div style="color:' + DIM + '; white-space:pre-wrap">' + esc(dump) + '</div>';   return out;  } catch (e) {   return '<div style="color:#95821D">renderCount: ' + esc(WV._state.renderCount || 0) + '</div>' +          '<div style="color:#FF5C5C">(err building HUD text)</div>';  } } function hudUpdate(force) {  try {   ensureHud();   var r = resolveHudMode();   if (!WV._hud || !WV._hud.wrap || !WV._hud.body) return;   WV._hud.wrap.style.display = r.show ? "block" : "none";   if (!r.show) return;   // persist mode   WV._hud.mode = r.mode;   // pill text   if (WV._hud.pill) {    WV._hud.pill.textContent = (r.mode === "mini") ? "MINI" : "FULL";   }   WV._hud.wrap.style.maxHeight = (r.mode === "mini") ? "18vh" : "82vh";   WV._hud.body.style.height =    (r.mode === "mini")     ? "calc(18vh - 44px)"     : "calc(82vh - 44px)";   var t = hudText(r.mode);   if (force || t !== WV._hud.last) {    WV._hud.body.innerHTML = t;    WV._hud.last = t;   }  } catch (e) {} } // ------------------------------------------------------------ // Renderer detection // ------------------------------------------------------------ function detectRenderer() {  try {   if (typeof WV.render === "function" && WV.render !== WV._state._defaultRenderFn) {    WV._state.hasRenderer = true;    return true;   }   return !!WV._state.hasRenderer;  } catch (e) {   return !!WV._state.hasRenderer;  } } // ------------------------------------------------------------ // Safe render (platform-owned render count + hud update) // ------------------------------------------------------------ WV._safeRender = WV._safeRender || function (ctx) {  try {   WV._state.renderCount = (WV._state.renderCount || 0) + 1;   if (typeof WV.render === "function") {    WV.render(ctx || {});   }   hudUpdate();   return "ok";  } catch (e) {   try { console.error("WV.render error:", e); } catch (_e) {}   hudUpdate();   return "err";  } }; // ------------------------------------------------------------ // Renderer registration (optional convenience) // ------------------------------------------------------------ WV.registerRenderer = WV.registerRenderer || function (fn) {  try {   if (typeof fn === "function") {    WV.render = fn;    WV._state.hasRenderer = true;    if (WV._state.pendingContext) {     var c = WV._state.pendingContext;     WV._state.pendingContext = null;     WV._safeRender(c);    }   }   hudUpdate();   return "ok";  } catch (e) {   try { console.error("WV.registerRenderer error:", e); } catch (_e) {}   hudUpdate();   return "err";  } }; // ------------------------------------------------------------ // Context change hook (INSTALL UNCONDITIONALLY) // ------------------------------------------------------------ WV.onContextChange = function (ctx) {  try {   var wasSeen = !!WV._state._ctxSeen;   // mark that context has arrived   WV._state._ctxSeen = true;   var has = detectRenderer();   if (!has) {    WV._state.pendingContext = ctx;    hudUpdate();    return "noRender";   }   if (!wasSeen) {    try {     var wv = (ctx && ctx.__wv && typeof ctx.__wv === "object") ? ctx.__wv : {};     if (wv.debug_diag === true) {      console.log("WV ctxSeen flipped", { ctxSeen: true });     }    } catch (_e) {}   }   return WV._safeRender(ctx);  } catch (e) {   hudUpdate();   return "err";  } }; // One HUD update at boot hudUpdate();})();	1	LIBRARY_CODE-522CC7CF-08A2-4999-A28A-01A864D24A92	24		wv.platform.boot.js	0	<!-- ============================================================     L I B R A R Y   C O D E     Index: 40     Name:  wv.page.viz.dashboard.html     Purpose:       - Page shell for multi-visualization dashboard       - Expands LIB[20] base HTML template       - Injects PAGE_BODY placeholder content       - Loads page-specific renderer (LIB[41])     Dependencies:       - LIB[20] Base HTML shell       - LIB[21] Base CSS       - LIB[22] WV runtime core       - LIB[23] Context manager       - LIB[24] Platform boot / HUD / safe render bridge       - LIB[41] Multi-panel visualization renderer     Exports:       - None (HTML template only)     Notes:       - Renderer populates #wv-root at runtime       - Placeholder card provides safe visual baseline before context arrives       - Keep shell structure stable to avoid WV initialization regressions     History:       - 01 Feb 2026, 04hr44PT — Lon Cook — lon@deconstrukted.com : updated for multi-viz dashboard     ============================================================ -->‡‡LIB[20]‡‡<!-- PAGE_HEAD --><!-- (optional) <title>Visualization Dashboard</title> --><!-- PAGE_BODY --><!-- Renderer will populate #wv-root --><div class="wv-shell"> <div class="wv-card">  <div class="wv-title">Visualization Dashboard</div>  <div class="wv-subtitle">Waiting for context…</div>  <div class="wv-kv">Renderer: LIB[41]</div> </div></div><!-- PAGE_SCRIPTS --><script> ‡‡LIB[41]‡‡</script>	1	LIBRARY_CODE-28068080-2FA1-4124-8A3C-04EB55A1D532	40		wv.template.page.standard.html	0	/* ============================================================   W V   P A G E   Index: 41   Name:  wv.page.viz.dashboard.html   Purpose:     - Page wrapper that loads WV platform + registers dashboard renderer   Dependencies:     - LIB[20] shell (brings in 21/22/23/24)     - LIB[42] renderer module   ============================================================ */‡‡LIB[20]‡‡<!-- PAGE_HEAD --><!-- (optional) <title>WV Dashboard</title> --><!-- PAGE_BODY --><!-- Root is provided by LIB[20] as #wv-root --><!-- PAGE_SCRIPTS --><script>‡‡LIB[42]‡‡</script>	1	LIBRARY_CODE-F18BAB04-2768-4610-B3C5-B04B6D93500E	41		wv.page.viz.dashboard.html	0	/* ============================================================   L I B R A R Y   C O D E   Index: 42   Name:  wv.renderer.viz.multi.js   Purpose:     - Multi-panel visualization renderer for ONE Web Viewer     - Uses WV.registerRenderer(fn) so platform boot controls render timing and counts     - Builds a simple grid of “cards” and dispatches per panel via viz[].type     - Implements list rendering for:         - rank_list   (title + rating + n)         - uncert_list (title + sigma + n)         - status      (ctx dump)   Dependencies:     - LIB[22] WV runtime core     - LIB[23] Context manager     - LIB[24] Platform boot (registerRenderer / safeRender / HUD)   Exports:     - WV.registerRenderer( function(ctx, meta) {...} )   Notes:     - ctx.viz may be an object or array; normalized to array     - Minimal inline styles; preserves class hooks for LIB[21]     - No pills/badges; relies on platform HUD for debug state   History:     - 01 Feb 2026, 00hr??PT — Lon Cook — : created     - 02 Feb 2026, 00hr??PT — Lon Cook — : list rendering for rank_list / uncert_list   ============================================================ */(function () { if (!window.WV) return; function ensureRoot() {  var root = document.getElementById("wv-root");  if (root) return root;  root = document.createElement("div");  root.id = "wv-root";  document.body.appendChild(root);  return root; } function normalizeViz(viz) {  if (!viz) return [];  if (Array.isArray(viz)) return viz;  return [ viz ]; } function esc(s) {  try {   return String(s)    .replace(/&/g, "&amp;")    .replace(/</g, "&lt;")    .replace(/>/g, "&gt;")    .replace(/"/g, "&quot;")    .replace(/'/g, "&#39;");  } catch (e) {   return "";  } } function fmtNum(n, digits) {  try {   if (n === null || n === undefined || n === "") return "";   var x = Number(n);   if (!isFinite(x)) return String(n);   if (typeof digits === "number") return x.toFixed(digits);   return String(x);  } catch (e) {   return String(n || "");  } } function buildLayout(root, panels, ui) {  var cols = 1;  try {   if (ui && ui.layout === "grid") {    cols = (ui.cols && ui.cols > 0) ? ui.cols : 2;   }  } catch (e) {}  root.innerHTML = "";  var wrap = document.createElement("div");  wrap.className = "wv-shell";  // Minimal inline styles (class hooks preserved)  wrap.style.display = "grid";  wrap.style.gridTemplateColumns = "repeat(" + cols + ", minmax(0, 1fr))";  wrap.style.gap = "10px";  wrap.style.alignItems = "stretch";  for (var i = 0; i < panels.length; i++) {   var p = panels[i] || {};   var id = (p.id != null) ? String(p.id) : ("panel_" + i);   var card = document.createElement("div");   card.className = "wv-card";   card.setAttribute("data-panel-id", id);   if (p.colSpan && p.colSpan > 1) {    card.style.gridColumn = "span " + p.colSpan;   }   var title = document.createElement("div");   title.className = "wv-title";   title.textContent = (p.title != null) ? String(p.title) : (p.type ? String(p.type) : id);   var body = document.createElement("div");   body.className = "wv-panel";   body.id = "viz_" + id;   // Slightly safer defaults if CSS is sparse   body.style.marginTop = "6px";   card.appendChild(title);   card.appendChild(body);   wrap.appendChild(card);  }  root.appendChild(wrap); } // ------------------------------------------------------------ // L I S T   R E N D E R I N G // ------------------------------------------------------------ function renderList(panel, el, mode) {  // mode: "rank" or "uncert"  var rows = (panel && Array.isArray(panel.data)) ? panel.data : [];  el.innerHTML = "";  if (!rows.length) {   var empty = document.createElement("div");   empty.className = "wv-kv wv-empty";   empty.textContent = "No rows";   el.appendChild(empty);   return;  }  // Container  var list = document.createElement("div");  list.className = "wv-list";  for (var i = 0; i < rows.length; i++) {   var r = rows[i] || {};   var title = (r.title != null) ? String(r.title) : "";   var n = (r.n != null) ? r.n : "";   var metricLabel = "";   var metricVal = "";   if (mode === "rank") {    metricLabel = "rating";    metricVal = (r.rating != null) ? r.rating : "";   } else {    metricLabel = "σ";    metricVal = (r.sigma != null) ? r.sigma : "";   }   // Row   var row = document.createElement("div");   row.className = "wv-row";   // Title (truncate)   var cTitle = document.createElement("div");   cTitle.className = "wv-row-title";   cTitle.textContent = title;   // Metric   var cMetric = document.createElement("div");   cMetric.className = "wv-row-metric";   cMetric.textContent =    (mode === "rank")     ? fmtNum(metricVal, 2)     : (metricLabel + " " + fmtNum(metricVal, 2));   // n   var cN = document.createElement("div");   cN.className = "wv-row-n";   cN.textContent = "n=" + fmtNum(n);   row.appendChild(cTitle);   row.appendChild(cMetric);   row.appendChild(cN);   list.appendChild(row);  }  el.appendChild(list); } function drawPanel_status(panel, el, ctx) {  el.innerHTML = "";  var pre = document.createElement("pre");  pre.className = "wv-kv wv-pre";  var payload = {   defaults: ctx && ctx.defaults ? ctx.defaults : {},   ui: ctx && ctx.ui ? ctx.ui : {},   viz: panel || {}  };  try { pre.textContent = JSON.stringify(payload, null, 2); }  catch (e) { pre.textContent = "[status]"; }  el.appendChild(pre); } function drawPanel(panel, el, ctx) {  var t = (panel && panel.type) ? String(panel.type) : "placeholder";  if (t === "rank_list") {   return renderList(panel, el, "rank");  }  if (t === "uncert_list") {   return renderList(panel, el, "uncert");  }  if (t === "status") {   return drawPanel_status(panel, el, ctx || {});  }  // fallback: show panel JSON (kept for safety)  el.innerHTML = "";  var pre = document.createElement("pre");  pre.className = "wv-pre";  var payload = {   type: t,   defaults: ctx && ctx.defaults ? ctx.defaults : {},   viz: panel || {}  };  try { pre.textContent = JSON.stringify(payload, null, 2); }  catch (e) { pre.textContent = "[panel render]"; }  el.appendChild(pre); } WV.registerRenderer(function (ctx, meta) {  var root = ensureRoot();  var panels = normalizeViz(ctx ? ctx.viz : null);  var ui = (ctx && ctx.ui) ? ctx.ui : {};  buildLayout(root, panels, ui);  for (var i = 0; i < panels.length; i++) {   var p = panels[i] || {};   var id = (p.id != null) ? String(p.id) : ("panel_" + i);   var el = document.getElementById("viz_" + id);   if (!el) continue;   try {    drawPanel(p, el, ctx || {});   } catch (e) {    try { el.textContent = "panel error"; } catch (e2) {}   }  } });})();	1	LIBRARY_CODE-E03C4975-D7A0-490D-8B97-CBD885E3C2BE	42		 wv.renderer.viz.multi.js	0	‡‡LIB[40]‡‡<!-- PAGE_HEAD --><title>Healthcheck</title><!-- PAGE_BODY --><div class="wv-shell"> <div class="wv-card">  <div class="wv-title">Healthcheck</div>  <div class="wv-subtitle">Verifies platform boot + live context push (WV.setContext).</div>  <div class="wv-divider"></div>  <div class="wv-kv">   <div class="wv-k">WV</div>   <div class="wv-v" id="wv_status">checking…</div>  </div>  <div class="wv-kv">   <div class="wv-k">Last update</div>   <div class="wv-v" id="wv_ts">—</div>  </div>  <div class="wv-divider"></div>  <pre class="wv-pre" id="ctx">…</pre> </div></div><!-- PAGE_SCRIPTS --><script>(function () { function safeStringify(obj) {  try {   if (window.WV && typeof WV.safeJsonStringify === "function") {    return WV.safeJsonStringify(obj, "");   }   return JSON.stringify(obj, null, 2);  } catch (e) {   return String(e);  } } function render(ctx) {  try {   var statusEl = document.getElementById("wv_status");   var tsEl = document.getElementById("wv_ts");   var ctxEl = document.getElementById("ctx");   if (statusEl) {    statusEl.textContent = (window.WV && typeof WV.getContext === "function") ? "ok" : "missing";   }   if (tsEl) {    tsEl.textContent = new Date().toISOString();   }   if (ctxEl) {    ctxEl.textContent = safeStringify(ctx || {});   }  } catch (e) {   try { console.error(e); } catch (_e) {}  } } try {  // If platform boot has already defined WV, wire render hook.  if (window.WV) {   WV.render = render;   // Render immediately using current context if available.   if (typeof WV.getContext === "function") {    render(WV.getContext());   } else {    render({});   }  } else {   // WV missing means boot didn't run; still show something.   render({ error: "WV missing (platform boot not initialized)" });  } } catch (e) {  try { console.error(e); } catch (_e) {} }})();</script>	1	LIBRARY_CODE-A4F04ED6-1275-4587-B02A-3E1DA7BEEF86	60		viz.healthcheck.entry.html	0	<!-- PAGE_HEAD --><style> #wv-root {  padding: 12px;  overflow: auto; } .wv-debug-card {  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;  font-size: 12px;  line-height: 1.35;  white-space: pre-wrap;  word-break: break-word;  border: 1px solid rgba(255,255,255,0.12);  border-radius: 10px;  padding: 12px; } .wv-debug-title {  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;  font-size: 13px;  opacity: 0.85;  margin: 0 0 10px 0; } .wv-debug-meta {  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;  font-size: 12px;  opacity: 0.7;  margin: 0 0 10px 0; } .wv-debug-row {  display: flex;  gap: 10px;  flex-wrap: wrap;  margin-bottom: 10px; } .wv-pill {  border: 1px solid rgba(255,255,255,0.14);  border-radius: 999px;  padding: 4px 10px;  font-size: 12px;  opacity: 0.85; }</style><!-- PAGE_BODY --><div class="wv-debug-title">WV Debug: Context Echo</div><div class="wv-debug-row"> <div class="wv-pill" id="wv-pill-page">page: (none)</div> <div class="wv-pill" id="wv-pill-ts">ts: (none)</div> <div class="wv-pill" id="wv-pill-last">lastUpdateTs: (none)</div></div><div class="wv-debug-meta">This view updates via <code>WV.setContext(ctx)</code> (no reload).</div><div class="wv-debug-card" id="wv-debug-pre">{}</div><!-- PAGE_SCRIPTS --><script> (function () {  function safeStringify(obj) {   try {    return JSON.stringify(obj, null, 2);   } catch (e) {    return String(obj);   }  }  function render(ctx) {   var pre = document.getElementById("wv-debug-pre");   var pillPage = document.getElementById("wv-pill-page");   var pillTs = document.getElementById("wv-pill-ts");   var pillLast = document.getElementById("wv-pill-last");   if (!ctx || typeof ctx !== "object") {    ctx = {};   }   if (pre) {    pre.textContent = safeStringify(ctx);   }   if (pillPage) {    pillPage.textContent = "page: " + (ctx.page !== undefined ? String(ctx.page) : "(none)");   }   if (pillTs) {    pillTs.textContent = "ts: " + (ctx.ts !== undefined ? String(ctx.ts) : "(none)");   }   try {    var last = (window.WV && WV._state && WV._state.lastUpdateTs) ? String(WV._state.lastUpdateTs) : "(none)";    if (pillLast) pillLast.textContent = "lastUpdateTs: " + last;   } catch (e) {}  }  // Bind into platform contract:  if (window.WV) {   // Visualization defines render:   WV.render = render;   // If platform boot layer already wires onContextChange->render, great.   // If not, enforce it safely here:   WV.onContextChange = function (ctx) {    try { render(ctx); } catch (e) {}   };   // initial draw   try {    render(WV.getContext ? WV.getContext() : {});   } catch (e) {    render({});   }  } })();</script>	1	LIBRARY_CODE-BBCBC5E6-8D2E-4FD9-B8D4-7C4416C16EC9	61		viz.debug.context.echo.html	0	/* ============================================================   L I B R A R Y   C O D E   Index: 62   Name:  wv.page.viz.pairwise.html   Purpose:     - Page shell for pairwise compare visualizations (left/right)     - Expands LIB[20] base HTML template     - Loads pairwise renderer (LIB[63])   Dependencies:     - LIB[20] Base HTML shell     - LIB[21] Base CSS     - LIB[22] WV runtime core     - LIB[23] Context manager     - LIB[24] Platform boot / HUD / safe render bridge     - LIB[63] Pairwise renderer   Exports:     - None (HTML template only)   Notes:     - Renderer populates #wv-root at runtime     - Placeholder card provides safe visual baseline before context arrives   History:     - 08 Feb 2026, 14hr??PT — Lon Cook — lon@deconstrukted.com : created for pairwise view   ============================================================ */‡‡LIB[20]‡‡<!-- PAGE_HEAD --><!-- (optional) <title>Pairwise Compare</title> --><!-- PAGE_BODY --><div class="wv-shell"> <div class="wv-card">  <div class="wv-title">Pairwise Compare</div>  <div class="wv-kv">Waiting for context…</div> </div></div><!-- PAGE_SCRIPTS --><script> ‡‡LIB[63]‡‡</script>	1	LIBRARY_CODE-739A1F56-56C3-4527-8377-825AB6B1B1E1	62		wv.page.viz.pairwise.html	0	/* ============================================================   L I B R A R Y   C O D E   Index: 63   Name:  wv.renderer.viz.pairwise.js   Purpose:     - Pairwise compare renderer for a single Web Viewer     - Displays rating, sigma, and n for the selected movie/genre     - Uses WV.registerRenderer(fn) so platform boot controls timing   Dependencies:     - LIB[22] WV runtime core     - LIB[23] Context manager     - LIB[24] Platform boot (registerRenderer / safeRender / HUD)     - LIB[21] Base CSS (pairwise styles)   History:     - 15 Feb 2026, 12hr??PT — Lon Cook — lon@deconstrukted.com : add per-movie impact arc + log-scaled n ring + fit n label   ============================================================ */(function () { if (!window.WV) return; function ensureRoot() {  var root = document.getElementById("wv-root");  if (root) return root;  root = document.createElement("div");  root.id = "wv-root";  document.body.appendChild(root);  return root; } function cssVar(name, fallback) {  try {   var root = document.getElementById("wv-root") || document.documentElement;   var v = getComputedStyle(root).getPropertyValue(name);   return (v && v.trim()) ? v.trim() : fallback;  } catch (e) {   return fallback;  } } function cssNum(name, fallback) {  var v = parseFloat(cssVar(name, ""));  return isFinite(v) ? v : fallback; } function fmtNum(n, digits) {  try {   if (n === null || n === undefined || n === "") return "—";   var x = Number(n);   if (!isFinite(x)) return String(n);   if (typeof digits === "number") return x.toFixed(digits);   return String(x);  } catch (e) {   return "—";  } } function clamp01(v) {  if (!isFinite(v)) return 0;  return Math.max(0, Math.min(1, v)); } function polar(cx, cy, r, deg) {  var a = (deg - 90) * Math.PI / 180;  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) }; } function arcPath(cx, cy, r, startDeg, endDeg) {  var s = polar(cx, cy, r, startDeg);  var e = polar(cx, cy, r, endDeg);  var large = (endDeg - startDeg) > 180 ? 1 : 0;  return [   "M", s.x, s.y,   "A", r, r, 0, large, 1, e.x, e.y  ].join(" "); } function render(ctx) {  var root = ensureRoot();  root.innerHTML = "";  if (!root.classList.contains("wv-theme-gold")) root.classList.add("wv-theme-gold");  root.style.background = "var(--wv-bg-main)";  root.style.width = "100%";  root.style.height = "100%";  root.style.padding = "0";  root.style.margin = "0";  var rect = root.getBoundingClientRect();  var VIEW_W = Math.max(120, Math.floor(rect.width || 184));  var VIEW_H = Math.max(90, Math.floor(rect.height || 130));  var defaults = (ctx && ctx.defaults) ? ctx.defaults : {};  var ui = (ctx && ctx.ui) ? ctx.ui : {};  var ratingVal = defaults.rating;  var sigmaVal = defaults.sigma;  var nVal = defaults.n;  var sigmaMin = 30;  var sigmaMax = 350;  try {   if (ui.sigma_min != null) sigmaMin = Number(ui.sigma_min);   if (ui.sigma_max != null) sigmaMax = Number(ui.sigma_max);  } catch (e) {}  if (!isFinite(sigmaMin)) sigmaMin = 30;  if (!isFinite(sigmaMax)) sigmaMax = 350;  if (sigmaMax <= sigmaMin) sigmaMax = sigmaMin + 1;  var sigmaNum = Number(sigmaVal);  if (!isFinite(sigmaNum)) sigmaNum = sigmaMin;  // Full ring = most certain (low sigma)  var sigmaNorm = Math.max(0, Math.min(1, 1 - ((sigmaNum - sigmaMin) / (sigmaMax - sigmaMin))));  var nMax = ui.n_max;  nMax = Number(nMax);  if (!isFinite(nMax) || nMax <= 0) nMax = 1; var nNum = Number(nVal); if (!isFinite(nNum)) nNum = 0; var nDen = Math.log(1 + Math.max(1, nMax)); var nNumLog = Math.log(1 + Math.max(0, nNum)); var nNorm = Math.max(0, Math.min(1, nNumLog / nDen));  // Percentile window for rating  var p5 = Number(ui.rating_p5);  var p95 = Number(ui.rating_p95);  if (!isFinite(p5)) p5 = ratingVal;  if (!isFinite(p95)) p95 = ratingVal;  if (!isFinite(p5) || !isFinite(p95) || p95 <= p5) {   p5 = ratingVal - 1;   p95 = ratingVal + 1;  }  var ratingNum = Number(ratingVal);  if (!isFinite(ratingNum)) ratingNum = p5;  var ratingNorm = Math.max(0, Math.min(1, (ratingNum - p5) / (p95 - p5)));  // Per-movie impact (InfoGain split)  var impactNorm = 0;  try {   if (ui.impact != null) impactNorm = Number(ui.impact);  } catch (e) {}  impactNorm = clamp01(impactNorm);  // Geometry: centered, padded  var pad = 6;  var cy = Math.round(VIEW_H / 2);  var baseGap = Math.max(6, Math.floor(VIEW_H * 0.08));  var arcGap = baseGap * 2;  var maxR = Math.min((VIEW_H / 2) - pad, (VIEW_W / 2) - pad);  var rOuter = Math.max(18, Math.floor(maxR - arcGap));  var rInner = Math.max(14, rOuter - 10);  var availableW = Math.max(40, VIEW_W - (pad * 2));  var arcR = Math.min(rOuter + arcGap, Math.max(6, availableW - rOuter));  var cx = Math.round(pad + (availableW - (arcR + rOuter)) / 2 + rOuter);  var arcStart = 60;  var arcEnd = 125; // +5 degrees  var circOuter = 2 * Math.PI * rOuter;  var dashOuter = circOuter * sigmaNorm;  var gapOuter = circOuter - dashOuter;  var circInner = 2 * Math.PI * rInner;  var dashInner = circInner * nNorm;  var gapInner = circInner - dashInner;  // Inverted mapping so dot follows scale labels  var dotAngle = arcEnd - (arcEnd - arcStart) * clamp01(ratingNorm);  var dotPos = polar(cx, cy, arcR, dotAngle); // Impact arc (centered within arc span) var arcSpan = (arcEnd - arcStart) * impactNorm; var arcMid = (arcStart + arcEnd) / 2; var impactStart = arcMid - (arcSpan / 2); var impactEnd = arcMid + (arcSpan / 2);  // Dot label  var tickInDot = polar(cx, cy, arcR + 2, dotAngle);  var tickOutDot = polar(cx, cy, arcR + 7, dotAngle);  var labelDot = polar(cx, cy, arcR + 13, dotAngle);  var pct = Math.round(5 + (ratingNorm * 90));  var dotLabelColor = "var(--wv-tone-7)";  var svg =   '<svg viewBox="0 0 ' + VIEW_W + ' ' + VIEW_H + '" width="100%" height="100%" aria-hidden="true">' +    // sigma ring (outer)    '<circle cx="' + cx + '" cy="' + cy + '" r="' + rOuter + '" fill="none" stroke-width="6" ' +     'stroke="var(--wv-surface-3)" data-group="rings" pointer-events="stroke"></circle>' +    '<circle cx="' + cx + '" cy="' + cy + '" r="' + rOuter + '" fill="none" stroke-width="6" ' +     'stroke="var(--wv-accent-2)" stroke-opacity="0.55" stroke-dasharray="' + dashOuter + ' ' + gapOuter + '" stroke-linecap="round" ' +     'transform="rotate(-90 ' + cx + ' ' + cy + ')" data-group="rings" pointer-events="stroke"></circle>' +    // n ring (inner)    '<circle cx="' + cx + '" cy="' + cy + '" r="' + rInner + '" fill="none" stroke-width="6" ' +     'stroke="var(--wv-surface-3)" data-group="rings" pointer-events="stroke"></circle>' +    '<circle cx="' + cx + '" cy="' + cy + '" r="' + rInner + '" fill="none" stroke-width="6" ' +     'stroke="var(--wv-accent-1)" stroke-opacity="0.55" stroke-dasharray="' + dashInner + ' ' + gapInner + '" stroke-linecap="round" ' +     'transform="rotate(-90 ' + cx + ' ' + cy + ')" data-group="rings" pointer-events="stroke"></circle>' +    // percentile arc (track)    '<path d="' + arcPath(cx, cy, arcR, arcStart, arcEnd) + '" ' +     'fill="none" stroke="var(--wv-surface-3)" stroke-width="7" stroke-linecap="round" opacity="0.85" data-group="arc" pointer-events="stroke"></path>' +    // impact arc (filled)    '<path d="' + arcPath(cx, cy, arcR, impactStart, impactEnd) + '" ' +     'fill="none" stroke="var(--wv-tone-7)" stroke-width="7" stroke-linecap="round" opacity="0.55" data-group="arc" pointer-events="stroke"></path>' +    // arc dot    '<circle cx="' + dotPos.x + '" cy="' + dotPos.y + '" r="4" fill="var(--wv-accent-1)" data-group="arc" pointer-events="fill"></circle>' +    // dot tick + label (darker gold, rotated 90° CCW)    '<line x1="' + tickInDot.x + '" y1="' + tickInDot.y + '" x2="' + tickOutDot.x + '" y2="' + tickOutDot.y + '" ' +     'stroke="' + dotLabelColor + '" stroke-width="1"></line>' +    '<text x="' + labelDot.x + '" y="' + labelDot.y + '" text-anchor="start" dominant-baseline="middle" ' +     'font-size="8" font-weight="400" fill="' + dotLabelColor + '" ' +     'transform="rotate(' + (dotAngle - 90) + ' ' + labelDot.x + ' ' + labelDot.y + ')">' + pct + '</text>' +    // center labels (sigma value centered)    '<text x="' + cx + '" y="' + (cy - 10) + '" text-anchor="middle" font-size="16" fill="var(--wv-accent-2)" font-weight="600">σ</text>' +    '<text x="' + cx + '" y="' + cy + '" text-anchor="middle" dominant-baseline="middle" ' +     'style="font-size: calc(var(--wv-font-metric) * 1px);" fill="var(--wv-text-1)" font-weight="600">' +     fmtNum(sigmaVal, 2) + '</text>' +   '<text id="wv-n-text" x="' + cx + '" y="' + (cy + 14) + '" text-anchor="middle" font-size="9" fill="var(--wv-accent-1)" font-weight="600">n=' + fmtNum(nVal) + '</text>' +   '</svg>'; root.innerHTML = svg;  // Fit n-text inside inner ring  try {   var nText = root.querySelector("#wv-n-text");   if (nText) {    var maxW = Math.max(10, (rInner * 2) - 8);    var len = nText.getComputedTextLength();    if (len > maxW) {     var size = Math.max(7, Math.floor(9 * (maxW / len)));     nText.setAttribute("font-size", size);    }   }  } catch (e) {}  // Hover labels (progress-viz style)  try {   var svgEl = root.querySelector("svg");   if (svgEl) {    var labelColor = "var(--wv-hover-label)";    var labelX = Math.min(VIEW_W - 6, Math.round(cx + arcR + 8));    var endPad = cssNum("--wv-label-gap", 4);    var hLen = 16;    function drawLabelGroup(id, anchor, leadY, text1, text2, xOverride, side, connect) {     var lx = (xOverride != null) ? xOverride : labelX;     var isLeft = (side === "left");     var g = document.createElementNS("http://www.w3.org/2000/svg", "g");     g.setAttribute("data-label-group", id);     g.style.opacity = "0";     g.style.transition = "opacity 120ms linear";     g.style.pointerEvents = "none";     var t1 = document.createElementNS("http://www.w3.org/2000/svg", "text");     t1.setAttribute("x", lx);     t1.setAttribute("y", text2 ? (leadY - 2) : (leadY + 3));     t1.setAttribute("fill", labelColor);     t1.setAttribute("font-size", 9);     t1.setAttribute("text-anchor", isLeft ? "start" : "end");     t1.textContent = text1;     g.appendChild(t1);     if (text2) {      var t2 = document.createElementNS("http://www.w3.org/2000/svg", "text");      t2.setAttribute("x", lx);      t2.setAttribute("y", leadY + 9);      t2.setAttribute("fill", labelColor);      t2.setAttribute("font-size", 9);      t2.setAttribute("text-anchor", isLeft ? "start" : "end");      t2.textContent = text2;      g.appendChild(t2);     }     // Append now so getBBox returns real widths     svgEl.appendChild(g);     var textW = 0;     try {      var b1 = t1.getBBox();      textW = b1 ? b1.width : 0;      if (text2) {       var b2 = g.lastChild && g.lastChild.getBBox ? g.lastChild.getBBox() : null;       if (b2 && b2.width > textW) textW = b2.width;      }     } catch (e) {}     var connectOnRight = (connect === "right");     var endX;     var midX;     if (connectOnRight) {      endX = isLeft ? (lx + textW + endPad) : (lx + endPad);      midX = endX + hLen;     } else {      endX = isLeft ? (lx - endPad) : (lx - textW - endPad);      midX = endX - hLen;     }     var line = document.createElementNS("http://www.w3.org/2000/svg", "path");     line.setAttribute("d", "M " + anchor.x + " " + anchor.y + " L " + midX + " " + leadY + " L " + endX + " " + leadY);     line.setAttribute("stroke", labelColor);     line.setAttribute("stroke-width", 0.9);     line.setAttribute("fill", "none");     g.insertBefore(line, g.firstChild);     var dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");     dot.setAttribute("cx", anchor.x);     dot.setAttribute("cy", anchor.y);     dot.setAttribute("r", 2);     dot.setAttribute("fill", labelColor);     g.insertBefore(dot, g.firstChild);    }    // Ring labels (show together on ring hover)    var arcP1 = polar(cx, cy, arcR, arcStart);    var arcP2 = polar(cx, cy, arcR, arcEnd);    var arcTop = Math.min(arcP1.y, arcP2.y);    var arcBot = Math.max(arcP1.y, arcP2.y);    var arcLabelTopY = Math.max(10, (cy - rOuter - 18));    var arcLabelBotY = Math.min(VIEW_H - 10, (cy + rOuter + 18));    var arcLabelX = 6;    var ringLabelX = Math.max(6, VIEW_W - 6);    var confAnchor = polar(cx, cy, rOuter, 20);    var confY = Math.max(10, arcTop - 10);    var sampAnchor = polar(cx, cy, rInner, 150);    var sampY = Math.min(VIEW_H - 10, arcBot + 10);    drawLabelGroup("rings", confAnchor, confY, "Confidence", "", ringLabelX, "right", "left");    drawLabelGroup("rings", sampAnchor, sampY, "Sample Size", "", ringLabelX, "right", "left");    // Arc labels (show together on arc hover)    var volAnchor = polar(cx, cy, arcR, arcStart);    drawLabelGroup("arc", volAnchor, arcLabelTopY, "Rank Volatility", "", arcLabelX, "left", "right");    drawLabelGroup("arc", dotPos, arcLabelBotY, "Rank Percentile: " + pct + "%", "", arcLabelX, "left", "right");    function setLabelVisibility(groupId) {     var labels = svgEl.querySelectorAll("[data-label-group]");     for (var i = 0; i < labels.length; i++) {      var g = labels[i];      var on = (g.getAttribute("data-label-group") === groupId);      g.style.opacity = on ? "1" : "0";     }    }    svgEl.addEventListener("mousemove", function (e) {     var el = e.target;     var g = "";     while (el && el !== svgEl) {      if (el.getAttribute && el.getAttribute("data-group")) {       g = el.getAttribute("data-group");       break;      }      el = el.parentNode;     }     setLabelVisibility(g || "");    });    svgEl.addEventListener("mouseleave", function () {     setLabelVisibility("");    });   }  } catch (e) {} } WV.registerRenderer(function (ctx) {  try { render(ctx || {}); } catch (e) {} });})();	1	LIBRARY_CODE-D0A18546-E8E9-4666-A42D-5BFD7FA5E9DE	63		wv.renderer.viz.pairwise.js	0	/* ============================================================   L I B R A R Y   C O D E   Index: 64   Name:  wv.page.viz.progress.html   Purpose:     - Page shell for pairwise progress dashboard (genre + overall)     - Expands LIB[20] base HTML template     - Loads progress renderer (LIB[65])   Dependencies:     - LIB[20] Base HTML shell     - LIB[21] Base CSS     - LIB[22] WV runtime core     - LIB[23] Context manager     - LIB[24] Platform boot / HUD / safe render bridge     - LIB[65] Progress renderer   Exports:     - None (HTML template only)   ============================================================ */‡‡LIB[20]‡‡<!-- PAGE_HEAD --><!-- (optional) <title>Pairwise Progress</title> --><!-- PAGE_BODY --><div id="wv-root"></div><!-- PAGE_SCRIPTS --><script> ‡‡LIB[65]‡‡</script>	1	LIBRARY_CODE-8955830F-B418-4815-ACC3-733EB9CF0E50	64		wv.page.viz.progress.html	0	/* ============================================================   L I B R A R Y   C O D E   Index: 65   Name:  wv.renderer.viz.progress.js   Purpose:     - Progress visualization for pairwise ranking (genre + overall)     - Nested rings for distribution + confidence     - Semi-transparent completion pie slices (genre + overall)   Dependencies:     - LIB[22] WV runtime core     - LIB[23] Context manager     - LIB[24] Platform boot     - LIB[21] Base CSS   ============================================================ */(function () { function initProgressRenderer() { if (!window.WV) return false; WV._state = WV._state || {}; if (WV._state._vizProgressRegistered) return true; WV._state._vizProgressRegistered = true; WV._state._vizProgressLast = WV._state._vizProgressLast || ""; function ensureRoot() {  var root = document.getElementById("wv-root");  if (root) return root;  root = document.createElement("div");  root.id = "wv-root";  document.body.appendChild(root);  return root; } function cssVar(name, fallback) {  try {   var root = document.getElementById("wv-root") || document.documentElement;   var v = getComputedStyle(root).getPropertyValue(name);   return (v && v.trim()) ? v.trim() : fallback;  } catch (e) {   return fallback;  } } function cssNum(name, fallback) {  var v = parseFloat(cssVar(name, ""));  return isFinite(v) ? v : fallback; } function clamp01(v) {  if (!isFinite(v)) return 0;  return Math.max(0, Math.min(1, v)); } function escapeHtml(s) {  return String(s == null ? "" : s)   .replace(/&/g, "&amp;")   .replace(/</g, "&lt;")   .replace(/>/g, "&gt;"); } function p10FormatAnnotMathText(s) {  var html = escapeHtml(s);  html = html.replace(/g_rd_b/g, '<span class="annot-math-neutral">g_rd_b</span>');  html = html.replace(/σ_pooled/g, '<span class="annot-math-sigma">σ</span><span class="annot-math-neutral">_pooled</span>');  html = html.replace(/Δr/g, '<span class="annot-math-deltar">Δr</span>');  html = html.replace(/ΔI/g, '<span class="annot-math-deltai">ΔI</span>');  html = html.replace(/Δy/g, '<span class="annot-math-deltay">Δy</span>');  html = html.replace(/Δh/g, '<span class="annot-math-deltah">Δh</span>');  html = html.replace(/Ŝ/g, '<span class="annot-math-shat">Ŝ</span>');  html = html.replace(/\|Δ\|/g, '|<span class="annot-math-delta">Δ</span>|');  html = html.replace(/\bRD\b/g, '<span class="annot-math-neutral">RD</span>');  html = html.replace(/σ/g, '<span class="annot-math-sigma">σ</span>');  return html; } function ensureP10AnnotPopover(root) {  if (!root) return null;  var existing = root.querySelector(".wv-p10-popover");  if (existing) {   // Upgrade guard: rebuild stale popover markup that predates separation/S-hat guides.   var hasSepGuides = !!existing.querySelector('[data-annot-guide="sep-mag-left"]');   var hasShatGuides = !!existing.querySelector('[data-annot-guide="shat-top-guide"]');   if (hasSepGuides && hasShatGuides) return existing;   try { existing.remove(); } catch (_e) {}   var staleBackdrop = root.querySelector(".wv-p10-popover-backdrop");   if (staleBackdrop) {    try { staleBackdrop.remove(); } catch (_e2) {}   }  }  var backdrop = document.createElement("div");  backdrop.className = "wv-p10-popover-backdrop";  var overlay = document.createElement("div");  overlay.className = "wv-p10-popover";  var card = document.createElement("div");  card.className = "wv-p10-pop-card wv-theme-fuchsia p8t-css annot-p10-card";  card.setAttribute("data-open", "0");  card.setAttribute("aria-hidden", "true");  card.innerHTML =   '<div>' +    '<div class="wv-p10-pop-title gain-label" data-annot-header-title>Support Bar</div>' +    '<div class="wv-p10-pop-sub legend" data-annot-header-line1></div>' +    '<div class="wv-p10-pop-sub legend" data-annot-header-line2></div>' +    '<div class="wv-p10-pop-sub legend" data-annot-header-line3></div>' +    '<div class="annot-p10-meta" data-annot-meta></div>' +   '</div>' +   '<div class="annot-p10-wrap">' +    '<div class="annot-p10-label segB" data-annot-key="segB"></div><div class="annot-p10-desc" data-annot-desc-key="segB"></div>' +    '<div class="annot-p10-label block" data-annot-key="block"></div><div class="annot-p10-desc" data-annot-desc-key="block"></div>' +    '<div class="annot-p10-label inter" data-annot-key="inter"></div><div class="annot-p10-desc" data-annot-desc-key="inter"></div>' +    '<div class="annot-p10-label segA" data-annot-key="segA"></div><div class="annot-p10-desc" data-annot-desc-key="segA"></div>' +    '<svg class="annot-p10-leader segB" data-annot-leader="segB" preserveAspectRatio="none"><circle class="annot-p10-dot" r="3"></circle><path class="annot-p10-line"></path></svg>' +    '<svg class="annot-p10-leader block" data-annot-leader="block" preserveAspectRatio="none"><circle class="annot-p10-dot" r="3"></circle><path class="annot-p10-line"></path></svg>' +    '<svg class="annot-p10-leader inter" data-annot-leader="inter" preserveAspectRatio="none"><circle class="annot-p10-dot" r="3"></circle><path class="annot-p10-line"></path></svg>' +    '<svg class="annot-p10-leader segA" data-annot-leader="segA" preserveAspectRatio="none"><circle class="annot-p10-dot" r="3"></circle><path class="annot-p10-line"></path></svg>' +    '<svg class="annot-p10-measure" preserveAspectRatio="none">' +     '<defs><marker id="wv-annot-dim-arrow" markerWidth="5" markerHeight="5" refX="4.5" refY="2.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M 0 0 L 5 2.5 L 0 5 z" class="dim-arrow"></path></marker><marker id="wv-annot-sep-arrow" markerWidth="5" markerHeight="5" refX="4.5" refY="2.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M 0 0 L 5 2.5 L 0 5 z" class="sep-arrow"></path></marker></defs>' +     '<path class="sep-link" data-annot-guide="sep-link"></path>' +     '<circle class="sep-link-dot" data-annot-guide="sep-link-dot-left" r="3"></circle>' +     '<circle class="sep-link-dot" data-annot-guide="sep-link-dot-right" r="3"></circle>' +     '<line class="sep-mag sep-left" data-annot-guide="sep-mag-left"></line>' +     '<line class="sep-mag sep-right" data-annot-guide="sep-mag-right"></line>' +     '<line class="sep-base sep-left" data-annot-guide="sep-base-left"></line>' +     '<line class="sep-base sep-right" data-annot-guide="sep-base-right"></line>' +     '<line class="sep-cap sep-left" data-annot-guide="sep-cap-left"></line>' +     '<line class="sep-cap sep-right" data-annot-guide="sep-cap-right"></line>' +     '<text class="sep-symbol sep-left" data-annot-guide="sep-symbol-left">Δy₁</text>' +     '<text class="sep-symbol sep-right" data-annot-guide="sep-symbol-right">Δy₂</text>' +     '<line class="guide" data-annot-guide="overlap"></line><line class="guide" data-annot-guide="tick"></line>' +     '<line class="dim" data-annot-guide="dim-top"></line><line class="dim" data-annot-guide="dim-bottom" marker-end="url(#wv-annot-dim-arrow)"></line>' +     '<text class="dim-symbol" data-annot-guide="dim-symbol">Δy</text>' +     '<line class="guide shat-guide" data-annot-guide="shat-top-guide"></line>' +     '<line class="guide shat-guide" data-annot-guide="shat-block-guide"></line>' +     '<line class="shat-dim" data-annot-guide="shat-dim-top"></line>' +     '<line class="shat-dim" data-annot-guide="shat-dim-bottom" marker-end="url(#wv-annot-sep-arrow)"></line>' +     '<text class="shat-symbol" data-annot-guide="shat-symbol">Ŝ</text>' +    '</svg>' +    '<div class="annot-p10-bar support" data-annot-bar="support">' +     '<div class="annot-p10-left" data-annot-target="segA"></div>' +     '<div class="annot-p10-right" data-annot-target="segB"></div>' +     '<div class="annot-p10-overlap support" data-annot-target="block"></div>' +    '</div>' +    '<div class="annot-p10-ig"><div class="annot-p10-ig-track"><div class="annot-p10-ig-fill" data-annot-ig-fill></div><div class="annot-p10-ig-tick signal" data-annot-ig-tick="signal"></div><div class="annot-p10-ig-tick support" data-annot-ig-tick="support"></div><div class="annot-p10-ref-left" data-annot-ref="left"></div><div class="annot-p10-ref-right" data-annot-ref="right"></div><div class="annot-p10-ref-overlap" data-annot-ref="block"></div></div></div>' +    '<div class="annot-p10-bar-label focus" data-annot-focus-label></div>' +    '<div class="annot-p10-bar-label ig">ΔI</div>' +   '</div>';  var closeBtn = document.createElement("button");  closeBtn.className = "wv-p10-pop-close";  closeBtn.type = "button";  closeBtn.textContent = "×";  card.appendChild(closeBtn);  overlay.appendChild(card);  root.appendChild(backdrop);  root.appendChild(overlay);  function closePopover() {   card.setAttribute("data-open", "0");   card.setAttribute("aria-hidden", "true");   root.classList.remove("wv-p10-popover-open");  }  closeBtn.addEventListener("click", closePopover);  overlay._card = card;  overlay._wrap = card.querySelector(".annot-p10-wrap");  return overlay; } function setP10PopoverOpen(root, overlay, open) {  if (!root || !overlay || !overlay._card) return;  overlay._card.setAttribute("data-open", open ? "1" : "0");  overlay._card.setAttribute("aria-hidden", open ? "false" : "true");  root.classList.toggle("wv-p10-popover-open", !!open); } function formatPct01(v) {  return Math.round(clamp01(v) * 100) + "%"; } function p10SignedPct(v) {  if (!isFinite(v)) return "0%";  var pct = Math.round(Math.abs(v) * 100);  if (pct === 0) return "0%";  return (v > 0 ? "+" : "−") + pct + "%"; } function setElStyleFromComputed(dst, src) {  if (!dst || !src) return;  var cs = getComputedStyle(src);  dst.style.background = cs.background;  dst.style.boxShadow = cs.boxShadow;  dst.style.border = cs.border;  dst.style.borderColor = cs.borderColor;  dst.style.borderWidth = cs.borderWidth;  dst.style.borderStyle = cs.borderStyle;  dst.style.borderRadius = cs.borderRadius;  dst.style.opacity = cs.opacity; } function p10SetDescHtml(el, text) {  if (!el) return;  var parts = String(text || "").split("\n");  var lead = parts.shift() || "";  var bodyLines = [];  var calloutLines = [];  var inCallout = false;  for (var i = 0; i < parts.length; i++) {   var line = parts[i];   if (!inCallout && line === "") {    inCallout = true;    continue;   }   if (inCallout) calloutLines.push(line);   else bodyLines.push(line);  }  var body = bodyLines.join("\n").trim();  var callout = calloutLines.join("\n").trim();  el.innerHTML =   '<span class="desc-lead">' + p10FormatAnnotMathText(lead) + "</span>" +   (body ? '<span class="desc-body">' + p10FormatAnnotMathText(body).replace(/\n/g, "<br>") + "</span>" : "") +   (callout ? '<span class="desc-body">' + p10FormatAnnotMathText(callout).replace(/\n/g, "<br>") + "</span>" : ""); } function p10WrapMetricLabelHtml(name, valueHtml) {  return '<span class="annot-p10-label-content"><span class="annot-p10-label-text">' + name + ':</span> <span class="annot-p10-value">' + valueHtml + '</span></span>'; } function p10WrapPlainLabelHtml(text) {  return '<span class="annot-p10-label-content"><span class="annot-p10-label-text">' + text + '</span></span>'; } function p10MetricNamesByType(type) {  if (type === "separation") return {   a: "Δr strength", b: "σ tightness", block: "Separation overlap",   descA: "Displayed standardized separation magnitude.\nHigher values indicate stronger |Δr| relative to pooled uncertainty.",   descB: "Normalized uncertainty tightness.\nHigher values mean less uncertainty around the pair.",   descBlock: "Result envelope for separation output.\nPosition represents where Δr and σ agree most, measured as Ŝ from bar top. Higher values mean greater certainty in that position.\n\nΔy tracks center offset versus the Signal separation segment, and Δh tracks envelope-height mismatch.",   descInter: "Where the two separation ingredients overlap after centering.\nMore overlap means stronger structural agreement."  };  if (type === "support") return {   a: "Evidence", b: "Span", block: "Support overlap",   descA: "Normalized evidence depth (n-derived).\nHigher values indicate broader comparison support for ΔI placement.",   descB: "Normalized uncertainty span (P95-P5 or min-max).\nHigher values indicate a wider plausible rating range.",   descBlock: "Confidence envelope for the estimate.\nΔy is the vertical offset from the support ΔI tick; larger |Δy| indicates greater disagreement with the ΔI-implied position, while block height indicates confidence in that disagreement (longer = stronger support).",   descInter: "Geometric overlap of the two metric segments after centering.\nThis is the structural agreement reference, independent of Δy and the ΔI tick."  };  return {   a: "Separation", b: "Stability", block: "Signal overlap",   descA: "Normalized |Δ| / σ_pooled magnitude.\nHigher values indicate stronger standardized separation.",   descB: "Normalized stability / reliability factor (g_rd_b).\nHigher values mean the signal is less sensitive to uncertainty in the estimated ratings (RD), so the inferred difference is more trustworthy.\n\nUses opponent RD (not σ volatility).",   descBlock: "Confidence envelope for the estimate.\nΔy is the vertical offset from the signal ΔI tick; larger |Δy| indicates greater disagreement with the ΔI-implied position, while block height indicates confidence in that disagreement (longer = stronger support).",   descInter: "Geometric overlap of the two metric segments after centering.\nThis is the structural agreement reference, independent of Δy and the ΔI tick."  }; } function p10ParseColor(c) {  if (!c) return null;  var m = c.match(/rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)\s*(?:,\s*([\d.]+)\s*)?\)/i);  if (!m) return null;  return { r:+m[1], g:+m[2], b:+m[3], a:(m[4]==null?1:+m[4]) }; } function p10BlendColors(c1, c2, a) {  var x = p10ParseColor(c1), y = p10ParseColor(c2);  if (!x && !y) return "rgba(207,161,0,0.9)";  if (!x) x = y; if (!y) y = x;  return "rgba(" + Math.round((x.r+y.r)/2) + "," + Math.round((x.g+y.g)/2) + "," + Math.round((x.b+y.b)/2) + "," + (a==null?Math.max(x.a,y.a):a) + ")"; } function p10GetStrokeOrColor(el, fallback) {  if (!el) return fallback;  var cs = getComputedStyle(el);  var m = (cs.boxShadow || "").match(/rgba?\([^)]+\)/);  if (m && m[0]) return m[0];  return (cs.borderColor && cs.borderColor !== "rgba(0, 0, 0, 0)") ? cs.borderColor : (cs.color || fallback); } function p10GetBorderColor(el, fallback) {  if (!el) return fallback;  var c = getComputedStyle(el).borderColor;  return (c && c !== "rgba(0, 0, 0, 0)" && c !== "transparent") ? c : fallback; } function p10GetContentRightPx(el, wrapRect) { var b = el.getBoundingClientRect(); return b.right - wrapRect.left; } function p10GetLabelTextRightPx(label, wrapRect) {  var val = label.querySelector(".annot-p10-value");  var txt = label.querySelector(".annot-p10-label-text");  var target = val || txt || label;  return p10GetContentRightPx(target, wrapRect); } function p10GetLabelLeaderY(label, wrapRect) {  var topStyle = parseFloat(label.style.top);  var rowEl = label.querySelector(".annot-p10-label-content") || label;  var cs = getComputedStyle(rowEl);  var fs = parseFloat(cs.fontSize) || 10;  var lh = parseFloat(cs.lineHeight);  if (!isFinite(lh)) lh = fs * 1.2;  var baseTop = isFinite(topStyle) ? topStyle : ((label.getBoundingClientRect().top - wrapRect.top) || 0);  // Deterministic row-center anchor used by all popovers.  return baseTop + (lh * 0.5); } function syncP10AnnotatedPopover(root, overlay) {  if (!overlay || !overlay._card) return;  var card = overlay._card;  var wrap = card.querySelector(".annot-p10-wrap");  if (!wrap) return;  var wrapRect = wrap.getBoundingClientRect();  var cardRect = card.getBoundingClientRect();  var compact = cardRect.width <= 380;  card.classList.toggle("compact", compact);  // Layout frame dimensions.  var barEl = wrap.querySelector(".annot-p10-bar");  var igEl = wrap.querySelector(".annot-p10-ig");  var focusLabel = wrap.querySelector(".annot-p10-bar-label.focus");  var igLabel = wrap.querySelector(".annot-p10-bar-label.ig");  var barW = compact ? 34 : 52;  var barH = compact ? 170 : 240;  var igRight = compact ? 6 : 24;  var barTop = compact ? 18 : 16;  var barGap = barW;  var focusRight = igRight + barW + barGap;  barEl.style.right = focusRight + "px"; barEl.style.top = barTop + "px"; barEl.style.width = barW + "px"; barEl.style.height = barH + "px";  igEl.style.right = igRight + "px"; igEl.style.top = barTop + "px"; igEl.style.width = barW + "px"; igEl.style.height = barH + "px";  focusLabel.style.right = focusRight + "px"; focusLabel.style.top = (barTop + barH + 6) + "px"; focusLabel.style.width = barW + "px";  igLabel.style.right = igRight + "px"; igLabel.style.top = (barTop + barH + 6) + "px"; igLabel.style.width = barW + "px";  var svgs = wrap.querySelectorAll(".annot-p10-leader, .annot-p10-measure");  for (var s = 0; s < svgs.length; s++) svgs[s].setAttribute("viewBox", "0 0 " + Math.round(wrap.clientWidth) + " " + Math.round(wrap.clientHeight));  // Semantics + colors.  var annotType = barEl.getAttribute("data-annot-bar");  var type = (annotType === "support" || annotType === "separation") ? annotType : "signal";  if (focusLabel) focusLabel.textContent = (type === "support") ? "E↔Δ" : (type === "separation" ? "Δr↔σ" : "S↔σ");  if (igLabel) igLabel.textContent = (type === "separation") ? "S↔σ" : "ΔI";  if (focusLabel) {   focusLabel.style.color = (type === "support")    ? cssVar("--p8t-gold", "rgba(207,161,0,0.95)")    : (type === "separation"     ? "rgba(176,124,255,0.95)"     : cssVar("--p8t-cyan-stroke", "rgba(79,213,255,0.9)"));  }  if (igLabel) {   igLabel.style.color = (type === "separation")    ? cssVar("--p8t-cyan-stroke", "rgba(79,213,255,0.9)")    : cssVar("--p8t-ig-label", "rgba(255,63,150,0.9)");  }  var names = p10MetricNamesByType(type);  var parts = {   bar: barEl,   segA: barEl.querySelector('[data-annot-target="segA"]'),   segB: barEl.querySelector('[data-annot-target="segB"]'),   block: barEl.querySelector('[data-annot-target="block"]')  };  var a = parts.segA.getBoundingClientRect().height / Math.max(1, barEl.getBoundingClientRect().height);  var b = parts.segB.getBoundingClientRect().height / Math.max(1, barEl.getBoundingClientRect().height);  var bh = parts.block.getBoundingClientRect().height / Math.max(1, barEl.getBoundingClientRect().height);  var aText = formatPct01(a);  if (overlay && overlay._payload) {   var pData = overlay._payload[type];   if (pData) {    // Keep popup label coherent with rendered geometry.    // Separation popup uses display value; others keep raw.    if (type === "separation" && isFinite(pData.a_display)) {     aText = Math.round(clamp01(pData.a_display) * 100) + "%";    } else if (isFinite(pData.a_raw)) {     aText = Math.round(clamp01(pData.a_raw) * 100) + "%";    }   }  }  card.querySelector('[data-annot-key="segA"]').innerHTML = p10WrapMetricLabelHtml(names.a, aText);  card.querySelector('[data-annot-key="segB"]').innerHTML = p10WrapMetricLabelHtml(names.b, formatPct01(b));  card.querySelector('[data-annot-key="block"]').innerHTML = p10WrapMetricLabelHtml(names.block + " (confidence)", formatPct01(bh));  card.querySelector('[data-annot-key="inter"]').innerHTML = p10WrapPlainLabelHtml("True intersection (centered)");  p10SetDescHtml(card.querySelector('[data-annot-desc-key="segA"]'), names.descA);  p10SetDescHtml(card.querySelector('[data-annot-desc-key="segB"]'), names.descB);  p10SetDescHtml(card.querySelector('[data-annot-desc-key="block"]'), names.descBlock);  p10SetDescHtml(card.querySelector('[data-annot-desc-key="inter"]'), names.descInter);  card.querySelector('[data-annot-header-title]').textContent = (type === "support") ? "Support Bar" : (type === "separation" ? "Separation Bar" : "Signal Bar");  card.querySelector('[data-annot-header-line1]').innerHTML = p10FormatAnnotMathText((type === "support")   ? "Support model as paired metric segments (Evidence, Span). Helps distinguish structural agreement (segment intersection) from inferred IG disagreement (Δy) and confidence strength."   : (type === "separation"    ? "Separation model as paired metric segments (Δr strength, σ tightness). This bar decomposes separation and compares decomposition output against Signal placement via residuals (Δy, Δh)."    : "Signal model as paired metric segments (Separation, Stability). Helps distinguish structural agreement (segment intersection) from inferred IG disagreement (Δy) and confidence strength."));  card.querySelector('[data-annot-header-line2]').innerHTML = (type === "support")   ? '<span class="annot-head-key">Answers:</span> \"How much data/coverage do we have behind that difference?\"'   : (type === "separation"    ? '<span class="annot-head-key">Answers:</span> \"How strong is separation, and does it align with the signal separation position?\"'    : '<span class="annot-head-key">Answers:</span> \"Is there a real difference here, relative to noise?\"');  card.querySelector('[data-annot-header-line3]').innerHTML = (type === "separation")   ? ""   : '<span class="annot-head-key">Signal + Support:</span> \"Is this matchup a meaningful and trustworthy update (i.e., useful info gain), not just a noisy result?\"';  var metaEl = card.querySelector('[data-annot-meta]');  if (metaEl) {   if (type === "separation" && overlay && overlay._payload && overlay._payload.separation) {    var md = overlay._payload.separation;    metaEl.innerHTML = p10FormatAnnotMathText("Δy = " + p10SignedPct(md.dy) + "  ·  Δh = " + p10SignedPct(md.dh));   } else {    metaEl.innerHTML = "";   }  }  // Header/meta can change grid row height; refresh wrap/card rects before computing anchors.  wrapRect = wrap.getBoundingClientRect();  cardRect = card.getBoundingClientRect();  var cA = p10GetStrokeOrColor(parts.segA, "rgba(207,161,0,0.9)");  var cB = p10GetStrokeOrColor(parts.segB, "rgba(207,161,0,0.9)");  var cBlock = p10GetBorderColor(parts.block, p10GetStrokeOrColor(parts.block, "rgba(207,161,0,0.9)"));  var cInter = p10BlendColors(cA, cB, 0.92);  ["segA","segB","block","inter"].forEach(function (key) {   var svg = card.querySelector('[data-annot-leader="' + key + '"]');   if (!svg) return;   var path = svg.querySelector(".annot-p10-line");   var dot = svg.querySelector(".annot-p10-dot");   var stroke = (key === "segA") ? cA : (key === "segB") ? cB : (key === "block" ? cBlock : cInter);   if (path) path.style.stroke = stroke;   if (dot) dot.style.fill = stroke;  });  // Leader anchors + paths (compute anchors first so label rows can be ordered to avoid crossings)  var anchors = {};  function clampIntervalToBar(top, bottom, barTop, barBottom) {   var t = Math.max(top, barTop);   var b = Math.min(bottom, barBottom);   return (b > t) ? { top: t, bottom: b } : null;  }  function subtractInterval(spans, cutTop, cutBottom) {   var out = [];   for (var si = 0; si < spans.length; si++) {    var s = spans[si];    if (cutBottom <= s.top || cutTop >= s.bottom) {     out.push(s);     continue;    }    if (cutTop > s.top) out.push({ top: s.top, bottom: Math.min(cutTop, s.bottom) });    if (cutBottom < s.bottom) out.push({ top: Math.max(cutBottom, s.top), bottom: s.bottom });   }   return out;  }  function midpointOfLargestSpan(spans, fallbackY) {   if (!spans || !spans.length) return fallbackY;   var best = spans[0];   for (var iSpan = 1; iSpan < spans.length; iSpan++) {    if ((spans[iSpan].bottom - spans[iSpan].top) > (best.bottom - best.top)) best = spans[iSpan];   }   return best.top + ((best.bottom - best.top) / 2);  }  function computeAnchor(key) {   var target = card.querySelector('[data-annot-target="' + key + '"]');   var x=0, y=0;   if (key === "inter" || key === "block") {    var br = barEl.getBoundingClientRect();    x = (br.left - wrapRect.left) + (br.width / 2);    if (key === "inter") y = (br.top - wrapRect.top) + (br.height / 2);    else {     var tr = target.getBoundingClientRect();     var visBlock = clampIntervalToBar(tr.top, tr.bottom, br.top, br.bottom);     if (visBlock) y = ((visBlock.top + visBlock.bottom) / 2) - wrapRect.top;     else y = (tr.top - wrapRect.top) + (tr.height / 2);    }   } else {    var r = target.getBoundingClientRect();    x = (r.left - wrapRect.left) + (r.width / 2);    y = (r.top - wrapRect.top) + (r.height / 2);    // Anchor segments at the midpoint of the visible exposed portion:    // inside the bar, excluding overlap with the other segment and the overlap block.    var barRect = barEl.getBoundingClientRect();    var otherRect = (key === "segA" ? parts.segB : parts.segA).getBoundingClientRect();    var blockRect = parts.block.getBoundingClientRect();    var barTopAbs = barRect.top;    var barBottomAbs = barRect.bottom;    var base = clampIntervalToBar(r.top, r.bottom, barTopAbs, barBottomAbs);    if (base) {     var spans = [{ top: base.top, bottom: base.bottom }];     var otherCut = clampIntervalToBar(otherRect.top, otherRect.bottom, barTopAbs, barBottomAbs);     var blockCut = clampIntervalToBar(blockRect.top, blockRect.bottom, barTopAbs, barBottomAbs);     if (otherCut) spans = subtractInterval(spans, otherCut.top, otherCut.bottom);     if (blockCut) spans = subtractInterval(spans, blockCut.top, blockCut.bottom);     y = midpointOfLargestSpan(spans, y + wrapRect.top) - wrapRect.top;    }   }   return { x:x, y:y };  }  var labels = ["segB","inter","block","segA"];  for (var ai = 0; ai < labels.length; ai++) anchors[labels[ai]] = computeAnchor(labels[ai]);  labels.sort(function (aKey, bKey) { return anchors[aKey].y - anchors[bKey].y; });  // Dynamic label block layout  var cursorY = compact ? 0 : 24, rowGap = compact ? 6 : 16, labelToDescGap = compact ? 1 : 2;  var labelAnchorY = {};  for (var li = 0; li < labels.length; li++) {   var k = labels[li];   var label = card.querySelector('[data-annot-key="' + k + '"]');   var desc = card.querySelector('[data-annot-desc-key="' + k + '"]');   var labelFs = parseFloat(getComputedStyle(label).fontSize) || 10;   label.style.top = cursorY + "px";   label.style.left = (compact ? 8 : 20) + "px";   // Deterministic leader row center: assigned label row top + half font size.   labelAnchorY[k] = cursorY + (labelFs * 0.5);   var descLeft = compact ? 8 : 20;   var targetTextRight = wrap.clientWidth * 0.5;   desc.style.left = descLeft + "px";   desc.style.width = Math.max(110, Math.floor(targetTextRight - descLeft)) + "px";   var lh = label.getBoundingClientRect().height || 12;   var dt = cursorY + lh + labelToDescGap;   desc.style.top = dt + "px";   cursorY = dt + (desc.getBoundingClientRect().height || 12) + rowGap;  }  var focusBarLeft = barEl.getBoundingClientRect().left - wrapRect.left;  var gapVar = parseFloat(getComputedStyle(root).getPropertyValue("--wv-label-gap")) || 2;  var maxTextRight = 0, leaderStartX = {}, minHoriz = compact ? 18 : 12;  for (li = 0; li < labels.length; li++) {   k = labels[li];   label = card.querySelector('[data-annot-key="' + k + '"]');   desc = card.querySelector('[data-annot-desc-key="' + k + '"]');   var lr = p10GetLabelTextRightPx(label, wrapRect);   maxTextRight = Math.max(maxTextRight, lr, p10GetContentRightPx(desc, wrapRect));   leaderStartX[k] = Math.round(lr + gapVar);  }  var elbowX = maxTextRight + ((focusBarLeft - maxTextRight) * 0.5);  for (li = 0; li < labels.length; li++) elbowX = Math.max(elbowX, leaderStartX[labels[li]] + minHoriz);  for (li = 0; li < labels.length; li++) {   k = labels[li];   label = card.querySelector('[data-annot-key="' + k + '"]');   var svg = card.querySelector('[data-annot-leader="' + k + '"]');   var path = svg.querySelector(".annot-p10-line");   var dot = svg.querySelector(".annot-p10-dot");   var yLine = Math.max(0.5, Math.round(labelAnchorY[k]) + 0.5);   path.setAttribute("d", "M " + anchors[k].x + " " + anchors[k].y + " L " + elbowX + " " + yLine + " L " + leaderStartX[k] + " " + yLine);   dot.setAttribute("cx", anchors[k].x); dot.setAttribute("cy", anchors[k].y);  }  // Measurement guides  var igTrack = card.querySelector(".annot-p10-ig-track");  var overlapRect = parts.block.getBoundingClientRect();  var igRect = igTrack.getBoundingClientRect();  var focusRect = barEl.getBoundingClientRect();  var yOverlap = (overlapRect.top - wrapRect.top) + (overlapRect.height / 2);  var yTick = yOverlap;  var xOverlapStart = overlapRect.right - wrapRect.left;  var xOverlapEnd = igRect.left - wrapRect.left;  var xTickStart = xOverlapEnd;  var xTickEnd = focusRect.right - wrapRect.left;  var gO = card.querySelector('[data-annot-guide="overlap"]');  var gT = card.querySelector('[data-annot-guide="tick"]');  var gDT = card.querySelector('[data-annot-guide="dim-top"]');  var gDB = card.querySelector('[data-annot-guide="dim-bottom"]');  var gDS = card.querySelector('[data-annot-guide="dim-symbol"]');  var gSep = card.querySelector('[data-annot-guide="sep-link"]');  var gSepDotL = card.querySelector('[data-annot-guide="sep-link-dot-left"]');  var gSepDotR = card.querySelector('[data-annot-guide="sep-link-dot-right"]');  var gSepMagL = card.querySelector('[data-annot-guide="sep-mag-left"]');  var gSepMagR = card.querySelector('[data-annot-guide="sep-mag-right"]');  var gSepBaseL = card.querySelector('[data-annot-guide="sep-base-left"]');  var gSepBaseR = card.querySelector('[data-annot-guide="sep-base-right"]');  var gSepCapL = card.querySelector('[data-annot-guide="sep-cap-left"]');  var gSepCapR = card.querySelector('[data-annot-guide="sep-cap-right"]');  var gSepSymL = card.querySelector('[data-annot-guide="sep-symbol-left"]');  var gSepSymR = card.querySelector('[data-annot-guide="sep-symbol-right"]');  var gShTop = card.querySelector('[data-annot-guide="shat-top-guide"]');  var gShBlock = card.querySelector('[data-annot-guide="shat-block-guide"]');  var gShDimTop = card.querySelector('[data-annot-guide="shat-dim-top"]');  var gShDimBottom = card.querySelector('[data-annot-guide="shat-dim-bottom"]');  var gShSym = card.querySelector('[data-annot-guide="shat-symbol"]');  if (type === "separation") {   var refSeg = card.querySelector('[data-annot-ref="left"]');   if (refSeg) {    var refRect = refSeg.getBoundingClientRect();    yTick = (refRect.top - wrapRect.top) + (refRect.height / 2);    xOverlapEnd = refRect.left - wrapRect.left;    xTickStart = refRect.left - wrapRect.left;    xTickEnd = focusRect.right - wrapRect.left;   }  } else {   var activeTick = card.querySelector('[data-annot-ig-tick="' + (type === "support" ? "support" : "signal") + '"]');   if (activeTick) {    var tickRect = activeTick.getBoundingClientRect();    yTick = (tickRect.top - wrapRect.top) + (tickRect.height / 2);    xTickStart = tickRect.left - wrapRect.left;   }   // Support/signal popups: project Δy horizontal guides to 2/3 of the inter-column gap.   var colGap = Math.max(8, (igRect.left - focusRect.right));   var guideRun = colGap * (2 / 3);   xOverlapEnd = Math.min(xOverlapStart + guideRun, igRect.left - wrapRect.left);   xTickEnd = Math.max(xTickStart - guideRun, focusRect.right - wrapRect.left);  }  if (type === "separation") {   var sepAnchorY = yOverlap;   var sigAnchorY = yTick;   var refSegRect = card.querySelector('[data-annot-ref="left"]').getBoundingClientRect();   var gap = Math.max(12, (igRect.left - focusRect.right));   var xSepBarRight = focusRect.right - wrapRect.left;   var xDy = xSepBarRight + (gap / 3);   var xDh = xSepBarRight + ((gap * 2) / 3);   var xBlockCenter = (overlapRect.left - wrapRect.left) + (overlapRect.width / 2);   var xSigCenter = (refSegRect.left - wrapRect.left) + (refSegRect.width / 2);   var xBlockEdge = overlapRect.right - wrapRect.left;   var xSigEdge = refSegRect.left - wrapRect.left;   var xSepBarLeft = focusRect.left - wrapRect.left;   var yBlockTop = overlapRect.top - wrapRect.top;   var yBlockBottom = overlapRect.bottom - wrapRect.top;   var ySigTop = refSegRect.top - wrapRect.top;   var ySigBottom = refSegRect.bottom - wrapRect.top;   var yBarTop = focusRect.top - wrapRect.top;   // Separation popup guide layout:   // - Δy uses a 1/3-gap reference column (white)   // - Δh uses a 2/3-gap reference column (violet)   // - Ŝ uses a left-of-bar reference column (mint)   // Δy:   // Dashed horizontals run from:   // - separation overlap center   // - signal separation segment center   // to a 1/3-gap reference column.   // Solid vertical dimension line spans those two y positions.   // Arrow always points toward the overlap-block side.   gO.setAttribute("x1", xBlockCenter);   gO.setAttr