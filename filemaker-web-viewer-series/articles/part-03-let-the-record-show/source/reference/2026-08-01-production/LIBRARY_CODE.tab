ted[0].length - 1);      var desiredRowIntervals = Math.max(        rowMajor,        Math.round((vertSpan / horizSpan) * colIntervals)      );      rowSubdiv = Math.max(1, Math.min(12, Math.round(desiredRowIntervals / rowMajor) - 1));    }    for (var y1 = 0; y1 < projected.length; y1++) {      out.push('<path d="' + catmullPath(projected[y1]) + '" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="0.28"/>');      if (y1 < projected.length - 1) {        for (var rs = 1; rs <= rowSubdiv; rs++) {          var t = rs / (rowSubdiv + 1);          var iRow = lerpRows(projected[y1], projected[y1 + 1], t);          out.push('<path d="' + catmullPath(iRow) + '" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="0.16"/>');        }      }    }    if (projected.length > 1 && projected[0].length > 1) {      var colIdx = [];      if (options.autoSquareGrid) {        var rowLineCount = projected.length + ((projected.length - 1) * rowSubdiv);        var majorCols = Math.max(2, Math.min(projected[0].length, Math.round((rowLineCount + 1) / 2)));        if (majorCols > 28) majorCols = 28;        for (var mk = 0; mk < majorCols; mk++) {          var tMajor = mk / Math.max(1, majorCols - 1);          colIdx.push(clampIndexFromNorm(tMajor, projected[0].length));        }      } else {        var step = Math.max(1, Math.floor(projected[0].length / 14));        for (var ci = 0; ci < projected[0].length; ci += step) colIdx.push(ci);        if (colIdx[colIdx.length - 1] !== projected[0].length - 1) colIdx.push(projected[0].length - 1);      }      // De-dupe in case rounded indices collide.      colIdx = colIdx.filter(function (v, i, a) { return i === 0 || v !== a[i - 1]; });      for (var k = 0; k < colIdx.length; k++) {        var cx = colIdx[k];        var cPts = [];        for (var cy = 0; cy < projected.length; cy++) cPts.push(projected[cy][cx]);        out.push('<path d="' + catmullPath(cPts) + '" fill="none" stroke="rgba(255,255,25