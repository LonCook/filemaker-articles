ate.dom = {      root: root,      hist: root.querySelector("#p4HistSvg"),      stack: root.querySelector("#p4StackSvg"),      movers: root.querySelector("#p4Movers"),      tooltip: root.querySelector("#p4Tooltip"),      chipFocus: root.querySelector("#p4ChipFocus"),      chipNeighbors: root.querySelector("#p4ChipNeighbors"),      chipNeighborsVal: root.querySelector("#p4ChipNeighborsVal"),      chipNeighborsRange: root.querySelector("#p4ChipNeighborsRange"),      chipBand: root.querySelector("#p4ChipBand"),      chipApplyRows: root.querySelector("#p4ChipApplyRows"),      layerDensity: root.querySelector("#p4dLayerDensity"),      layerDivergence: root.querySelector("#p4dLayerDivergence"),      layerSigma: root.querySelector("#p4dLayerSigma"),      animToggle: root.querySelector("#p4dAnimToggle"),      p3PlaceholderLegend: root.querySelector("#p4P3PlaceholderLegend"),      yaw: root.querySelector("#p4dYaw"),      pitch: root.querySelector("#p4dPitch")    };    bindDomEvents();  }  function setLayerBtn(el, label, on) {    if (!el) return;    el.classList.toggle("active", !!on);    el.innerHTML = "<strong>" + label + ":</strong> " + (on ? "On" : "Off");  }  function bindDomEvents() {    var d = state.dom;    if (!d) return;    d.chipFocus.addEventListener("click", function () {      if (Number.isFinite(state.ui.focusRating)) {        state.ui.focusMovieId = "";        state.ui.focusTitle = "None";        state.ui.focusRating = null;        draw();        emitAction("clear_focus", {});      }    });    d.chipNeighbors.addEventListener("click", function () {      state.ui.neighborsOn = !state.ui.neighborsOn;      draw();      emitAction("toggle_neighbors", { enabled: state.ui.neighborsOn });    });    d.chipNeighborsRange.addEventListener("pointerdown", function (evt) { evt.stopPropagation(); });    d.chipNeighborsRange.addEventListener("click", function (evt) { evt.stopPropagation(); });     d.chipNeighborsRange.addEventListener("input", function (evt) {       evt.stopPropagation();       state.ui.neighborRadius = clamp(Math.round(Number(d.chipNeighborsRange.value) || 15), 5, 40);       draw();       commitNeighborRadius(140, "rows");     });     d.chipNeighborsRange.addEventListener("change", function (evt) {       evt.stopPropagation();       state.ui.neighborRadius = clamp(Math.round(Number(d.chipNeighborsRange.value) || 15), 5, 40);       draw();       commitNeighborRadius(0, "rows");     });     d.chipNeighborsRange.addEventListener("pointerup", function (evt) {       evt.stopPropagation();       state.ui.neighborRadius = clamp(Math.round(Number(d.chipNeighborsRange.value) || 15), 5, 40);       commitNeighborRadius(0, "rows");     });    d.chipBand.addEventListener("click", function () {      if (state.ui.bandStartIdx < 0 || state.ui.bandEndIdx < 0) return;      state.ui.bandStartIdx = -1;      state.ui.bandEndIdx = -1;      draw();      emitAction("clear_band", {});    });    d.chipApplyRows.addEventListener("click", function () {      state.ui.applyToRows = !state.ui.applyToRows;      draw();      emitAction("toggle_apply_rows", { enabled: state.ui.applyToRows });    });    function bindLayer(btn, key, label) {      function onToggle(evt) {        if (evt) {          evt.preventDefault();          evt.stopPropagation();        }        state.ui.layers[key] = !state.ui.layers[key];        setLayerBtn(btn, label, state.ui.layers[key]);        draw();        emitAction("toggle_layer", { layer: key, enabled: state.ui.layers[key] });      }      btn.addEventListener("pointerdown", onToggle);      btn.addEventListener("click", function (evt) {        // Keyboard activation fallback.        if (evt && evt.detail === 0) onToggle(evt);      });    }    bindLayer(d.layerDensity, "density", "Density");    bindLayer(d.layerDivergence, "divergence", "Divergence");    bindLayer(d.layerSigma, "sigma", "Sigma");    function onAnimToggle(evt) {      if (evt) {        evt.preventDefault();        evt.stopPropagation();      }      state.ui.animOn = !state.ui.animOn;      setLayerBtn(d.animToggle, "Anim", state.ui.animOn);      if (state.ui.animOn) startAnimation();      else stopAnimation();      draw();      emitAction("toggle_animation", { enabled: state.ui.animOn });    }    d.animToggle.addEventListener("pointerdown", onAnimToggle);    d.animToggle.addEventListener("click", function (evt) {      if (evt && evt.detail === 0) onAnimToggle(evt);    });    d.yaw.addEventListener("pointerdown", function () { state.yawDragging = true; });    d.pitch.addEventListener("pointerdown", function () { state.pitchDragging = true; });    window.addEventListener("pointerup", function (evt) {      state.yawDragging = false;      state.pitchDragging = false;      endDrag(evt);    });    window.addEventListener("mouseup", endDrag);    window.addEventListener("touchend", endDrag, { passive: true });    window.addEventListener("touchcancel", function () { cancelDrag(); }, { passive: true });    window.addEventListener("blur", endDrag);    d.yaw.addEventListener("input", function () {      var yaw = Number(d.yaw.value);      if (state.ui.animOn) {        seekOrbitToYaw(yaw);      } else {        state.ui.yawBase = clamp(yaw - state.orbit.offset, -8, 8);      }      draw({ hoverOnly: true });      emitAction("set_camera", { yaw: clamp(state.ui.yawBase + state.orbit.offset, -8, 8), pitch: state.ui.pitch });    });    d.pitch.addEventListener("input", function () {      state.ui.pitch = clamp(Number(d.pitch.value) || 12, 0.2, 12);      draw({ hoverOnly: true });      emitAction("set_camera", { yaw: clamp(state.ui.yawBase + state.orbit.offset, -8, 8), pitch: state.ui.pitch });    });    // Histogram band drag (multi-bin).    d.hist.addEventListener("pointerdown", function (evt) {      var idx = binIndexFromClientX(evt.clientX);      if (idx < 0) return;      state.drag.active = true;      state.drag.startIdx = idx;      state.drag.currIdx = idx;      state.drag.pointerId = (evt && Number.isFinite(evt.pointerId)) ? evt.pointerId : null;      state.drag.committed = false;      state.ui.bandStartIdx = idx;      state.ui.bandEndIdx = idx;      try { d.hist.setPointerCapture(evt.pointerId); } catch (_e) {}      draw();    });    function handleHistMove(evt) {      var p = localXY(evt, d.hist);      state.hoverX = p.x;      state.hoverY = p.y;      var hitNeighbor = !!(evt && evt.target && evt.target.getAttribute && evt.target.getAttribute("data-neighbor-hit") === "1");      state.hoverBin = hitNeighbor ? -1 : binIndexFromClientX(evt.clientX);      if (state.drag.active) {        if (state.drag.pointerId !== null && evt && Number.isFinite(evt.pointerId) && evt.pointerId !== state.drag.pointerId) {          return;        }        var idx = binIndexFromClientX(evt.clientX);        if (idx >= 0 && idx !== state.drag.currIdx) {          state.drag.currIdx = idx;          state.ui.bandStartIdx = state.drag.startIdx;          state.ui.bandEndIdx = idx;          draw();        }       } else if (!hitNeighbor) {         state.hoverPoint = null;         state.ui.hoverMovieId = "";         state.ui.hoverTitle = "";         state.ui.hoverRating = null;         state.ui.hoverSigma = null;          emitHoverAction("", "", null, null, "p1_hist");         draw({ hoverOnly: true });       }     }    d.hist.addEventListener("pointermove", handleHistMove);    d.hist.addEventListener("mousemove", handleHistMove);    function cancelDrag() {      if (!state.drag.active) return;      state.drag.active = false;      state.drag.pointerId = null;      state.drag.committed = false;    }    function endDrag(evt) {      if (!state.drag.active) return;      if (        state.drag.pointerId !== null &&        evt &&        Number.isFinite(evt.pointerId) &&        evt.pointerId !== state.drag.pointerId      ) {        return;      }      state.drag.active = false;      try { d.hist.releasePointerCapture(evt.pointerId); } catch (_e) {}      var lo = Math.min(state.ui.bandStartIdx, state.ui.bandEndIdx);      var hi = Math.max(state.ui.bandStartIdx, state.ui.bandEndIdx);      if (!state.drag.committed && lo >= 0 && hi >= 0) {        emitAction("set_band", bandPayloadFromIdx(lo, hi));        state.drag.committed = true;      }      state.drag.pointerId = null;      draw();    }    d.hist.addEventListener("pointerup", endDrag);    d.hist.addEventListener("pointercancel", function () { cancelDrag(); });    d.hist.addEventListener("lostpointercapture", endDrag);    d.hist.addEventListener("dblclick", function () {      state.ui.bandStartIdx = -1;      state.ui.bandEndIdx = -1;      draw();      emitAction("clear_band", {});    });     function clearHistHover() {       state.hoverBin = -1;       state.hoverPoint = null;       state.ui.hoverMovieId = "";       state.ui.hoverTitle = "";       state.ui.hoverRating = null;       state.ui.hoverSigma = null;        emitHoverAction("", "", null, null, "p1_hist");       d.tooltip.style.display = "none";       if (!state.drag.active) {         draw({ hoverOnly: true });       }     }    d.hist.addEventListener("pointerleave", clearHistHover);    d.hist.addEventListener("mouseleave", clearHistHover);    // Movers interactions.    function findMoverRow(target) {      if (!target) return null;      if (target.closest) return target.closest("[data-action='focus-mover']");      var el = target;      while (el && el !== d.movers) {        if (el.getAttribute && el.getAttribute("data-action") === "focus-mover") return el;        el = el.parentNode;      }      return null;    }    function activateMover(evt) {      var row = findMoverRow(evt && evt.target);      if (!row) return;      var movieId = row.getAttribute("data-movie-id") || "";      var t = row.getAttribute("data-title") || "";      var r = Number(row.getAttribute("data-rating"));      var rank = Number(row.getAttribute("data-rank"));      if (!t || !Number.isFinite(r)) return;      var same = false;      if (movieId && state.ui.focusMovieId) same = state.ui.focusMovieId === movieId;      else same = Number.isFinite(state.ui.focusRating) && state.ui.focusTitle === t;      if (same) {        state.ui.focusMovieId = "";        state.ui.focusTitle = "None";        state.ui.focusRating = null;        emitAction("clear_focus", {});      } else {        state.ui.focusMovieId = movieId;        state.ui.focusTitle = t;        state.ui.focusRating = r;        emitAction("set_focus", {          movie_id: movieId || null,          title: t,          rating: r,          rank: Number.isFinite(rank) ? rank : null        }, {          source: "p2_mover"        });      }      draw();    }    function runMoverEmptyAction(evt) {      var btn = evt && evt.target && evt.target.closest ? evt.target.closest(".rd-empty-btn") : null;      if (!btn) return false;      var action = btn.getAttribute("data-action") || "";      if (action === "clear-band") {        state.ui.bandStartIdx = -1;        state.ui.bandEndIdx = -1;        draw();        emitAction("clear_band", {});        return true;      }      if (action === "filter-all") {        if (state.model && state.model.filter) state.model.filter.label = "All Genres";        draw();        emitAction("set_filter_all", { filter: "all", label: "All Genres" });        return true;      }      return false;    }    d.movers.addEventListener("pointerdown", function (evt) {      if (runMoverEmptyAction(evt)) {        evt.preventDefault();        evt.stopPropagation();        return;      }      evt.preventDefault();      evt.stopPropagation();      activateMover(evt);    });    d.movers.addEventListener("click", function (evt) {      if (runMoverEmptyAction(evt)) return;      if (evt && evt.detail === 0) activateMover(evt);    });     function handleMoverHover(evt) {       var row = findMoverRow(evt && evt.target);       if (!row) return;       var t = row.getAttribute("data-title") || "";       var r = Number(row.getAttribute("data-rating"));       var sigmaPct = Number(row.getAttribute("data-sigma"));        var movieId = row.getAttribute("data-movie-id") || "";       if (!t || !Number.isFinite(r)) return;       state.hoverPoint = null;       state.ui.hoverMovieId = movieId;       state.ui.hoverTitle = t;       state.ui.hoverRating = r;       state.ui.hoverSigma = Number.isFinite(sigmaPct) ? (sigmaPct / 100) : null;        emitHoverAction(movieId, t, r, Number.isFinite(sigmaPct) ? (sigmaPct / 100) : null, "p2_mover_hover");       draw({ hoverOnly: true });     }    d.movers.addEventListener("pointermove", handleMoverHover);    d.movers.addEventListener("mousemove", handleMoverHover);     function clearMoverHover() {       state.hoverPoint = null;       state.ui.hoverMovieId = "";       state.ui.hoverTitle = "";       state.ui.hoverRating = null;       state.ui.hoverSigma = null;        emitHoverAction("", "", null, null, "p2_mover_hover");       draw({ hoverOnly: true });     }    d.movers.addEventListener("pointerleave", clearMoverHover);    d.movers.addEventListener("mouseleave", clearMoverHover);    // P3 stacked-layer hover/pin interactions.    d.stack.addEventListener("pointerenter", function () {      state.p3Hover.active = true;      stopAnimation();    });    d.stack.addEventListener("pointermove", function (evt) {      var p = localStackXY(evt, d.stack);      var nearest = pickNearestStackLayerRow(d.stack, p.x, p.y, 10.5);      state.p3Hover.layerHover = nearest.layer || "";      state.p3Hover.hoverRows.sigma = -1;      state.p3Hover.hoverRows.divergence = -1;      state.p3Hover.hoverRows.density = -1;      if (nearest.layer) state.p3Hover.hoverRows[nearest.layer] = nearest.row;      draw({ hoverOnly: true });    });    d.stack.addEventListener("click", function (evt) {      var p = localStackXY(evt, d.stack);      var hitLabel = hitStackLabel(d.stack, p.x, p.y);      if (hitLabel && state.p3Hover.pinnedRows[hitLabel] >= 0) {        state.p3Hover.pinnedRows[hitLabel] = -1;        draw({ hoverOnly: true });        return;      }      var nearest = pickNearestStackLayerRow(d.stack, p.x, p.y, 10.5);      if (nearest.layer && nearest.row >= 0) {        state.p3Hover.pinnedRows[nearest.layer] = nearest.row;      } else {        state.p3Hover.pinnedRows.sigma = -1;        state.p3Hover.pinnedRows.divergence = -1;        state.p3Hover.pinnedRows.density = -1;      }      draw({ hoverOnly: true });    });    d.stack.addEventListener("pointerleave", function () {      state.p3Hover.active = false;      state.p3Hover.layerHover = "";      state.p3Hover.hoverRows.sigma = -1;      state.p3Hover.hoverRows.divergence = -1;      state.p3Hover.hoverRows.density = -1;      draw({ hoverOnly: true });      if (state.ui.animOn) startAnimation();    });  }  function localXY(evt, el) {    var r = el.getBoundingClientRect();    return {      x: ((evt.clientX - r.left) / Math.max(1e-9, r.width)) * 100,      y: ((evt.clientY - r.top) / Math.max(1e-9, r.height)) * 100    };  }  function binIndexFromClientX(clientX) {    var d = state.dom;    if (!d || !state.model) return -1;    var layout = state._histLayout;    if (!layout) return -1;    var rect = d.hist.getBoundingClientRect();    var x = clientX - rect.left;    if (x < layout.left || x > layout.right) return -1;    // Map continuously across full histogram width so bin selection    // remains stable in FileMaker Web Viewer even when landing in bar gaps.    var slot = layout.width / Math.max(1, layout.nBins);    var idx = Math.floor((x - layout.left) / Math.max(1e-9, slot));    idx = clamp(idx, 0, layout.nBins - 1);    return idx;  }  function bandPayloadFromIdx(lo, hi) {    var d = state.model.distribution;    var rr = ratingRangeForBins(lo, hi, d);    var pLo = Math.round(percentileFromRating(rr.lo, d));    var pHi = Math.round(percentileFromRating(rr.hi, d));    return {      i_lo: Math.min(lo, hi),      i_hi: Math.max(lo, hi),      pct_lo: Math.min(pLo, pHi),      pct_hi: Math.max(pLo, pHi),      rating_lo: rr.lo,      rating_hi: rr.hi,      min_percentile: Math.min(pLo, pHi),      max_percentile: Math.max(pLo, pHi)    };  }  function localStackXY(evt, el) {    var r = el.getBoundingClientRect();    return {      x: ((evt.clientX - r.left) / Math.max(1e-9, r.width)) * 100,      y: ((evt.clientY - r.top) / Math.max(1e-9, r.height)) * 100    };  }  function pointSegDistSq(px, py, ax, ay, bx, by) {    var vx = bx - ax;    var vy = by - ay;    var wx = px - ax;    var wy = py - ay;    var c1 = (wx * vx) + (wy * vy);    if (c1 <= 0) return ((px - ax) * (px - ax)) + ((py - ay) * (py - ay));    var c2 = (vx * vx) + (vy * vy);    if (c2 <= 1e-9) return ((px - ax) * (px - ax)) + ((py - ay) * (py - ay));    var t = Math.max(0, Math.min(1, c1 / c2));    var qx = ax + (t * vx);    var qy = ay + (t * vy);    return ((px - qx) * (px - qx)) + ((py - qy) * (py - qy));  }  function pickNearestRowInRows(rows, px, py, maxDist) {    if (!rows || !rows.length) return { row: -1, d2: Infinity };    var bestRow = -1;    var bestD2 = Infinity;    var hit = Number.isFinite(maxDist) ? maxDist : 10.5;    for (var r = 0; r < rows.length; r++) {      var pts = rows[r];      if (!pts || pts.length < 2) continue;      for (var i = 1; i < pts.length; i++) {        var d2 = pointSegDistSq(px, py, pts[i - 1].x, pts[i - 1].y, pts[i].x, pts[i].y);        if (d2 < bestD2) {          bestD2 = d2;          bestRow = r;        }      }    }    if (bestD2 <= (hit * hit)) return { row: bestRow, d2: bestD2 };    return { row: -1, d2: Infinity };  }  function pickNearestStackLayerRow(svgEl, px, py, maxDist) {    var layers = svgEl && svgEl.__wv3dProjectedLayers;    if (!layers) return { layer: "", row: -1, d2: Infinity };    var order = ["density", "divergence", "sigma"];    var best = { layer: "", row: -1, d2: Infinity };    for (var i = 0; i < order.length; i++) {      var lk = order[i];      if (!layers[lk]) continue;      var hit = pickNearestRowInRows(layers[lk], px, py, maxDist);      if (hit.row >= 0 && hit.d2 < best.d2) best = { layer: lk, row: hit.row, d2: hit.d2 };    }    return best;  }  function hitStackLabel(svgEl, px, py) {    var labels = svgEl && svgEl.__wv3dHoverLabels;    if (!labels) return "";    var order = ["density", "divergence", "sigma"];    for (var i = 0; i < order.length; i++) {      var k = order[i];      var b = labels[k];      if (!b) continue;      if (px >= b.x && px <= (b.x + b.w) && py >= b.y && py <= (b.y + b.h)) return k;    }    return "";  }  function p3StackDisplayRow(h, layerKey) {    if (!h || !h.pinnedRows || !h.hoverRows) return -1;    var pin = Number(h.pinnedRows[layerKey]);    if (Number.isFinite(pin) && pin >= 0) return pin;    if (h.layerHover === layerKey) {      var hov = Number(h.hoverRows[layerKey]);      return (Number.isFinite(hov) && hov >= 0) ? hov : -1;    }    return -1;  }  function p3GenreMetaForRow(rowIdx, rowCount, genres) {    if (!(Number.isFinite(rowIdx) && rowIdx >= 0)) return null;    var list = Array.isArray(genres) ? genres : [];    if (!list.length) return null;    var keyIdx = Math.round((rowIdx / Math.max(1, rowCount - 1)) * Math.max(0, list.length - 1));    keyIdx = clamp(keyIdx, 0, list.length - 1);    var g = list[keyIdx] || {};    var label = String(g.label || g.key || "Genre");    var isPlaceholder = !!(g && g.isPlaceholder === true);    return {      label: label,      isPlaceholder: isPlaceholder,      weight: Number.isFinite(Number(g.weight)) ? Number(g.weight).toFixed(2) : "--",      sample: Number.isFinite(Number(g.sample)) ? String(Math.round(Number(g.sample))) : "--"    };  }  function percentileFromRating(rating, d) {    var xs = [d.min, d.p25, d.p50, d.p75, d.max];    var ys = [0, 25, 50, 75, 100];    if (!Number.isFinite(rating)) return 0;    if (rating <= xs[0]) return 0;    if (rating >= xs[4]) return 100;    for (var i = 0; i < xs.length - 1; i++) {      if (rating >= xs[i] && rating <= xs[i + 1]) {        var t = (rating - xs[i]) / Math.max(1e-9, xs[i + 1] - xs[i]);        return ys[i] + (t * (ys[i + 1] - ys[i]));      }    }    return 0;  }  function neighborRatingRange(dist) {    if (!dist || !state.ui.neighborsOn || !Number.isFinite(state.ui.focusRating)) return null;    var n = state.model && state.model.neighbors ? state.model.neighbors : {};    var effectivePoints = n.basis === "rank"      ? effectiveRankNeighborPoints(n, state.ui.focusMovieId, state.ui.neighborRadius)      : [];    var hasPointRange = n.basis === "rank" && effectivePoints.length;    var pointLo = null;    var pointHi = null;    if (hasPointRange) {      for (var i = 0; i < effectivePoints.length; i++) {        var r = Number(effectivePoints[i] && effectivePoints[i].rating);        if (!Number.isFinite(r)) continue;        pointLo = pointLo === null ? r : Math.min(pointLo, r);        pointHi = pointHi === null ? r : Math.max(pointHi, r);      }      hasPointRange = Number.isFinite(pointLo) && Number.isFinite(pointHi);    }    var rankBased = n.basis === "rank" && (      hasPointRange ||      (Number.isFinite(n.ratingLo) && Number.isFinite(n.ratingHi))    );    var lo = hasPointRange ? pointLo : (rankBased ? n.ratingLo : (state.ui.focusRating - state.ui.neighborRadius));    var hi = hasPointRange ? pointHi : (rankBased ? n.ratingHi : (state.ui.focusRating + state.ui.neighborRadius));    lo = clamp(lo, dist.min, dist.max);    hi = clamp(hi, dist.min, dist.max);    var count = null;    if (rankBased) {      if (effectivePoints.length) count = effectivePoints.length;      else if (Array.isArray(n.movieIds) && n.movieIds.length) count = n.movieIds.length;      else if (Number.isFinite(n.rankLo) && Number.isFinite(n.rankHi)) count = Math.max(0, Math.round(n.rankHi - n.rankLo + 1));    }    return {      lo: Math.min(lo, hi),      hi: Math.max(lo, hi),      basis: rankBased ? "rank" : "rating",      count: count    };  }  function setFromContext(ctx) {    var raw = (((ctx || {}).__wv || {}).viz || {}).p4;    state.model = normalizeP4(raw);    state.actionScript = state.model.actionScript || "WV__Rating_Dashboard_Action";    var m = state.model;    var lastAction = (WV && WV._state) ? WV._state._p4LastAction : null;    var preserveLocalNeighborRadius = !!(      lastAction &&      lastAction.action === "set_neighbors" &&      lastAction.meta &&      lastAction.meta.refresh === "rows" &&      Number.isFinite(Number(state.ui.neighborRadius))    );    state.ui.focusMovieId = m.focus.movie_id || "";    state.ui.focusTitle = m.focus.title;    var hasNamedFocus = !!(state.ui.focusTitle && state.ui.focusTitle !== "None");    var hasFocusIdentity = !!state.ui.focusMovieId || hasNamedFocus;    state.ui.focusRating = (hasFocusIdentity && Number.isFinite(m.focus.rating)) ? m.focus.rating : null;    state.ui.extHoverTitle = m.hover.title || "";    state.ui.extHoverRating = Number.isFinite(m.hover.rating) ? m.hover.rating : null;    if (!state.ui.extHoverTitle) state.ui.extHoverRating = null;    state.ui.neighborsOn = !!m.neighbors.enabled;    state.ui.neighborRadius = preserveLocalNeighborRadius      ? clamp(Math.round(Number(state.ui.neighborRadius) || 15), 5, 40)      : m.neighbors.radius;    if (preserveLocalNeighborRadius) m.neighbors.radius = state.ui.neighborRadius;    state.ui.applyToRows = !!m.applyToRows;    state.ui.layers = {      zNormShared: !!m.layers.zNormShared,      density: !!m.layers.density,      divergence: !!m.layers.divergence,      sigma: !!m.layers.sigma    };    state.ui.animOn = !!m.camera.animEnabled;    state.ui.yawBase = clamp(m.camera.yaw, -8, 8);    state.ui.pitch = clamp(m.camera.pitch, 0.2, 12);    state.orbit.yawAmpNeg = Math.max(0.1, Number(m.camera.yawAmpNeg) || 8.0);    state.orbit.yawAmpPos = Math.max(0.1, Number(m.camera.yawAmpPos) || 4.0);    state.orbit.orbitHz = Math.max(0.005, Number(m.camera.orbitHz) || 0.042);    if (m.bands.active) {      var n = m.distribution.bins.length;      if (Number.isFinite(m.bands.iLo) && Number.isFinite(m.bands.iHi)) {        state.ui.bandStartIdx = clamp(Math.round(m.bands.iLo), 0, n - 1);        state.ui.bandEndIdx = clamp(Math.round(m.bands.iHi), 0, n - 1);      } else {        // Without explicit bin indices we avoid lossy percentile remap.        state.ui.bandStartIdx = -1;        state.ui.bandEndIdx = -1;      }    } else {      state.ui.bandStartIdx = -1;      state.ui.bandEndIdx = -1;    }  }  function applyMoverSigmaVars(rootEl) {    if (!rootEl) return;    var rows = rootEl.querySelectorAll(".rd-mover[data-sigma]");    for (var i = 0; i < rows.length; i++) {      var el = rows[i];      var sigma = Number(el.getAttribute("data-sigma"));      if (!Number.isFinite(sigma)) sigma = 0;      sigma = clamp(Math.round(sigma), 0, 100);      el.style.setProperty("--sigma", sigma + "%");    }  }  function renderMovers() {    var d = state.dom;    var m = state.model;    var focusTitle = (state.ui.focusTitle && state.ui.focusTitle !== "None" && Number.isFinite(state.ui.focusRating)) ? state.ui.focusTitle : "";    var bandActive = state.ui.bandStartIdx >= 0 && state.ui.bandEndIdx >= 0;    var bandLo = null;    var bandHi = null;    if (bandActive) {      var loIdx = Math.min(state.ui.bandStartIdx, state.ui.bandEndIdx);      var hiIdx = Math.max(state.ui.bandStartIdx, state.ui.bandEndIdx);      var rrBand = ratingRangeForBins(loIdx, hiIdx, m.distribution);      bandLo = rrBand.lo;      bandHi = rrBand.hi;    }     function rowHTML(r, isUp, alignRight) {      var rankDelta = null;      if (Number.isFinite(r.rank_prev) && Number.isFinite(r.rank_now)) {        rankDelta = r.rank_prev - r.rank_now;      }      var moveDelta = Number.isFinite(rankDelta) ? rankDelta : r.delta;      var c = moveDelta > 0 ? "rd-up" : "rd-down";      var sign = moveDelta > 0 ? "+" : "";      var sigmaPct = Math.round(clamp(r.sigma, 0, 1) * 100);      var rankTxt = "";      if (Number.isFinite(r.rank_now)) {        rankTxt = Number.isFinite(r.rank_prev)          ? (" • #" + r.rank_prev + "→#" + r.rank_now)          : (" • --→#" + r.rank_now);      }      var movieId = String(r.movie_id || "");      var tAttr = esc(r.title);      var idAttr = esc(movieId);      var rAttr = Number.isFinite(r.rating) ? r.rating : "";      var rankAttr = Number.isFinite(r.rank_now) ? r.rank_now : "";      var focusClass = "";      if (state.ui.focusMovieId && movieId) focusClass = (state.ui.focusMovieId === movieId) ? " focused" : "";      else if (focusTitle && r.title === focusTitle) focusClass = " focused";      var hoveredClass = "";      if (state.ui.hoverMovieId && movieId) hoveredClass = (state.ui.hoverMovieId === movieId) ? " hovered" : "";      else if (        state.ui.hoverTitle &&        r.title === state.ui.hoverTitle &&        Number.isFinite(state.ui.hoverRating) &&        Math.abs((Number(r.rating) || 0) - state.ui.hoverRating) < 0.0001      ) hoveredClass = " hovered";      var hoverMeta =        '<span class="rd-hm-k-r">r</span><span class="rd-hm-v">' + Math.round(r.rating) + '</span>' +        ' • ' +        '<span class="rd-hm-k-s">σ</span><span class="rd-hm-v">' + sigmaPct + '%</span>' +        '<span class="rd-hm-v">' + rankTxt + '</span>';       var metaClass = 'rd-mover-hovermeta' + (alignRight ? ' is-right' : '');       return (         '<div class="rd-mover' + focusClass + hoveredClass + '" data-sigma="' + sigmaPct + '" data-action="focus-mover" data-movie-id="' + idAttr + '" data-title="' + tAttr + '" data-rating="' + rAttr + '" data-rank="' + rankAttr + '" tabindex="0" role="button" aria-label="Focus ' + tAttr + '">' +           '<div class="rd-mover-fill"></div>' +           '<div class="rd-mover-name">' + tAttr + '</div>' +           '<div class="' + metaClass + '">' + hoverMeta + '</div>' +           '<div class="rd-mover-val ' + c + '">' + sign + moveDelta + '</div>' +         '</div>'       );     }    function inBand(r) {      if (!bandActive) return true;      var rv = Number(r && r.rating);      if (!Number.isFinite(rv)) return false;      return rv >= bandLo && rv <= bandHi;    }     function listHTML(rows, isUp, alignRight) {       var scoped = (rows || []).filter(inBand);      if (!scoped.length) {        var actions = [];        if (bandActive) actions.push('<button type="button" class="rd-empty-btn" data-action="clear-band">Clear Band</button>');        var fs = String((m.filter && m.filter.scope) || "").toLowerCase();        var fl = String((m.filter && m.filter.label) || "").toLowerCase();        var hasGenreFilter = !!fs && fs !== "all";        if (!fs) {          hasGenreFilter = !(fl === "" || fl === "all" || fl === "all genres" || fl.indexOf("all ") === 0);        }        if (hasGenreFilter) actions.push('<button type="button" class="rd-empty-btn" data-action="filter-all">All Genres</button>');        return (          '<div class="rd-mover-empty">No movers in selected scope' +            (actions.length              ? ('<div class="rd-empty-actions">' + actions.join("") + '</div>')              : "") +          '</div>'        );      }       return scoped.map(function (r) { return rowHTML(r, isUp, alignRight); }).join("");     }    d.movers.innerHTML =      '<div class="rd-movers-body-2col">' +        '<section class="rd-movers-col">' +          '<div class="rd-movers-title">Top Movers</div>' +           '<div class="rd-movers-list">' + listHTML(m.movers.top, true, false) + '</div>' +         '</section>' +         '<section class="rd-movers-col">' +           '<div class="rd-movers-title">Bottom Movers</div>' +           '<div class="rd-movers-list">' + listHTML(m.movers.bottom, false, true) + '</div>' +         '</section>' +       '</div>';    applyMoverSigmaVars(d.movers);  }  function drawHistogram(opts) {    opts = opts || {};    var d = state.dom;    var m = state.model;    var dist = m.distribution;    var bins = dist.bins;    var n = bins.length;    var w = d.hist.clientWidth || 100;    var h = d.hist.clientHeight || 100;    d.hist.setAttribute("viewBox", "0 0 " + w + " " + h);    while (d.hist.firstChild) d.hist.removeChild(d.hist.firstChild);    var left = 12;    var right = Math.max(left + 10, w - 10);    var top = 10;    var bottom = Math.max(top + 20, h - 22);    var width = right - left;    var height = bottom - top;    var gap = 2;    var barW = Math.max(1, (width - ((n - 1) * gap)) / n);    state._histLayout = {      left: left,      right: right,      width: width,      barW: barW,      gap: gap,      nBins: n    };    var bandActive = state.ui.bandStartIdx >= 0 && state.ui.bandEndIdx >= 0;    var bLo = bandActive ? Math.min(state.ui.bandStartIdx, state.ui.bandEndIdx) : -1;    var bHi = bandActive ? Math.max(state.ui.bandStartIdx, state.ui.bandEndIdx) : -1;    var hasFocus = !!(state.ui.focusTitle && state.ui.focusTitle !== "None" && Number.isFinite(state.ui.focusRating));    // Control chips    var focusLabel = hasFocus ? state.ui.focusTitle : "None";    d.chipFocus.innerHTML = "<strong>Focus:</strong> <span class=\"rd-pill-val\">" + esc(focusLabel) + "</span>";    d.chipFocus.classList.toggle("focus-active", hasFocus);    if (bandActive) {      var rr = ratingRangeForBins(bLo, bHi, dist);      var pLo = Math.round(percentileFromRating(rr.lo, dist));      var pHi = Math.round(percentileFromRating(rr.hi, dist));      d.chipBand.innerHTML = "<strong>Bands:</strong> <span class=\"rd-pill-val\">" + pLo + "-" + pHi + "%</span>";      d.chipBand.classList.add("active");    } else {      d.chipBand.innerHTML = "<strong>Bands:</strong> <span class=\"rd-pill-val\">All</span>";      d.chipBand.classList.remove("active");    }    d.chipNeighbors.style.display = hasFocus ? "inline-flex" : "none";    d.chipNeighborsVal.textContent = String(state.ui.neighborRadius);    d.chipNeighborsRange.value = String(state.ui.neighborRadius);    d.chipNeighbors.classList.toggle("neighbor-active", !!state.ui.neighborsOn);    var showApply = hasFocus || bandActive;    d.chipApplyRows.style.display = showApply ? "inline-flex" : "none";    d.chipApplyRows.classList.toggle("active", !!state.ui.applyToRows);    var controlWrap = d.root.querySelector(".rd-p4p1-controls");    if (controlWrap) {      controlWrap.classList.toggle("layout-4", hasFocus);      controlWrap.classList.toggle("layout-3", !hasFocus);    }    // defs/patterns    var defs = document.createElementNS(NS, "defs");    var tex = document.createElementNS(NS, "pattern");    tex.setAttribute("id", "p4DiagTex");    tex.setAttribute("patternUnits", "userSpaceOnUse");    tex.setAttribute("width", "4");    tex.setAttribute("height", "4");    tex.setAttribute("patternTransform", "rotate(-32)");    var texLine = document.createElementNS(NS, "line");    texLine.setAttribute("x1", "0");    texLine.setAttribute("y1", "0");    texLine.setAttribute("x2", "0");    texLine.setAttribute("y2", "4");    texLine.setAttribute("stroke", "rgba(255,255,255,0.88)");    texLine.setAttribute("stroke-width", "1.1");    tex.appendChild(texLine);    defs.appendChild(tex);    var texDense = document.createElementNS(NS, "pattern");    texDense.setAttribute("id", "p4DiagTexDense");    texDense.setAttribute("patternUnits", "userSpaceOnUse");    texDense.setAttribute("width", "2");    texDense.setAttribute("height", "2");    texDense.setAttribute("patternTransform", "rotate(-32)");    var texDenseLine = document.createElementNS(NS, "line");    texDenseLine.setAttribute("x1", "0");    texDenseLine.setAttribute("y1", "0");    texDenseLine.setAttribute("x2", "0");    texDenseLine.setAttribute("y2", "2");    texDenseLine.setAttribute("stroke", "rgba(245,206,118,0.96)");    texDenseLine.setAttribute("stroke-width", "1.2");    texDense.appendChild(texDenseLine);    defs.appendChild(texDense);    d.hist.appendChild(defs);    function add(type, attrs) {      var nEl = document.createElementNS(NS, type);      for (var k in attrs) nEl.setAttribute(k, attrs[k]);      d.hist.appendChild(nEl);      return nEl;    }    function band(a, b, fill, alpha, texAlpha, texId) {      var x1 = xForRating(a, left, width, dist.min, dist.max);      var x2 = xForRating(b, left, width, dist.min, dist.max);      var x = Math.min(x1, x2);      var wBand = Math.max(1, Math.abs(x2 - x1));      add("rect", { x: x, y: top, width: wBand, height: height, fill: fill, "fill-opacity": alpha });      if (texAlpha > 0) {        add("rect", { x: x, y: top, width: wBand, height: height, fill: "url(#" + texId + ")", "fill-opacity": texAlpha });      }    }    var p5 = dist.min + 0.05 * (dist.max - dist.min);    var p95 = dist.min + 0.95 * (dist.max - dist.min);    band(dist.min, p5, "#7a5c22", 0.18, 0.00, "p4DiagTex");    band(p5, dist.p25, "#a97c2d", 0.16, 0.16, "p4DiagTex");    band(dist.p25, dist.p75, "#c69a44", 0.14, 0.40, "p4DiagTexDense");    band(dist.p75, p95, "#a97c2d", 0.16, 0.16, "p4DiagTex");    band(p95, dist.max, "#7a5c22", 0.18, 0.00, "p4DiagTex");    if (bandActive) {      var rr2 = ratingRangeForBins(bLo, bHi, dist);      var bx1 = xForRating(rr2.lo, left, width, dist.min, dist.max);      var bx2 = xForRating(rr2.hi, left, width, dist.min, dist.max);      add("rect", { x: Math.min(bx1, bx2), y: top, width: Math.max(1, Math.abs(bx2 - bx1)), height: height, fill: "rgba(99,178,166,0.12)" });      add("rect", { x: Math.min(bx1, bx2), y: top, width: Math.max(1, Math.abs(bx2 - bx1)), height: height, fill: "none", stroke: "rgba(99,178,166,0.76)", "stroke-width": 1.1 });    }    var neighborRange = neighborRatingRange(dist);    var rankPoints = (hasFocus && state.ui.neighborsOn && m.neighbors && m.neighbors.basis === "rank")      ? effectiveRankNeighborPoints(m.neighbors, state.ui.focusMovieId, state.ui.neighborRadius)      : [];    var neighborHoverTargets = [];    if (hasFocus && neighborRange) {      if (rankPoints.length) {      } else if (!(m.neighbors && m.neighbors.basis === "rank")) {        var nx1 = xForRating(neighborRange.lo, left, width, dist.min, dist.max);        var nx2 = xForRating(neighborRange.hi, left, width, dist.min, dist.max);        add("rect", { x: Math.min(nx1, nx2), y: top, width: Math.max(1, Math.abs(nx2 - nx1)), height: height, fill: "rgba(227,140,109,0.10)" });        add("line", { x1: nx1, y1: top, x2: nx1, y2: bottom, stroke: "rgba(227,140,109,0.75)", "stroke-width": 1 });        add("line", { x1: nx2, y1: top, x2: nx2, y2: bottom, stroke: "rgba(227,140,109,0.75)", "stroke-width": 1 });      }    }    add("line", { x1: left, y1: bottom, x2: right, y2: bottom, stroke: "rgba(255,255,255,0.36)", "stroke-width": 1 });    var maxBin = maxOf(bins);    for (var i = 0; i < n; i++) {      var bx = left + (i * (barW + gap));      var bh = (bins[i] / maxBin) * (height - 2);      var dim = (!bandActive || (i >= bLo && i <= bHi)) ? 1 : 0.24;      add("rect", {        x: bx,        y: bottom - bh,        width: barW,        height: bh,        rx: 1.5,        fill: "rgba(226,179,86," + (0.90 * dim).toFixed(3) + ")",        stroke: "rgba(255,218,143," + (0.78 * dim).toFixed(3) + ")",        "stroke-width": 0.6      });    }    if (rankPoints.length) {      var markTopBase = bottom - Math.round(height * 0.5);      var overlapLo = null;      var overlapHi = null;      if (bandActive) {        var rrBandMarks = ratingRangeForBins(bLo, bHi, dist);        overlapLo = rrBandMarks.lo;        overlapHi = rrBandMarks.hi;      }      for (var ni = 0; ni < rankPoints.length; ni++) {        var nrp = rankPoints[ni];        if (!Number.isFinite(nrp.rating)) continue;        var npx = xForRating(nrp.rating, left, width, dist.min, dist.max);        var isFocusNeighbor = !!nrp.isFocus || (state.ui.focusMovieId && nrp.movie_id === state.ui.focusMovieId);        var markTop = isFocusNeighbor ? (markTopBase - 8) : markTopBase;        var overlapPoint = bandActive && nrp.rating >= overlapLo && nrp.rating <= overlapHi;        add("line", {          x1: npx,          y1: markTop,          x2: npx,          y2: bottom,          stroke: overlapPoint ? "rgba(244,214,115,0.92)" : (isFocusNeighbor ? "rgba(243,155,143,0.96)" : "rgba(227,140,109,0.72)"),          "stroke-width": isFocusNeighbor ? 2.4 : (overlapPoint ? 2.0 : 1.5),          "stroke-linecap": "round"        });        add("circle", {          cx: npx,          cy: markTop,          r: isFocusNeighbor ? 4.4 : (overlapPoint ? 3.6 : 3.0),          fill: overlapPoint ? "rgba(244,214,115,0.98)" : (isFocusNeighbor ? "rgba(243,155,143,0.98)" : "rgba(227,140,109,0.90)"),          stroke: "rgba(12,12,12,0.78)",          "stroke-width": 0.8        });        neighborHoverTargets.push({ point: nrp, x: npx, y: markTop });      }    }    function refLine(rating, label) {      var x = xForRating(rating, left, width, dist.min, dist.max);      add("line", { x1: x, y1: top, x2: x, y2: bottom, stroke: "rgba(255,255,255,0.54)", "stroke-width": 1.8, "stroke-dasharray": "6 2" });      var tx = add("text", { x: x + 3, y: bottom + 13, fill: "rgba(255,255,255,0.92)", "font-size": 9, "font-family": "system-ui, sans-serif" });      tx.textContent = label;    }    refLine(dist.p25, "p25");    refLine(dist.p50, "p50");    refLine(dist.p75, "p75");    if (hasFocus) {      var focusStroke = "#E38C6D";      var focusGlow = "#F39B8F";      var fx = xForRating(state.ui.focusRating, left, width, dist.min, dist.max);      add("line", { x1: fx, y1: top, x2: fx, y2: bottom, stroke: "rgba(0,0,0,0.58)", "stroke-width": 3.8 });      add("line", { x1: fx, y1: top, x2: fx, y2: bottom, stroke: focusStroke, "stroke-width": 2.4 });      add("circle", { cx: fx, cy: top + 7, r: 3.8, fill: focusStroke, stroke: focusGlow, "stroke-width": 2 });      var t = add("text", { x: fx + 5, y: top + 9, fill: focusStroke, "font-size": 12, "font-weight": 700, "font-family": "system-ui, sans-serif", stroke: "rgba(0,0,0,0.7)", "stroke-width": "1.4", "paint-order": "stroke fill", "stroke-linejoin": "round" });      t.textContent = "F";    }    var hoverRating = Number.isFinite(state.ui.hoverRating) ? state.ui.hoverRating : state.ui.extHoverRating;    var hoverTitle = state.ui.hoverTitle || state.ui.extHoverTitle || "";    var hoverMovieId = state.ui.hoverMovieId || "";    var hasHover = !!hoverTitle && Number.isFinite(hoverRating);    var hoverIsFocus = hasHover && hasFocus && (      (!!hoverMovieId && !!state.ui.focusMovieId && hoverMovieId === state.ui.focusMovieId) ||      (!hoverMovieId && hoverTitle === state.ui.focusTitle && Math.abs(hoverRating - state.ui.focusRating) < 0.0001)    );    if (hasHover && !hoverIsFocus) {      var hx = xForRating(hoverRating, left, width, dist.min, dist.max);      var hStroke = "rgba(111,226,214,0.96)";      add("line", { x1: hx, y1: top, x2: hx, y2: bottom, stroke: "rgba(0,0,0,0.52)", "stroke-width": 2.8 });      add("line", { x1: hx, y1: top, x2: hx, y2: bottom, stroke: hStroke, "stroke-width": 1.6 });      add("circle", { cx: hx, cy: top + 7, r: 3.2, fill: hStroke, stroke: "rgba(20,40,40,0.95)", "stroke-width": 1.2 });      var ht = add("text", {        x: hx + 5,        y: top + 9,        fill: hStroke,        "font-size": 10,        "font-weight": 700,        "font-family": "system-ui, sans-serif",        stroke: "rgba(0,0,0,0.64)",        "stroke-width": "1.2",        "paint-order": "stroke fill",        "stroke-linejoin": "round"      });      ht.textContent = "H";    }    for (var nhi = 0; nhi < neighborHoverTargets.length; nhi++) {      (function (meta) {        var hit = add("rect", {          x: meta.x - 9,          y: meta.y - 10,          width: 18,          height: Math.max(20, bottom - meta.y + 14),          fill: "rgba(0,0,0,0)"        });         hit.setAttribute("data-neighbor-hit", "1");         hit.setAttribute("pointer-events", "all");         hit.style.cursor = "pointer";         hit.style.pointerEvents = "all";          function focusPoint(evt) {            if (evt) {              evt.preventDefault();              evt.stopPropagation();            }            if (!meta.point || !meta.point.movie_id || !Number.isFinite(meta.point.rating)) return;            state.ui.focusMovieId = meta.point.movie_id;            state.ui.focusTitle = meta.point.title || meta.point.movie_id || "Selected";            state.ui.focusRating = meta.point.rating;            emitAction("set_focus", {              movie_id: meta.point.movie_id,              title: state.ui.focusTitle,              rating: meta.point.rating,              rank: Number.isFinite(meta.point.rank) ? meta.point.rank : null            }, {              source: "p1_neighbor"            });            draw();          }         function setPointHover() {           state.hoverPoint = {             movie_id: meta.point.movie_id,             title: meta.point.title || meta.point.movie_id || "Neighbor",            rating: meta.point.rating,            sigma: Number.isFinite(meta.point.sigma) ? meta.point.sigma : null,            x: meta.x,            y: meta.y          };          state.hoverBin = -1;           state.ui.hoverMovieId = meta.point.movie_id || "";           state.ui.hoverTitle = state.hoverPoint.title;           state.ui.hoverRating = meta.point.rating;           state.ui.hoverSigma = Number.isFinite(meta.point.sigma) ? meta.point.sigma : null;            emitHoverAction(              meta.point.movie_id || "",              state.hoverPoint.title,              meta.point.rating,              Number.isFinite(meta.point.sigma) ? meta.point.sigma : null,              "p1_neighbor_hover"            );           draw({ hoverOnly: true });         }          hit.addEventListener("pointerdown", focusPoint);          hit.addEventListener("click", function (evt) {            if (evt && evt.detail === 0) focusPoint(evt);          });         hit.addEventListener("pointerenter", setPointHover);         hit.addEventListener("pointermove", setPointHover);         hit.addEventListener("mouseenter", setPointHover);         hit.addEventListener("mousemove", setPointHover);       })(neighborHoverTargets[nhi]);    }    if (state.hoverPoint && Number.isFinite(state.hoverPoint.rating)) {      var pointPct = Math.round(percentileFromRating(state.hoverPoint.rating, dist));      var sigmaText = Number.isFinite(state.hoverPoint.sigma) ? (Math.round(clamp(state.hoverPoint.sigma, 0, 1) * 100) + "%") : "--";      var histRect = d.hist.getBoundingClientRect();      var rootRect = d.root.getBoundingClientRect();      var rootW = d.root.clientWidth || w;      var rootH = d.root.clientHeight || h;      var histOffsetX = histRect.left - rootRect.left;      var histOffsetY = histRect.top - rootRect.top;      var controlBottom = 8;      if (controlWrap) controlBottom = controlWrap.offsetTop + controlWrap.offsetHeight + 6;      d.tooltip.style.display = "block";      d.tooltip.classList.add("is-point");      d.tooltip.innerHTML =        '<div class="rd-tooltip-title">' + esc(state.hoverPoint.title || "Neighbor") + '</div>' +        '<div class="rd-tooltip-meta">' +          '<span class="rd-hm-k-p">P</span><span class="rd-hm-v">' + pointPct + '</span>' +          ' • ' +          '<span class="rd-hm-k-r">r</span><span class="rd-hm-v">' + Math.round(state.hoverPoint.rating) + '</span>' +      