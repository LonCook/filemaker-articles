<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text> Purpose:	Acknowledge the current native MOVIE row as FileMaker-owned hybrid selection and refresh both surfaces.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> In:			Get ( ScriptParameter ) as stable MOVIE::ID; falls back to the current MOVIE record.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Out:		JSON status object.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Anchor:		MOVIE on WV Framework - Hybrid.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Calls:		WV__Demo_Apply_Hybrid_Context, WV__Demo_Push_Context.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified:	16 Aug 2026, 18hr12PT — Lon Cook — lon@portagebay.com : patch selection context without rebuilding SQL or changing the native found set.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified:	15 Aug 2026, 23hr32PT — Lon Cook — lon@portagebay.com : push fresh acknowledgement context into the loaded Web Viewer without reloading it.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified:	15 Aug 2026, 21hr40PT — Lon Cook — lon@portagebay.com : accept the clicked native row ID instead of relying on the previously active record.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified:	15 Aug 2026, 19hr31PT — Lon Cook — lon@portagebay.com : created</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True" />
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation>Let ( [
  p = GetAsText ( Get ( ScriptParameter ) )
] ;
  Case (
    not IsEmpty ( p ) ; p ;
    GetAsText ( MOVIE::ID )
  )
)</Calculation>
    </Value>
    <Repetition>
      <Calculation>1</Calculation>
    </Repetition>
    <Name>$_movie_id</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False" />
    <Calculation>Get ( FoundCount ) = 0 or IsEmpty ( $_movie_id )</Calculation>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation>JSONSetElement ( "{}"
  ; [ "ok" ; 0 ; JSONBoolean ]
  ; [ "error" ; "no_native_movie" ; JSONString ]
)</Calculation>
  </Step>
  <Step enable="True" id="70" name="End If" />
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation>GetAsNumber ( GetField ( "FOCUS::g_wv_action_count" ) ) + 1</Calculation>
    </Value>
    <Repetition>
      <Calculation>1</Calculation>
    </Repetition>
    <Name>$_count</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation>"Selected native movie " &amp; $_movie_id &amp; " from native list"</Calculation>
    </Value>
    <Repetition>
      <Calculation>1</Calculation>
    </Repetition>
    <Name>$_status</Name>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation>$_movie_id</Calculation>
    </Result>
    <TargetName>
      <Calculation>"FOCUS::g_wv_demo_movie_id"</Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation>JSONFormatElements ( JSONSetElement ( "{}"
  ; [ "__wv_action.version" ; 1 ; JSONNumber ]
  ; [ "__wv_action.source" ; "filemaker.native.hybrid_list" ; JSONString ]
  ; [ "__wv_action.page" ; 43 ; JSONNumber ]
  ; [ "type" ; "hybrid.select_movie" ; JSONString ]
  ; [ "payload.movie_id" ; $_movie_id ; JSONString ]
) )</Calculation>
    </Result>
    <TargetName>
      <Calculation>"FOCUS::g_wv_action_json"</Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation>"hybrid.select_movie"</Calculation>
    </Result>
    <TargetName>
      <Calculation>"FOCUS::g_wv_action_type"</Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation>$_count</Calculation>
    </Result>
    <TargetName>
      <Calculation>"FOCUS::g_wv_action_count"</Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation>$_status</Calculation>
    </Result>
    <TargetName>
      <Calculation>"FOCUS::g_wv_action_status"</Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation>""</Calculation>
    <Script id="502" name="WV__Demo_Apply_Hybrid_Context" />
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation>""</Calculation>
    <Script id="482" name="WV__Demo_Push_Context" />
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation>GetAsText ( Get ( ScriptResult ) )</Calculation>
    </Value>
    <Repetition>
      <Calculation>1</Calculation>
    </Repetition>
    <Name>$_push_result</Name>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation>JSONSetElement ( "{}"
  ; [ "ok" ; 1 ; JSONBoolean ]
  ; [ "type" ; "hybrid.select_movie" ; JSONString ]
  ; [ "selected_movie_id" ; $_movie_id ; JSONString ]
  ; [ "push_result" ; $_push_result ; JSONString ]
)</Calculation>
  </Step>
</fmxmlsnippet>
