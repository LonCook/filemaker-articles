<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text> WV__Demo_Load_Viewer</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Purpose: Load the selected framework module into the demo Web Viewer object.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> In: FOCUS::g_wv_module_index; defaults to module 62 when empty.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Out: FOCUS::g_wv_status; exits with the framework load script result.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Anchor: FOCUS. Web Viewer object name is wv_main.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Calls: . webviewer . load ( index ; -object_name )</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified: 06 Jul 2026, Codex - created Article 1 demo teaching wrapper.</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let (
  [
    raw = GetField ( "FOCUS::g_wv_module_index" )
  ] ;
  Case (
    IsEmpty ( raw ) ; 62 ;
    GetAsNumber ( raw )
  )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_index</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["wv_main"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_object_name</Name>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[List (
  # ( "index" ; $_index ) ;
  # ( "object_name" ; $_object_name )
)]]></Calculation>
    <Script id="448" name=". webviewer . load ( index ; -object_name )"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( Get ( ScriptResult ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_load_result</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List (
  GetField ( "FOCUS::g_wv_status" ) ;
  "Viewer loaded: module " & $_index & " -> " & $_object_name &
    If ( not IsEmpty ( $_load_result ) ; " | result: " & $_load_result ; "" )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_status</Name>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation><![CDATA[$_status]]></Calculation>
    </Result>
    <TargetName>
      <Calculation><![CDATA["FOCUS::g_wv_status"]]></Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$_load_result]]></Calculation>
  </Step>
</fmxmlsnippet>
