<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text> WV__Demo_Push_Context</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Purpose: Push the visible context JSON field into the loaded Web Viewer.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> In: FOCUS::g_wv_context_json; builds context first if the field is empty.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Out: FOCUS::g_wv_status; exits with the framework push result.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Anchor: FOCUS. Web Viewer object name is wv_main.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Calls: WV__Demo_Build_Context, . webviewer . push context ( -object_name ; -context_json )</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Modified: 06 Jul 2026, Codex - created Article 1 demo teaching wrapper.</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["wv_main"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_object_name</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( GetField ( "FOCUS::g_wv_context_json" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_context_json</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[IsEmpty ( $_context_json )]]></Calculation>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[""]]></Calculation>
    <Script id="0" name="WV__Demo_Build_Context"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( Get ( ScriptResult ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_context_json</Name>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[JSONFormatElements ( $_context_json ) = "?"]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List (
  GetField ( "FOCUS::g_wv_status" ) ;
  "Push skipped: context JSON is not valid."
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_status</Name>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation><![CDATA[$_status]]></Calculation>
    </Result>
    <TargetName>
      <Calculation><![CDATA["FOCUS::g_wv_status"]]></Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA["?"]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="1" name="Perform Script">
    <Calculation><![CDATA[List (
  # ( "object_name" ; $_object_name ) ;
  # ( "context_json" ; $_context_json )
)]]></Calculation>
    <Script id="451" name=". webviewer . push context ( -object_name ; -context_json )"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( Get ( ScriptResult ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_push_result</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[List (
  GetField ( "FOCUS::g_wv_status" ) ;
  "Context pushed to " & $_object_name &
    If ( not IsEmpty ( $_push_result ) ; " | result: " & $_push_result ; "" )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_status</Name>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <Result>
      <Calculation><![CDATA[$_status]]></Calculation>
    </Result>
    <TargetName>
      <Calculation><![CDATA["FOCUS::g_wv_status"]]></Calculation>
    </TargetName>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$_push_result]]></Calculation>
  </Step>
</fmxmlsnippet>
