<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>FULL REPLACEMENT for script: . webviewer . context . build ( -index ; -movie_id ; -genre_id ) : json</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Purpose: Build the Article 1 demo context JSON without custom functions, SQL helpers, or ranked-list dependencies.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>In: JSON script parameter with optional index, movie_id, genre_id, context_override_json.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>Out: JSON context object for WV.setContext( ).</Text>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>D E C L A R E   A N D   V A L I D A T E   P A R A M E T E R S</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
    ~p = Get ( ScriptParameter )
  ; $_index = GetAsNumber ( JSONGetElement ( ~p ; "index" ) )
  ; $_movie_id = GetAsText ( JSONGetElement ( ~p ; "movie_id" ) )
  ; $_genre_id = GetAsText ( JSONGetElement ( ~p ; "genre_id" ) )
  ; $_context_override_json = JSONGetElement ( ~p ; "context_override_json" )
  ; $_invalid_params = ""
  ; $_error_message = ""
] ;
  0
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_error</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$_error]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>R E S O L V E   D E M O   I N P U T S</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Case (
  not IsEmpty ( $_movie_id ) ; $_movie_id ;
  GetAsText ( GetField ( "FOCUS::g_wv_demo_movie_id" ) )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_movie_id</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Case (
  not IsEmpty ( $_genre_id ) ; $_genre_id ;
  GetAsText ( GetField ( "FOCUS::g_wv_demo_genre_id" ) )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_genre_id</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetAsText ( GetField ( "FOCUS::g_wv_demo_title" ) )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_title</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>B U I L D   B A S E   C O N T E X T</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONSetElement ( "{}"
  ; [ "__wv.ts" ; GetAsText ( Get ( CurrentTimestamp ) ) ; JSONString ]
  ; [ "__wv.page" ; Case ( $_index > 0 ; $_index ; "" ) ; Case ( $_index > 0 ; JSONNumber ; JSONNull ) ]
  ; [ "__wv.source" ; "article_01_demo" ; JSONString ]
  ; [ "defaults.movie_id" ; $_movie_id ; Case ( IsEmpty ( $_movie_id ) ; JSONNull ; JSONString ) ]
  ; [ "defaults.genre_id" ; $_genre_id ; Case ( IsEmpty ( $_genre_id ) ; JSONNull ; JSONString ) ]
  ; [ "defaults.title" ; $_title ; Case ( IsEmpty ( $_title ) ; JSONNull ; JSONString ) ]
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_result</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>M E R G E   O V E R R I D E   J S O N</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not IsEmpty ( $_context_override_json )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Let ( [
  ~fmt = JSONFormatElements ( $_context_override_json )
] ;
  not IsEmpty ( ~fmt ) and not ( ~fmt = "?" )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_override_valid</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Restore state="False"/>
    <Calculation><![CDATA[not $_override_valid]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_error</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA["Invalid context_override_json (not valid JSON)"]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_error_message</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONListKeys ( $_context_override_json ; "" )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_override_keys</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_i</Name>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[$_i > ValueCount ( $_override_keys )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[GetValue ( $_override_keys ; $_i )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_k</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElementType ( $_context_override_json ; $_k )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_t</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[JSONGetElement ( $_context_override_json ; $_k )]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_v</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[Case (
    $_t = JSONString ; JSONSetElement ( $_result ; $_k ; GetAsText ( $_v ) ; JSONString )
  ; $_t = JSONNumber ; JSONSetElement ( $_result ; $_k ; GetAsNumber ( $_v ) ; JSONNumber )
  ; $_t = JSONBoolean ; JSONSetElement ( $_result ; $_k ; GetAsBoolean ( $_v ) ; JSONBoolean )
  ; $_t = JSONNull ; JSONSetElement ( $_result ; $_k ; "" ; JSONNull )
  ; $_t = JSONObject ; JSONSetElement ( $_result ; $_k ; $_v ; JSONObject )
  ; $_t = JSONArray ; JSONSetElement ( $_result ; $_k ; $_v ; JSONArray )
  ; JSONSetElement ( $_result ; $_k ; $_v ; JSONRaw )
)]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_result</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value>
      <Calculation><![CDATA[$_i + 1]]></Calculation>
    </Value>
    <Repetition>
      <Calculation><![CDATA[1]]></Calculation>
    </Repetition>
    <Name>$_i</Name>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$_result]]></Calculation>
  </Step>
</fmxmlsnippet>
